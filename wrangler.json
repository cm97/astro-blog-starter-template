{
	"name": "astro-blog-starter-template",
	"main": "./dist/_worker.js/index.js",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat",
		"disable_nodejs_process_v2"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{
			"binding": "MY_PRODUCTS",
			"bucket_name": "buzzyfly-products"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "buzzy-fly_db",
			"database_id": "c4ff4255-c51b-45a7-85a5-4583328b26c4"
		}
	],
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["orders@buzzyfly.com"]
		}
	],
	"vars": {
		"EMAIL_FROM": "Buzzyfly <orders@buzzyfly.com>",
		"STRIPE_WEBHOOK_SECRET": "whsec_6ZYY7nDSwdVQbv86ssDJZhERobXsOhtZ",
		"DOWNLOAD_TOKEN_SECRET": "58bae999b1027b629f75a5037a1e8c6049c5ce39d151b0cf0b7749509273564e"
	}
}
