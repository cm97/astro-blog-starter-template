{
	"name": "astro-blog-starter-template",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-02-19",
	"compatibility_flags": ["nodejs_compat", "fetch_iterable_type_support"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{
			"binding": "MY_PRODUCTS",
			"bucket_name": "buzzyfly-products"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "buzzy-fly_db",
			"database_id": "c4ff4255-c51b-45a7-85a5-4583328b26c4"
		}
	]
}
