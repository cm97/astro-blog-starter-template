{
	"name": "buzzyfly",
	"main": "./dist/_worker.js/index.js",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat",
		"disable_nodejs_process_v2"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"]
	},
	"r2_buckets": [
		{
			"binding": "MY_PRODUCTS",
			"bucket_name": "buzzyfly-products"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "buzzy-fly_db",
			"database_id": "c4ff4255-c51b-45a7-85a5-4583328b26c4"
		}
	],
	"services": [
		{
			"binding": "KIDS",
			"service": "react-router-starter-template"
		}
	],
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["orders@buzzyfly.com", "hello@buzzyfly.com", "support@buzzyfly.com"]
		}
	],
	"vars": {
		"EMAIL_FROM": "Buzzyfly <orders@buzzyfly.com>",
		"JOBS_MEMBERSHIP_PRICE": "$5/month",
		"JOBS_MEMBERSHIP_URL": ""
	}
}
