---
import { BUZZYFLY_CONFIG, bundleSeparatePrice, getOrderAction, getProduct } from "../data/monetization";

interface Props {
	/** Defaults to the Complete Bundle's checkout route. */
	bundleUrl?: string;
	bundlePrice?: string;
	/** "strip" is the slim top banner. "section" is the full store banner. */
	variant?: "strip" | "section";
}

const bundle = getProduct("complete-business-bundle")!;
const {
	bundleUrl = getOrderAction(bundle.id).href,
	bundlePrice = bundle.price,
	variant = "strip",
} = Astro.props;
const separate = bundleSeparatePrice();
---

{
	variant === "section" ? (
		<section class="printer-section" aria-labelledby="bundle-heading">
			<p class="printer-banner__kicker">Best value · One-time · Instant download</p>
			<h2 id="bundle-heading">Want every file? Get the Complete Bundle.</h2>
			<p class="printer-section__lede">{bundle.description}</p>
			<ul class="printer-section__list">
				{bundle.features.map((f) => <li>{f}</li>)}
			</ul>
			<p class="printer-section__price">
				<s><span class="sr-only">Bought separately: </span>{separate}</s>{" "}
				<span class="sr-only">Bundle price: </span>
				<strong>{bundlePrice}</strong>
			</p>
			<a class="btn-primary printer-section__cta" href={bundleUrl}>Buy the Complete Bundle — {bundlePrice}</a>
			<p class="printer-section__fine">{BUZZYFLY_CONFIG.guarantee}</p>
		</section>
	) : (
		<div class="printer-banner">
			<p class="printer-banner__kicker">One-time. Instant download. No subscription.</p>
			<p class="printer-banner__line">
				Every checklist, template and script in one zip. <s>{separate}</s> {bundlePrice} Complete Bundle.
			</p>
			<a class="btn-secondary" href={bundleUrl}>Buy the bundle →</a>
		</div>
	)
}

<style>
	.printer-banner {
		background: var(--surface);
		border-bottom: 1px solid var(--line);
		color: var(--ink);
		text-align: center;
		padding: var(--space-1) var(--gutter);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: var(--space-1) var(--space-2);
	}
	.printer-banner__kicker {
		margin: 0;
		font-size: 0.72em;
		font-weight: 600;
		color: var(--muted);
	}
	.printer-banner__line {
		margin: 0;
		font-size: 0.9em;
		font-weight: 600;
	}
	.printer-banner__line s {
		color: var(--muted);
		font-weight: 400;
	}
	.printer-section {
		margin: var(--space-8) 0;
		padding: var(--space-6) var(--space-3);
		border-radius: var(--radius-card);
		border: 1px solid var(--line);
		background: var(--surface);
		text-align: center;
	}
	.printer-banner__kicker + h2,
	.printer-section h2 {
		font-size: clamp(1.4em, 5vw, 1.9em);
		font-weight: 800;
		margin: var(--space-2) 0;
	}
	.printer-section__lede { color: rgb(var(--gray-dark)); margin: 0 auto var(--space-3); max-width: 30em; }
	.printer-section__list {
		list-style: none;
		padding: 0;
		margin: 0 auto var(--space-3);
		max-width: 22em;
		text-align: left;
		font-size: 0.9em;
	}
	.printer-section__list li { padding: 4px 0 4px 1.5em; position: relative; color: rgb(var(--gray-dark)); }
	.printer-section__list li::before { content: "✓"; position: absolute; left: 0; color: var(--muted); font-weight: 600; }
	.printer-section__price { margin: 0 0 var(--space-2); font-family: var(--font-display); font-weight: 800; font-size: 1.5em; letter-spacing: -0.02em; color: var(--ink); }
	.printer-section__price s { font-family: var(--font-body); font-weight: 400; color: var(--muted); font-size: 0.6em; margin-right: 0.3em; }
	.printer-section__cta { padding: 0 var(--space-4); }
	.printer-section__fine { margin: var(--space-2) 0 0; font-size: 0.78em; color: var(--muted); }
</style>
