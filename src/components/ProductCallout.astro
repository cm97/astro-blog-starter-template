---
import { BUZZYFLY_CONFIG, bundleSeparatePrice, getOrderAction, getProduct } from "../data/monetization";

interface Props {
	/** Product id from ALL_PRODUCTS. Fills in any field not passed explicitly. */
	productId?: string;
	title?: string;
	price?: string;
	/** Only used when no product in ALL_PRODUCTS matches. */
	url?: string;
	description?: string;
	features?: string[];
	badge?: string | null;
	/** Larger card with a glow, for the recommended product. */
	featured?: boolean;
	headingLevel?: "h2" | "h3";
}

const props = Astro.props;
const product = getProduct(props.productId ?? props.title ?? BUZZYFLY_CONFIG.defaultProductTitle);

const title = props.title ?? product?.title ?? BUZZYFLY_CONFIG.defaultProductTitle;
const price = props.price ?? product?.price ?? BUZZYFLY_CONFIG.defaultProductPrice;
const description = props.description ?? product?.description ?? BUZZYFLY_CONFIG.defaultProductDescription;
const features = props.features ?? product?.features ?? [];
const badge = props.badge !== undefined ? props.badge : product?.badge ?? null;
const featured = props.featured ?? badge === "Most popular";
const Heading = props.headingLevel ?? "h3";
// Crossed-out price only where it is true: the bundle vs buying each piece.
const compareAt = product?.id === "complete-business-bundle" ? bundleSeparatePrice() : null;

// Buy buttons always go to a real checkout route for a known product.
const order = product
	? getOrderAction(product.id)
	: props.url
		? { live: true, href: props.url, label: "Buy now", external: /^https?:/.test(props.url) }
		: getOrderAction();
---

<aside
	class:list={["product-callout", { "product-callout--featured": featured }]}
	aria-label={`${title}, ${price}`}
>
	{badge && <div class="product-callout__badge">{badge}</div>}
	<Heading class="product-callout__title">{title}</Heading>
	<p class="product-callout__description">{description}</p>
	{
		features.length > 0 && (
			<ul class="product-callout__features">
				{features.map((feature) => (
					<li>{feature}</li>
				))}
			</ul>
		)
	}
	<div class="product-callout__footer">
		<span class="product-callout__price">
			{compareAt && (
				<s class="product-callout__compare">
					<span class="sr-only">Bought separately: </span>{compareAt}
				</s>
			)}
			{compareAt && <span class="sr-only">Bundle price: </span>}
			{price}
		</span>
		<a
			class:list={["product-callout__cta", featured ? "btn-primary" : "btn-secondary"]}
			href={order.href}
			{...(order.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
		>
			{order.label}
			<span class="sr-only"> {title}</span>
		</a>
	</div>
	{compareAt && <p class="product-callout__note">{compareAt} if you buy each piece separately.</p>}
	<p class="product-callout__guarantee">One-time payment. Instant download. {BUZZYFLY_CONFIG.guarantee}</p>
</aside>

<style>
	.product-callout {
		margin: var(--space-6) 0;
		padding: var(--space-4) var(--space-3);
		border-radius: var(--radius-card);
		border: 1px solid var(--line);
		background: var(--surface);
		display: flex;
		flex-direction: column;
	}
	/* The recommended product: stronger edge, more room. No glow, no shadow. */
	.product-callout--featured {
		padding: var(--space-6) var(--space-4);
		border-color: var(--line-strong);
		background: var(--surface-raised);
	}
	.product-callout__badge {
		align-self: flex-start;
		padding: 2px var(--space-2);
		margin-bottom: var(--space-2);
		border-radius: 999px;
		border: 1px solid var(--line-strong);
		color: var(--ink);
		font-size: 0.72em;
		font-weight: 600;
	}
	.product-callout__title {
		margin: 0 0 var(--space-1) 0;
		font-size: 1.5em;
	}
	.product-callout--featured .product-callout__title {
		font-size: clamp(1.6em, 5vw, 2em);
		font-weight: 800;
	}
	.product-callout__description {
		margin: 0 0 var(--space-2) 0;
		color: rgb(var(--gray-dark));
	}
	.product-callout__features {
		list-style: none;
		margin: 0 0 var(--space-3) 0;
		padding: 0;
		color: rgb(var(--gray-dark));
		flex: 1;
	}
	.product-callout__features li {
		position: relative;
		margin-bottom: 6px;
		padding-left: 1.4em;
		font-size: 0.9em;
	}
	.product-callout__features li::before {
		content: "✓";
		position: absolute;
		left: 0;
		color: var(--muted);
		font-weight: 600;
	}
	.product-callout__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		flex-wrap: wrap;
		padding-top: var(--space-3);
		border-top: 1px solid var(--line);
	}
	.product-callout__price {
		font-family: var(--font-display);
		font-size: 1.6em;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--ink);
	}
	.product-callout__compare {
		margin-right: 0.35em;
		font-family: var(--font-body);
		font-size: 0.6em;
		font-weight: 400;
		color: var(--muted);
	}
	.product-callout__cta {
		padding: 0 var(--space-4);
	}
	.product-callout__note,
	.product-callout__guarantee {
		margin: var(--space-2) 0 0;
		font-size: 0.78em;
		color: var(--muted);
	}
</style>
