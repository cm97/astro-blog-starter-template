---
import { BUZZYFLY_CONFIG, getOrderAction, getProduct } from "../data/monetization";

interface Props {
	/** Product id from ALL_PRODUCTS. Fills in any field not passed explicitly. */
	productId?: string;
	title?: string;
	price?: string;
	/** Only used when no product in ALL_PRODUCTS matches. */
	url?: string;
	description?: string;
	features?: string[];
	badge?: string | null;
	/** Larger card with a glow, for the recommended product. */
	featured?: boolean;
	headingLevel?: "h2" | "h3";
}

const props = Astro.props;
const product = getProduct(props.productId ?? props.title ?? BUZZYFLY_CONFIG.defaultProductTitle);

const title = props.title ?? product?.title ?? BUZZYFLY_CONFIG.defaultProductTitle;
const price = props.price ?? product?.price ?? BUZZYFLY_CONFIG.defaultProductPrice;
const description = props.description ?? product?.description ?? BUZZYFLY_CONFIG.defaultProductDescription;
const features = props.features ?? product?.features ?? [];
const badge = props.badge !== undefined ? props.badge : product?.badge ?? null;
const featured = props.featured ?? badge === "Most popular";
const Heading = props.headingLevel ?? "h3";

// Buy buttons always go to a real checkout route for a known product.
const order = product
	? getOrderAction(product.id)
	: props.url
		? { live: true, href: props.url, label: "Buy now", external: /^https?:/.test(props.url) }
		: getOrderAction();
---

<aside
	class:list={["product-callout", { "product-callout--featured": featured }]}
	aria-label={`${title}, ${price}`}
>
	{badge && <div class="product-callout__badge">{badge}</div>}
	<Heading class="product-callout__title">{title}</Heading>
	<p class="product-callout__description">{description}</p>
	{
		features.length > 0 && (
			<ul class="product-callout__features">
				{features.map((feature) => (
					<li>{feature}</li>
				))}
			</ul>
		)
	}
	<div class="product-callout__footer">
		<span class="product-callout__price">
			{price}
		</span>
		<a
			class="product-callout__cta"
			href={order.href}
			{...(order.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
		>
			{order.label}
			<span class="sr-only"> {title}</span>
		</a>
	</div>
	<p class="product-callout__guarantee">One-time payment. Instant download. {BUZZYFLY_CONFIG.guarantee}</p>
</aside>

<style>
	.product-callout {
		margin: 2.5em 0;
		padding: 1.75em;
		border-radius: 16px;
		border: 1px solid rgb(var(--gray-light));
		background: #fff;
		box-shadow: var(--box-shadow);
		display: flex;
		flex-direction: column;
	}
	.product-callout--featured {
		border: 2px solid var(--accent);
		box-shadow: 0 0 0 4px rgba(35, 55, 255, 0.12), 0 12px 40px rgba(35, 55, 255, 0.22);
	}
	.product-callout__badge {
		align-self: flex-start;
		padding: 0.25em 0.75em;
		margin-bottom: 0.75em;
		border-radius: 999px;
		background: var(--accent);
		color: #fff;
		font-size: 0.75em;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
	.product-callout__title {
		margin: 0 0 0.4em 0;
		font-size: 1.5em;
		color: rgb(var(--black));
	}
	.product-callout__description {
		margin: 0 0 1em 0;
		color: rgb(var(--gray-dark));
	}
	.product-callout__features {
		list-style: none;
		margin: 0 0 1.25em 0;
		padding: 0;
		color: rgb(var(--gray-dark));
		flex: 1;
	}
	.product-callout__features li {
		position: relative;
		margin-bottom: 0.35em;
		padding-left: 1.4em;
		font-size: 0.92em;
	}
	.product-callout__features li::before {
		content: "✓";
		position: absolute;
		left: 0;
		color: #1a7a3c;
		font-weight: 700;
	}
	.product-callout__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		flex-wrap: wrap;
	}
	.product-callout__price {
		font-size: 1.6em;
		font-weight: 700;
		color: rgb(var(--black));
	}
	.product-callout__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 0.6em 1.6em;
		border-radius: 999px;
		background: var(--accent);
		color: #fff;
		font-weight: 700;
		text-decoration: none;
		transition: background-color 0.15s ease-in-out;
	}
	.product-callout__cta:hover {
		background: var(--accent-dark);
		color: #fff;
	}
	.product-callout__cta:focus-visible {
		outline: 3px solid rgb(var(--black));
		outline-offset: 3px;
	}
	.product-callout__guarantee {
		margin: 0.75em 0 0;
		font-size: 0.8em;
		color: rgb(var(--gray));
	}
	@media (prefers-reduced-motion: reduce) {
		.product-callout__cta {
			transition: none;
		}
	}
</style>
