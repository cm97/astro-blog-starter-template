---
---

<button id="feedback-button" type="button" aria-haspopup="dialog" aria-controls="feedback-dialog">
	Feedback
</button>

<dialog id="feedback-dialog" aria-labelledby="feedback-dialog-title">
	<form id="feedback-form">
		<h2 id="feedback-dialog-title">Send feedback</h2>
		<p id="feedback-error" role="alert" hidden></p>
		<label for="feedback-message">What's on your mind?</label>
		<textarea id="feedback-message" name="message" rows="5" required></textarea>
		<label for="feedback-email">Your email (optional)</label>
		<input id="feedback-email" name="email" type="email" placeholder="you@example.com" />
		<div class="feedback-actions">
			<button type="button" id="feedback-cancel">Cancel</button>
			<button type="submit" id="feedback-submit">Send</button>
		</div>
	</form>
</dialog>

<style>
	#feedback-button {
		position: fixed;
		right: 1.5em;
		bottom: 1.5em;
		z-index: 20;
		padding: 0.75em 1.25em;
		border: none;
		border-radius: 999px;
		background: var(--accent);
		color: white;
		font-size: 0.95rem;
		font-weight: 600;
		box-shadow: var(--box-shadow);
		cursor: pointer;
	}
	#feedback-button:hover {
		filter: brightness(1.1);
	}
	#feedback-dialog {
		width: min(420px, calc(100% - 2em));
		border: none;
		border-radius: 12px;
		padding: 1.5em;
		box-shadow: var(--box-shadow);
	}
	#feedback-dialog::backdrop {
		background: rgba(var(--black), 40%);
	}
	#feedback-form {
		display: flex;
		flex-direction: column;
		gap: 0.5em;
	}
	#feedback-form h2 {
		margin: 0 0 0.25em 0;
	}
	#feedback-error {
		margin: 0;
		padding: 0.5em 0.75em;
		border-radius: 6px;
		background: rgba(220, 38, 38, 0.1);
		color: #b91c1c;
		font-size: 0.9rem;
	}
	#feedback-form textarea,
	#feedback-form input {
		font: inherit;
		padding: 0.5em;
		border: 1px solid rgb(var(--gray));
		border-radius: 6px;
	}
	.feedback-actions {
		display: flex;
		justify-content: flex-end;
		gap: 0.5em;
		margin-top: 0.5em;
	}
	.feedback-actions button {
		padding: 0.5em 1em;
		border-radius: 6px;
		border: 1px solid rgb(var(--gray));
		background: white;
		cursor: pointer;
	}
	#feedback-submit {
		border-color: var(--accent);
		background: var(--accent);
		color: white;
	}
</style>

<script>
	import { buildFeedbackMailtoUrl, validateFeedback } from "../utils/feedback";

	const button = document.getElementById("feedback-button") as HTMLButtonElement | null;
	const dialog = document.getElementById("feedback-dialog") as HTMLDialogElement | null;
	const form = document.getElementById("feedback-form") as HTMLFormElement | null;
	const cancelButton = document.getElementById("feedback-cancel") as HTMLButtonElement | null;
	const errorEl = document.getElementById("feedback-error") as HTMLParagraphElement | null;
	const messageInput = document.getElementById("feedback-message") as HTMLTextAreaElement | null;
	const emailInput = document.getElementById("feedback-email") as HTMLInputElement | null;

	button?.addEventListener("click", () => {
		if (errorEl) errorEl.hidden = true;
		dialog?.showModal();
		messageInput?.focus();
	});

	cancelButton?.addEventListener("click", () => {
		form?.reset();
		dialog?.close();
	});

	form?.addEventListener("submit", (event) => {
		event.preventDefault();
		if (!messageInput || !emailInput || !errorEl || !dialog) return;

		const data = {
			message: messageInput.value,
			email: emailInput.value.trim() || undefined,
			page: window.location.pathname,
		};

		const result = validateFeedback(data);
		if (!result.valid) {
			errorEl.textContent = result.error ?? "Something went wrong.";
			errorEl.hidden = false;
			return;
		}

		window.location.href = buildFeedbackMailtoUrl(data);
		form?.reset();
		dialog.close();
	});
</script>
