---
// Remembers which tracking link brought a visitor and tags Stripe buy links
// and /buy/ links with it. See src/lib/trafficSource.ts.
---

<script>
	import { SOURCE_STORAGE_KEY, SOURCE_TTL_MS, cleanSource } from "../lib/trafficSource";

	try {
		const params = new URLSearchParams(location.search);
		const utmSource = cleanSource(params.get("utm_source"));
		if (utmSource) {
			const parts = [utmSource, cleanSource(params.get("utm_medium")), cleanSource(params.get("utm_campaign"))];
			const source = parts.map((p) => p ?? "").join("__").replace(/(__)+$/, "");
			localStorage.setItem(SOURCE_STORAGE_KEY, JSON.stringify({ source, ts: Date.now() }));
		}

		const saved = JSON.parse(localStorage.getItem(SOURCE_STORAGE_KEY) ?? "null") as
			| { source: string; ts: number }
			| null;
		if (saved && Date.now() - saved.ts < SOURCE_TTL_MS) {
			const [source, medium, campaign] = saved.source.split("__");
			document.querySelectorAll<HTMLAnchorElement>('a[href^="https://buy.stripe.com/"]').forEach((link) => {
				const url = new URL(link.href);
				url.searchParams.set("client_reference_id", saved.source);
				// Stripe's payment-link report also groups by these.
				url.searchParams.set("utm_source", source);
				if (medium) url.searchParams.set("utm_medium", medium);
				if (campaign) url.searchParams.set("utm_campaign", campaign);
				link.href = url.toString();
			});
			// Our own checkout: /buy/<id> passes it through PayPal onto the order.
			document.querySelectorAll<HTMLAnchorElement>('a[href^="/buy/"]').forEach((link) => {
				const url = new URL(link.href);
				url.searchParams.set("src", saved.source);
				link.href = url.pathname + url.search + url.hash;
			});
		}
	} catch {
		// Storage blocked (private mode etc.): tracking is best-effort only.
	}

	// Funnel counts for /admin/funnel: one beacon per page view and per buy
	// click (see src/pages/api/track.ts). Counts only, no cookies or ids.
	try {
		const send = (event: "view" | "buy_click") => {
			if (navigator.webdriver) return;
			let source = "";
			try {
				const saved = JSON.parse(localStorage.getItem(SOURCE_STORAGE_KEY) ?? "null") as { source: string; ts: number } | null;
				if (saved && Date.now() - saved.ts < SOURCE_TTL_MS) source = saved.source;
			} catch {
				// no saved source: counted as direct
			}
			let path = location.pathname;
			// /thank-you: only a return from a Stripe checkout (?s=cs_...) counts as
			// /thank-you. The page's own wait-for-payment reloads (?t=1..) are not new
			// views, and a visit without a checkout session (owner checks, old links)
			// is counted apart so the funnel shows real buyer returns.
			if (path.replace(/\/+$/, "") === "/thank-you") {
				const q = new URLSearchParams(location.search);
				if (event === "view" && q.has("t")) return;
				if (!/^cs_(live|test)_[A-Za-z0-9]+$/.test(q.get("s") ?? "")) path = "/thank-you/no-session";
			}
			const body = new Blob([JSON.stringify({ event, path, source })], { type: "application/json" });
			navigator.sendBeacon("/api/track", body);
		};
		send("view");
		document.addEventListener("click", (e) => {
			const link = (e.target as Element | null)?.closest?.("a");
			if (!link) return;
			const href = link.getAttribute("href") ?? "";
			if (href.startsWith("https://buy.stripe.com/") || href.startsWith("/buy/")) send("buy_click");
		});
	} catch {
		// Tracking must never break the page.
	}
</script>
