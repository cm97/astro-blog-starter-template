---
import type { Video } from '../data/videos';

interface Props {
	video: Video;
}

const { video } = Astro.props;
---

<a class="video-card" href={video.href}>
	<div class="thumb-frame">
		<img src={video.thumbnail} alt={video.title} width="320" height="180" loading="lazy" />
		<span class="duration">{video.duration}</span>
		<span class="play-badge" aria-hidden="true">
			<svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M8 5v14l11-7z"></path></svg>
		</span>
	</div>
	<h3>{video.title}</h3>
	<p>{video.description}</p>
</a>

<style>
	.video-card {
		display: block;
		color: inherit;
		text-decoration: none;
	}
	.thumb-frame {
		position: relative;
		border-radius: 12px;
		overflow: hidden;
		box-shadow: var(--box-shadow);
		aspect-ratio: 16 / 9;
	}
	.thumb-frame img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		transition: transform 0.2s ease;
	}
	.video-card:hover .thumb-frame img {
		transform: scale(1.04);
	}
	.duration {
		position: absolute;
		right: 0.5em;
		bottom: 0.5em;
		padding: 0.15em 0.5em;
		border-radius: 4px;
		background: rgba(0, 0, 0, 0.75);
		color: white;
		font-size: 0.75em;
	}
	.play-badge {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: auto;
		width: 48px;
		height: 48px;
		top: calc(50% - 24px);
		left: calc(50% - 24px);
		border-radius: 50%;
		background: rgba(18, 50, 48, 0.85);
		color: white;
		opacity: 0;
		transition: opacity 0.2s ease;
	}
	.video-card:hover .play-badge {
		opacity: 1;
	}
	.video-card h3 {
		margin: 0.6em 0 0.2em;
		font-size: 1.1em;
		color: rgb(var(--black));
	}
	.video-card p {
		margin: 0;
		font-size: 0.9em;
		color: rgb(var(--gray-dark));
	}
</style>
