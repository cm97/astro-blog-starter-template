---
import type { Video } from '../data/videos';

interface Props {
	video: Video;
}

const { video } = Astro.props;
---

<button
	type="button"
	class="video-card"
	data-video-trigger
	data-video-src={video.videoUrl}
	data-video-title={video.title}
	aria-haspopup="dialog"
	aria-controls="video-lightbox"
>
	<div class="thumb-frame">
		<img src={video.thumbnail} alt={video.title} width="320" height="180" loading="lazy" />
		<span class="play-badge" aria-hidden="true">
			<svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M8 5v14l11-7z"></path></svg>
		</span>
	</div>
	<h3>{video.title}</h3>
	<p>{video.description}</p>
</button>

<style>
	.video-card {
		display: block;
		width: 100%;
		border: none;
		background: none;
		padding: 0;
		font-family: inherit;
		text-align: left;
		color: inherit;
		cursor: pointer;
	}
	.thumb-frame {
		position: relative;
		border-radius: 12px;
		overflow: hidden;
		box-shadow: var(--box-shadow);
		aspect-ratio: 16 / 9;
	}
	.thumb-frame img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		transition: transform 0.2s ease;
	}
	.video-card:hover .thumb-frame img {
		transform: scale(1.04);
	}
	.play-badge {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: auto;
		width: 48px;
		height: 48px;
		top: calc(50% - 24px);
		left: calc(50% - 24px);
		border-radius: 50%;
		background: rgba(18, 50, 48, 0.85);
		color: white;
		transition: transform 0.2s ease;
	}
	.video-card:hover .play-badge {
		transform: scale(1.1);
	}
	.video-card h3 {
		margin: 0.6em 0 0.2em;
		font-size: 1.1em;
		color: rgb(var(--black));
	}
	.video-card p {
		margin: 0;
		font-size: 0.9em;
		color: rgb(var(--gray-dark));
	}
</style>
