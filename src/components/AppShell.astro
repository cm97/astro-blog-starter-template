---
// The shell shared by the Buzzyfly web apps (/app and /app/reset): the app
// itself for buyers, or the locked product card for everyone else. Each page
// checks access with resolveAppAccess() before rendering this.
import { ALL_PRODUCTS, BUZZYFLY_CONFIG } from "../data/monetization";

interface Props {
	itemId: string;
	unlocked: boolean;
	badLink: boolean;
	/** Which app this is. The script shows only that edition's screens. */
	edition: "system" | "reset" | "followups";
	nav: { id: string; label: string; icon: string }[];
	appName: string;
}

const { itemId, unlocked, badLink, edition, nav, appName } = Astro.props;
const product = ALL_PRODUCTS.find((p) => p.id === itemId)!;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex" />
		<meta name="theme-color" content="#1f4d3a" />
		<title>{unlocked ? `Buzzyfly ${appName}` : `${product.title} — ${BUZZYFLY_CONFIG.brandName}`}</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	</head>
	<body data-edition={edition}>
		{unlocked ? (
			<>
				<header class="top">
					<a class="brand" href={`#${nav[0].id}`} data-nav={nav[0].id}><span class="logo" aria-hidden="true">B</span> Buzzyfly <span class="sub">{appName}</span></a>
				</header>
				<main id="app-root" class="wrap" tabindex="-1">
					<noscript><p class="card">The app needs JavaScript turned on.</p></noscript>
				</main>
				<p id="app-status" class="sr" role="status" aria-live="polite"></p>
				<nav class="tabs" aria-label="App sections">
					{nav.map((n) => (
						<a href={`#${n.id}`} data-nav={n.id}><span aria-hidden="true">{n.icon}</span>{n.label}</a>
					))}
				</nav>
				<script>
					import "../scripts/buzzyApp";
				</script>
			</>
		) : (
			<main class="wrap locked">
				<section class="card">
					<span class="logo" aria-hidden="true">B</span>
					<h1>{badLink ? "That access link didn't work" : product.title}</h1>
					{badLink ? (
						<p>Check that you copied the whole link from your thank-you page or order email. If it still doesn't work, email us and we'll send a fresh one.</p>
					) : (
						<p>{product.description}</p>
					)}
					<ul class="list">
						{product.features.map((f) => <li>{f}</li>)}
					</ul>
					{product.buyUrl && <a class="btn block" href={product.buyUrl}>Get it for {product.price}, one time</a>}
					<p class="muted small">{BUZZYFLY_CONFIG.guarantee}</p>
					<p class="muted small">
						Already bought it? Open the access link from your thank-you page or order email. Lost it? Email
						<a href={`mailto:${BUZZYFLY_CONFIG.supportEmail}`}>{BUZZYFLY_CONFIG.supportEmail}</a> from your checkout address.
					</p>
					<p class="small"><a href="/store">← Back to the store</a></p>
				</section>
			</main>
		)}
	</body>
</html>

<style is:global>
	:root {
		--bg: #f6f4ee;
		--card: #ffffff;
		--ink: #1d211f;
		--muted: #5f655f;
		--line: #e2ded3;
		--brand: #1f4d3a;
		--brand-ink: #ffffff;
		--accent: #e0a012;
		--danger: #b3261e;
		--due: #9a5b00;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #101412;
			--card: #181e1b;
			--ink: #ecefea;
			--muted: #a3aba4;
			--line: #2b332f;
			--brand: #3f9c74;
			--brand-ink: #08130e;
			--danger: #ff8a80;
			--due: #f2b54a;
		}
	}
	* { box-sizing: border-box; }
	body {
		margin: 0;
		background: var(--bg);
		color: var(--ink);
		font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
		-webkit-text-size-adjust: 100%;
	}
	a { color: var(--brand); }
	h1, h2, h3 { line-height: 1.25; margin: 0 0 0.4em; }
	h1 { font-size: 1.5rem; }
	h2 { font-size: 1.2rem; }
	h3 { font-size: 1.05rem; }
	p { margin: 0 0 0.6em; }
	.wrap { max-width: 640px; margin: 0 auto; padding: 16px 16px calc(96px + env(safe-area-inset-bottom)); outline: none; }
	.locked { padding-bottom: 48px; }
	.top {
		position: sticky; top: 0; z-index: 10;
		background: var(--card); border-bottom: 1px solid var(--line);
		padding: 10px 16px;
	}
	.brand { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; color: var(--ink); text-decoration: none; min-height: 44px; }
	.sub { color: var(--brand); font-weight: 600; font-size: 0.85rem; }
	.logo {
		display: inline-grid; place-items: center; width: 32px; height: 32px; border-radius: 8px;
		background: var(--brand); color: var(--brand-ink); font-weight: 800;
	}
	.locked .logo { margin-bottom: 12px; }
	.card {
		display: block; width: 100%; text-align: left; color: inherit; font: inherit;
		background: var(--card); border: 1px solid var(--line); border-radius: 14px;
		padding: 16px; margin: 0 0 12px;
	}
	.hero { border-color: var(--brand); }
	.priority h2 { margin: 0; }
	.eyebrow { text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.75rem; font-weight: 700; color: var(--brand); margin-bottom: 4px; }
	.section-title { font-size: 1rem; margin: 20px 0 10px; display: flex; align-items: center; gap: 8px; }
	.count { background: var(--line); border-radius: 999px; padding: 0 8px; font-size: 0.8rem; }
	.muted { color: var(--muted); }
	.small { font-size: 0.85rem; }
	.pad { padding: 0 4px; }
	.btn {
		display: inline-flex; align-items: center; justify-content: center; gap: 6px;
		min-height: 44px; padding: 10px 16px; border-radius: 10px;
		border: 1px solid var(--brand); background: var(--brand); color: var(--brand-ink);
		font: inherit; font-weight: 600; text-decoration: none; cursor: pointer;
	}
	.btn-ghost { background: transparent; color: var(--brand); }
	.btn-danger { background: transparent; border-color: var(--danger); color: var(--danger); }
	.btn.block { width: 100%; margin: 4px 0 12px; }
	.link { background: none; border: 0; padding: 8px 0; min-height: 44px; color: var(--brand); font: inherit; font-weight: 600; cursor: pointer; }
	.btn:focus-visible, .link:focus-visible, .card:focus-visible, a:focus-visible,
	input:focus-visible, select:focus-visible, textarea:focus-visible {
		outline: 3px solid var(--accent); outline-offset: 2px;
	}
	.actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; align-items: center; }
	.form label { display: block; font-weight: 600; font-size: 0.9rem; margin: 0 0 12px; }
	.form label small { display: block; font-weight: 400; }
	input, select, textarea {
		display: block; width: 100%; margin-top: 4px; min-height: 44px;
		padding: 10px 12px; border-radius: 10px; border: 1px solid var(--line);
		background: var(--bg); color: var(--ink); font: inherit; font-size: 16px; font-weight: 400;
	}
	textarea { resize: vertical; line-height: 1.45; }
	input[type="checkbox"] { width: 22px; height: 22px; min-height: 0; margin: 2px 0 0; flex: none; accent-color: var(--brand); }
	.row { display: flex; gap: 8px; align-items: flex-end; }
	.row label { margin: 0; }
	.grow { flex: 1; }
	.inline { display: flex; align-items: center; gap: 8px; font-weight: 600; }
	.inline select { width: auto; margin: 0; }
	.grid2, .grid3 { display: grid; gap: 0 12px; grid-template-columns: 1fr; }
	@media (min-width: 480px) { .grid2 { grid-template-columns: 1fr 1fr; } .grid3 { grid-template-columns: 1fr 1fr 1fr; } }
	.tag { display: inline-block; font-size: 0.75rem; font-weight: 700; border-radius: 999px; padding: 2px 10px; background: var(--line); margin-bottom: 6px; }
	.tag-proposal, .tag-invoiced { background: #fbe7c0; color: #5c3b00; }
	.tag-active { background: #cfe9dc; color: #12392a; }
	.row-card { display: flex; justify-content: space-between; align-items: center; gap: 12px; cursor: pointer; min-height: 64px; }
	.due { color: var(--due); font-weight: 700; }
	.callout { background: color-mix(in srgb, var(--accent) 18%, var(--card)); border-radius: 10px; padding: 12px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; }
	.list { padding-left: 1.2em; margin: 0 0 12px; }
	.list li { margin-bottom: 6px; }
	.checklist { list-style: none; padding: 0; margin: 8px 0 0; }
	.checklist li { border-top: 1px solid var(--line); padding: 8px 0; }
	.checklist label { display: flex; gap: 10px; align-items: flex-start; cursor: pointer; min-height: 44px; }
	.notes { white-space: pre-wrap; }
	.stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 12px 0; }
	.stats div { background: var(--bg); border-radius: 10px; padding: 10px; text-align: center; }
	.stats strong { display: block; font-size: 1.4rem; }
	.stats small { color: var(--muted); font-size: 0.75rem; }
	.result { font-size: 1.05rem; display: flex; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 10px; }
	.tasks { padding-left: 1.4em; margin: 12px 0 0; }
	.tasks li { padding: 6px 0; }
	.tasks li span { margin-right: 8px; }
	.tasks li small { color: var(--muted); margin-right: 8px; }
	.tasks .top span { font-weight: 700; }
	.file { position: relative; overflow: hidden; }
	.file input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
	.empty { text-align: center; padding: 24px 8px; color: var(--muted); }
	.bars { display: flex; align-items: flex-end; gap: 2px; height: 96px; padding: 4px 0; border-bottom: 1px solid var(--line); }
	.bars span { flex: 0 1 16px; min-height: 2px; background: var(--brand); border-radius: 2px 2px 0 0; }
	.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
	.tabs {
		position: fixed; left: 0; right: 0; bottom: 0; z-index: 10;
		display: grid; grid-auto-flow: column; grid-auto-columns: 1fr;
		background: var(--card); border-top: 1px solid var(--line);
		padding-bottom: env(safe-area-inset-bottom);
	}
	.tabs a {
		display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
		min-height: 56px; font-size: 0.7rem; font-weight: 600; color: var(--muted); text-decoration: none;
	}
	.tabs a[aria-current="page"] { color: var(--brand); }
	.tabs a span { font-size: 1.1rem; }
	@media (prefers-reduced-motion: no-preference) { .btn, .card { transition: border-color 0.15s, background-color 0.15s; } }
</style>
