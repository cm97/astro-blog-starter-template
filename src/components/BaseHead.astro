---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import TrafficSource from './TrafficSource.astro';

interface Props {
	title: string;
	description: string;
	/** Social share image. Must be a raster file (JPG/PNG) — social sites ignore SVG. */
	image?: string;
	/** "article" for blog posts, "website" everywhere else. */
	type?: 'website' | 'article';
	/** Keep the page out of search results (order confirmations, account pages). */
	noindex?: boolean;
	/** Structured data (schema.org) objects, emitted as JSON-LD. */
	jsonLd?: Record<string, unknown>[];
	publishedTime?: Date;
	modifiedTime?: Date;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = '/og-default.jpg',
	type = 'website',
	noindex = false,
	jsonLd = [],
	publishedTime,
	modifiedTime,
} = Astro.props;
const imageURL = new URL(image, Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Bing Webmaster Tools -->
<meta name="msvalidate.01" content="05F823E5224CC99C2A8A2B9CD9891EBD" />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Buzzyfly" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

<TrafficSource />
