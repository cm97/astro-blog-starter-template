---
import { BUZZYFLY_CONFIG } from "../data/monetization";
import { getSettings } from "../lib/settings";

interface Props {
	title?: string;
	description?: string;
	buttonLabel?: string;
}

const settings = await getSettings(Astro.locals.runtime?.env);
const {
	title = settings.newsletterTitle || BUZZYFLY_CONFIG.newsletterTitle,
	description = settings.newsletterDescription || BUZZYFLY_CONFIG.newsletterDescription,
	buttonLabel = "Send me the checklist",
} = Astro.props;
const brand = settings.brandName || BUZZYFLY_CONFIG.brandName;
---

<section class="email-optin" aria-label={`${brand} newsletter signup`}>
	<h3 class="email-optin__title">{title}</h3>
	<p class="email-optin__description">{description}</p>
	<form class="email-optin__form" data-email-optin-form method="POST" action="/api/subscribe">
		<label class="sr-only" for="email-optin-input">Email address</label>
		<input
			id="email-optin-input"
			class="email-optin__input"
			type="email"
			name="email"
			placeholder="you@example.com"
			autocomplete="email"
			required
		/>
		<button class="email-optin__submit btn-secondary" type="submit">{buttonLabel}</button>
	</form>
	<p class="email-optin__status" data-email-optin-status role="status" aria-live="polite"></p>
</section>

<script>
	import { SOURCE_STORAGE_KEY, SOURCE_TTL_MS } from "../lib/trafficSource";

	function savedSource(): string | null {
		try {
			const saved = JSON.parse(localStorage.getItem(SOURCE_STORAGE_KEY) ?? "null");
			return saved && Date.now() - saved.ts < SOURCE_TTL_MS ? saved.source : null;
		} catch {
			return null;
		}
	}

	const forms = document.querySelectorAll<HTMLFormElement>("[data-email-optin-form]");

	forms.forEach((form) => {
		form.addEventListener("submit", async (event) => {
			event.preventDefault();

			const statusEl = form.parentElement?.querySelector<HTMLElement>(
				"[data-email-optin-status]",
			);
			const submitButton = form.querySelector<HTMLButtonElement>(
				".email-optin__submit",
			);
			const emailInput = form.querySelector<HTMLInputElement>("input[name=email]");
			const email = emailInput?.value ?? "";

			if (submitButton) submitButton.disabled = true;
			if (statusEl) {
				statusEl.textContent = "Sending…";
				statusEl.dataset.state = "pending";
			}

			try {
				const response = await fetch(form.action, {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ email, source: savedSource() }),
				});

				if (!response.ok) throw new Error("Request failed");

				if (statusEl) {
					statusEl.textContent = "You're in! Check your inbox soon.";
					statusEl.dataset.state = "success";
				}
				form.reset();
			} catch {
				if (statusEl) {
					statusEl.textContent = "Something went wrong. Please try again.";
					statusEl.dataset.state = "error";
				}
			} finally {
				if (submitButton) submitButton.disabled = false;
			}
		});
	});
</script>

<style>
	.email-optin {
		margin: var(--space-6) 0;
		padding: var(--space-4) var(--space-3);
		border-radius: var(--radius-card);
		background: var(--surface);
		border: 1px solid var(--line);
		text-align: center;
	}
	.email-optin__title {
		margin: 0 0 var(--space-1) 0;
		font-size: clamp(1.3em, 5vw, 1.6em);
	}
	.email-optin__description {
		margin: 0 0 var(--space-3) 0;
		color: rgb(var(--gray-dark));
	}
	.email-optin__form {
		display: flex;
		gap: var(--space-1);
		justify-content: center;
		flex-wrap: wrap;
	}
	.email-optin__input {
		flex: 1 1 260px;
		max-width: 320px;
		min-height: 44px;
		box-sizing: border-box;
		padding: 0 var(--space-2);
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		background: var(--bg);
		color: var(--ink);
		font-family: inherit;
		font-size: 16px;
	}
	/* Secondary on purpose: the buy button is the primary action on every page. */
	.email-optin__submit {
		font-size: 0.9em;
	}
	.email-optin__submit:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}
	.email-optin__status {
		margin: var(--space-1) 0 0 0;
		min-height: 1.2em;
		font-size: 0.85em;
		color: var(--muted);
	}
	.email-optin__status[data-state="success"] {
		color: var(--success);
	}
	.email-optin__status[data-state="error"] {
		color: var(--danger);
	}
</style>
