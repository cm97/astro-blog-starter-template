---
/**
 * One money prompt a day. The list is fixed; the day (America/New_York) picks
 * the entry, so everyone sees the same prompt on the same date. Each prompt
 * points at the product that does that job.
 */
import { getProduct } from "../../data/monetization";

const PROMPTS = [
	// Lines drawn from live /store, /overdue-invoice-email and /demo content (Enoch, Nov 25).
	{ text: "Sent a proposal that went quiet? Day 3, 7 and 14 are the follow-up days. Send the next one today.", product: "follow-up-email-templates" },
	{ text: "One lead hasn't heard from you in a while. Send a short follow-up today, before it gets awkward.", product: "follow-up-email-templates" },
	{ text: "Take 20 minutes now: clear the list, pick one priority for the week, check on every client.", product: "weekly-reset-checklist" },
	{ text: "Next client about to sign? Write out their first ten days now: welcome, intake, kickoff.", product: "client-onboarding-kit" },
	{ text: "Unpaid invoice? A reminder at 1 day, 1 week and 2 weeks late keeps it polite. Send today's.", product: "follow-up-email-templates" },
	{ text: "A client asking for \"just one more thing\" is coming. Decide your reply and your price before they ask.", product: "buzzyfly-digital-system" },
	{ text: "Before you open your inbox, write down this week's #1 priority and the one email it needs.", product: "weekly-reset-checklist" },
].map((p) => {
	const prod = getProduct(p.product)!;
	return { text: p.text, title: prod.title, price: prod.price, href: prod.buyUrl ?? "/store" };
});

function dayIndex(d: Date) {
	const ymd = new Intl.DateTimeFormat("en-CA", { timeZone: "America/New_York", year: "numeric", month: "2-digit", day: "2-digit" }).format(d);
	return Math.floor(Date.parse(`${ymd}T00:00:00Z`) / 86400000);
}
const today = PROMPTS[dayIndex(new Date()) % PROMPTS.length];
---
<section class="sp-card sp-prompt" aria-label="Today's money prompt">
	<p class="sp-label">Today's money move</p>
	<p class="sp-prompt__text" data-prompt-text>{today.text}</p>
	<a class="sp-prompt__link" data-prompt-link href={today.href}>Do it faster with the {today.title} · {today.price} →</a>
	<script type="application/json" data-prompt-list set:html={JSON.stringify(PROMPTS).replace(/</g, "\\u003c")} />
</section>

<script>
	// Re-pick on the client so a cached page still shows today's prompt.
	const list = JSON.parse(document.querySelector("[data-prompt-list]")?.textContent ?? "[]");
	if (list.length) {
		const ymd = new Intl.DateTimeFormat("en-CA", { timeZone: "America/New_York", year: "numeric", month: "2-digit", day: "2-digit" }).format(new Date());
		const p = list[Math.floor(Date.parse(`${ymd}T00:00:00Z`) / 86400000) % list.length];
		const t = document.querySelector("[data-prompt-text]");
		const a = document.querySelector<HTMLAnchorElement>("[data-prompt-link]");
		if (t && a) { t.textContent = p.text; a.href = p.href; a.textContent = `Do it faster with the ${p.title} · ${p.price} →`; }
	}
</script>

<style>
	.sp-prompt__text { font-size: 1.05em; font-weight: 700; margin: 0 0 0.6em; line-height: 1.4; color: var(--sp-fg); }
	.sp-prompt__link { font-weight: 700; font-size: 0.9em; display: inline-flex; min-height: 44px; align-items: center; }
</style>
