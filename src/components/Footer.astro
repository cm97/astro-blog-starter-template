		<p class="footer-copy">&copy; {today.getFullYear()} Buzzyfly. All rights reserved.</p>
	</div>
</footer>
<style>
	footer {
		padding: var(--space-6) var(--gutter) var(--space-8);
		background: var(--bg);
		border-top: 1px solid var(--line);
		color: var(--muted);
		text-align: center;
	}
	.footer-inner { max-width: 760px; margin: 0 auto; }
	.footer-links { margin-bottom: var(--space-2); font-size: 0.85em; }
	.footer-links a { display: inline-block; padding: 10px 2px; color: var(--muted); text-decoration: none; font-weight: 600; }
	.footer-links a:hover { color: var(--ink); }
	.sep { margin: 0 0.4em; opacity: 0.5; }
	.footer-guarantee { margin: 0 0 var(--space-1); font-size: 0.8em; }
	.footer-copy { margin: 0; font-size: 0.75em; opacity: 0.7; }
</style>
