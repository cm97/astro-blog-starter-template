---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-links">
			<a href="/domains">Domains</a>
			<span class="sep">·</span>
			<a href="/tools/index.html">Tools</a>
			<span class="sep">·</span>
			<a href="/kids">Kids</a>
			<span class="sep">·</span>
			<a href="/kids-course">Kids Course · $29</a>
			<span class="sep">·</span>
			<a href="/store">Store · $49</a>
			<span class="sep">·</span>
			<a href="/blog">Blog</a>
			<span class="sep">·</span>
			<a href="/jobs">Jobs</a>
			<span class="sep">·</span>
			<a href="/privacy">Privacy</a>
			<span class="sep">·</span>
			<a href="/terms">Terms</a>
			<span class="sep">·</span>
			<a href="/admin">Admin</a>
			<span class="sep">·</span>
			<a href="mailto:coachmanager@gmail.com">Support</a>
		</div>
