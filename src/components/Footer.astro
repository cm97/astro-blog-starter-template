---
import { BUZZYFLY_CONFIG } from '../data/monetization';
const today = new Date();
---

<footer>
	<div class="footer-grid">
		<div>
			<strong>Buzzyfly</strong>
			<p>Onboarding, weekly planning, and follow-ups as checklists you actually run.</p>
		</div>
		<div>
			<h4>Shop</h4>
			<ul>
				<li><a href="/store">Digital System — $49</a></li>
				<li><a href="/blog">Blog</a></li>
				<li><a href="/about">About</a></li>
			</ul>
		</div>
		<div>
			<h4>Support</h4>
			<ul>
				<li><a href={`mailto:${BUZZYFLY_CONFIG.orderEmail}`}>{BUZZYFLY_CONFIG.orderEmail}</a></li>
				<li>7-day refund if the files aren't what the store lists</li>
			</ul>
		</div>
	</div>
	<p class="footer-copy">&copy; {today.getFullYear()} Buzzyfly. All rights reserved.</p>
</footer>
<style>
	footer {
		padding: 2.5em 1em 3em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: left;
	}
	.footer-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 2em;
		max-width: 720px;
		margin: 0 auto;
	}
	footer h4 {
		margin: 0 0 0.5em 0;
		font-size: 1em;
		color: rgb(var(--black));
	}
	footer ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	footer li {
		margin-bottom: 0.4em;
		font-size: 0.95em;
	}
	footer a {
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}
	footer a:hover {
		color: var(--accent);
	}
	.footer-copy {
		text-align: center;
		margin: 2em 0 0;
		font-size: 0.85em;
	}
</style>
