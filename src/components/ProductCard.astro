---
// A single product in the landing page grid. Reads from the D1 catalog rather
// than hardcoded props, so what appears here is whatever the admin console has
// published.
import { formatPrice, type Product } from "../lib/products";

interface Props {
	product: Product;
}

const { product } = Astro.props;

const price = product.priceCents > 0 ? formatPrice(product.priceCents, product.currency) : "Free";

// Without a checkout link there is nothing to buy, so the card shows a disabled
// state instead of a button that goes nowhere.
const canBuy = Boolean(product.checkoutUrl);
---

<article class="product-card">
	<div class="product-card__body">
		<h3 class="product-card__title">{product.title}</h3>
		{product.summary && <p class="product-card__summary">{product.summary}</p>}

		{
			product.features.length > 0 && (
				<ul class="product-card__features">
					{product.features.map((feature) => (
						<li>{feature}</li>
					))}
				</ul>
			)
		}
	</div>

	<div class="product-card__footer">
		<span class="product-card__price">{price}</span>
		{
			canBuy ? (
				<a class="product-card__cta" href={product.checkoutUrl}>
					Buy now
				</a>
			) : (
				<span class="product-card__cta product-card__cta--disabled">Coming soon</span>
			)
		}
	</div>
</article>

<style>
	.product-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.75rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 16px;
		background: #fff;
		box-shadow: 0 1px 3px rgba(var(--gray), 12%);
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}
	.product-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(var(--gray), 20%);
	}
	.product-card__title {
		margin: 0 0 0.5rem 0;
		font-size: 1.4rem;
		line-height: 1.3;
	}
	.product-card__summary {
		margin: 0;
		font-size: 1rem;
		color: rgb(var(--gray-dark));
	}
	.product-card__features {
		margin: 1rem 0 0 0;
		padding-left: 1.15rem;
		font-size: 0.95rem;
		color: rgb(var(--gray-dark));
	}
	.product-card__features li {
		margin-bottom: 0.3rem;
	}
	.product-card__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		padding-top: 1.25rem;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.product-card__price {
		font-size: 1.5rem;
		font-weight: 700;
		color: rgb(var(--black));
	}
	.product-card__cta {
		display: inline-block;
		padding: 0.6rem 1.4rem;
		border-radius: 8px;
		background: var(--accent);
		color: #fff;
		font-size: 1rem;
		font-weight: 700;
		text-decoration: none;
		transition: background-color 0.15s ease;
	}
	.product-card__cta:hover {
		background: var(--accent-dark);
		color: #fff;
	}
	.product-card__cta--disabled {
		background: rgb(var(--gray-light));
		color: rgb(var(--gray));
		cursor: default;
	}
</style>
