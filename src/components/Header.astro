---
import HeaderLink from './HeaderLink.astro';
import { getSettings } from '../lib/settings';

let brand = 'Buzzyfly';
try {
	const settings = await getSettings(Astro.locals.runtime?.env);
	if (settings.brandName) brand = settings.brandName;
} catch {
	brand = 'Buzzyfly';
}
---

<header>
	<nav>
		<a href="/" class="brand">
			<img src="/buzzyfly-logo.svg" alt="" width="32" height="32" />
			<span>{brand}</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/" class="hide-sm">Home</HeaderLink>
			<HeaderLink href="/store">Store</HeaderLink>
			<HeaderLink href="/apps-pro" class="hide-sm">Apps</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about" class="hide-sm">How it works</HeaderLink>
			<HeaderLink href="/store#digital-system" class="store-pill">Get the $49 System</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		background: var(--bg);
		border-bottom: 1px solid var(--line);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 var(--gutter);
		min-height: 64px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: var(--space-1);
		min-height: 44px;
		color: var(--ink);
		text-decoration: none;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 0.95em;
		letter-spacing: -0.02em;
		flex-shrink: 0;
	}
	.brand img { width: 32px; height: 32px; border-radius: 8px; display: block; }
	.internal-links {
		display: flex;
		align-items: center;
		gap: var(--space-1);
		flex-wrap: nowrap;
		white-space: nowrap;
	}
	nav .internal-links a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 var(--space-1);
		color: var(--muted);
		text-decoration: none;
		font-size: 0.8em;
		font-weight: 600;
	}
	nav .internal-links a:hover,
	nav .internal-links a.active { color: var(--ink); text-decoration: none; }
	/* Secondary pill: the page's own CTA is the primary action. */
	nav .internal-links .store-pill {
		margin-left: var(--space-1);
		padding: 0 var(--space-2);
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		color: var(--ink);
	}
	nav .internal-links .store-pill:hover { border-color: var(--ink); }
	@media (max-width: 640px) {
		nav { padding: 0 var(--space-2); gap: var(--space-1); }
		.brand span { display: none; }
		nav .internal-links .hide-sm { display: none; }
		nav .internal-links .store-pill { margin-left: 0; }
	}
</style>
