---
import HeaderLink from './HeaderLink.astro';
import { getSettings } from '../lib/settings';

let brand = 'Buzzyfly';
try {
	const settings = await getSettings(Astro.locals.runtime?.env);
	if (settings.brandName) brand = settings.brandName;
} catch {
	brand = 'Buzzyfly';
}
---

<header>
	<nav>
		<h2>
			<a href="/" class="brand">
				<img src="/buzzyfly-logo.svg" alt="" width="40" height="40" />
				<span>{brand}</span>
			</a>
		</h2>
		<a href="/store#digital-system" class="store-pill mobile-pill">Get the $49 System</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/store">Store</HeaderLink>
			<HeaderLink href="/apps-pro">Apps</HeaderLink>
			<HeaderLink href="/overdue-invoice-email">Free invoice tool</HeaderLink>
			<HeaderLink href="/store#digital-system" class="store-pill desktop-pill">Get the $49 System</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">How it works</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 { margin: 0; font-size: 1em; }
	h2 a, h2 a.active { text-decoration: none; }
	.brand {
		display: flex; align-items: center; gap: 0.5em;
		padding: 0.55em 0.4em !important;
		border-bottom-color: transparent !important;
	}
	.brand img { width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0; display: block; }
	.brand span { font-weight: 700; letter-spacing: 0.01em; }
	nav { display: flex; align-items: center; justify-content: space-between; gap: 0.75em; flex-wrap: wrap; }
	.internal-links { display: flex; flex-wrap: wrap; align-items: center; }
	nav a { padding: 1em 0.5em; color: var(--black); border-bottom: 4px solid transparent; text-decoration: none; }
	nav a.active { text-decoration: none; border-bottom-color: var(--accent); }
	.store-pill {
		background: var(--accent); color: #fff !important; border-radius: 999px;
		padding: 0.4em 0.9em !important; font-weight: 700; font-size: 0.9em;
	}
	.store-pill:hover { background: var(--accent-dark); }
	.mobile-pill { display: none; }
	/* Phones: logo and the buy button on one row, the other links on one
	   scrollable row below, so the page content starts near the top. */
	@media (max-width: 640px) {
		header { padding: 0 0.6em; }
		nav { flex-wrap: wrap; row-gap: 0; }
		.brand span { display: none; }
		.brand { padding: 0.35em 0.2em !important; }
		.mobile-pill { display: inline-flex; align-items: center; min-height: 44px; border-bottom: 0; }
		.desktop-pill { display: none !important; }
		.internal-links {
			order: 3; width: 100%; flex-wrap: nowrap; overflow-x: auto;
			-webkit-overflow-scrolling: touch; scrollbar-width: none;
		}
		.internal-links::-webkit-scrollbar { display: none; }
		nav a { padding: 0.6em 0.55em; font-size: 0.92em; white-space: nowrap; }
	}
</style>
