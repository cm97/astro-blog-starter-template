---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const mailto =
	"mailto:support@buzzyfly.com?subject=Buzzyfly%20product%20request&body=What%20I%20need%20(one%20sentence)%3A%0A%0AWhen%20I%20would%20use%20it%3A%0A%0AWhich%20existing%20product%20I%20already%20bought%20(or%20none)%3A%0A";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Request a Buzzyfly template"
			description="Ask for the checklist or email you cannot find. The same request from three buyers becomes the next file in the Digital System."
		/>
		<style>
			.rq { max-width: 640px; margin: 0 auto; padding-bottom: 2em; }
			.rq h1 { font-size: 2.1em; line-height: 1.15; }
			.rq .btn {
				display: inline-block;
				background: var(--accent);
				color: #fff;
				padding: 0.8em 1.2em;
				border-radius: 8px;
				text-decoration: none;
				font-weight: 700;
			}
			.rq ul { padding-left: 1.2em; }
		</style>
	</head>
	<body>
		<Header />
		<main class="rq">
			<h1>Ask for the file. If three people ask, it gets built.</h1>
			<p>
				Buzzyfly sells the $49 Digital System: onboarding, follow-ups and the weekly reset in one workbook.
				If the template you need is not in it, send one sentence. Same ask from three buyers becomes the next file, added to the Digital System for everyone who already bought it.
			</p>
			<p><a class="btn" href={mailto}>Email the request</a></p>
			<h2>Already covered — get this instead of waiting</h2>
			<ul>
				<li>Ghosted proposals, new clients and Monday chaos — <a href="/buy/buzzyfly-digital-system">Digital System, $49</a></li>
			</ul>
			<p>30-day refund for non-delivery or files not as described.</p>
			<p><a href="/store">Back to the store</a></p>
		</main>
		<Footer />
	</body>
</html>
