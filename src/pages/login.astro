---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

export const prerender = false;

if (Astro.locals.user) return Astro.redirect('/blog');

const error = Astro.url.searchParams.get('error');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Log in — ${SITE_TITLE}`} description="Log in to your account." />
	</head>
	<body>
		<Header />
		<main class="auth-main">
			<div class="auth-card">
				<h1>Welcome back</h1>
				<p class="auth-subtitle">Log in to write and share a post.</p>
				{error && <p class="auth-error" role="alert">{error}</p>}
				<form data-login-form method="POST" action="/api/auth/login">
					<label for="identifier">Email or username</label>
					<input id="identifier" name="identifier" type="text" required autocomplete="username" />

					<label for="password">Password</label>
					<input id="password" name="password" type="password" required autocomplete="current-password" />

					<button type="submit">Log in</button>
				</form>
				<p class="auth-switch">New here? <a href="/signup">Create an account</a></p>
			</div>
		</main>
		<Footer />
		<script>
			const form = document.querySelector<HTMLFormElement>('[data-login-form]');
			form?.addEventListener('submit', async (event) => {
				event.preventDefault();
				const button = form.querySelector('button');
				if (button) button.disabled = true;

				const data = new FormData(form);
				try {
					const response = await fetch(form.action, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(Object.fromEntries(data.entries())),
					});
					const result = (await response.json()) as { ok: boolean; error?: string };
					if (result.ok) {
						window.location.href = '/blog';
						return;
					}
					window.location.href = `/login?error=${encodeURIComponent(result.error ?? 'Login failed.')}`;
				} catch {
					window.location.href = '/login?error=Something%20went%20wrong.%20Please%20try%20again.';
				}
			});
		</script>
		<style>
			.auth-main {
				display: flex;
				justify-content: center;
				padding: 3em 1em;
			}
			.auth-card {
				width: 100%;
				max-width: 380px;
				padding: 2em;
				border-radius: 16px;
				background: #fff;
				border: 1px solid rgb(var(--gray-light));
				box-shadow: var(--box-shadow);
			}
			.auth-card h1 {
				margin-bottom: 0.2em;
			}
			.auth-subtitle {
				color: rgb(var(--gray));
				margin-bottom: 1.5em;
			}
			.auth-error {
				padding: 0.75em 1em;
				margin-bottom: 1em;
				border-radius: 8px;
				background: #fdecea;
				color: #b3261e;
				font-size: 0.9em;
			}
			form {
				display: flex;
				flex-direction: column;
				gap: 0.4em;
			}
			label {
				font-weight: 700;
				font-size: 0.9em;
				margin-top: 0.6em;
			}
			input {
				padding: 0.65em 0.9em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				font-family: inherit;
			}
			button {
				margin-top: 1.5em;
				padding: 0.75em;
				border: none;
				border-radius: 8px;
				background: var(--accent);
				color: #fff;
				font-weight: 700;
				font-size: 1em;
				font-family: inherit;
				cursor: pointer;
			}
			button:hover {
				background: var(--accent-dark);
			}
			button:disabled {
				opacity: 0.6;
				cursor: not-allowed;
			}
			.auth-switch {
				margin: 1.5em 0 0 0;
				text-align: center;
				font-size: 0.9em;
				color: rgb(var(--gray));
			}
		</style>
	</body>
</html>
