---
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";

const env = Astro.locals.runtime.env;
const q = Astro.url.searchParams.get("q")?.trim() ?? "";
const resent = Astro.url.searchParams.get("resent");
const resendError = Astro.url.searchParams.get("error");

// `fulfillments` has no surrogate id column; (provider, order_id) is unique
// (see the index in migrations/0001_init.sql) and identifies a row.
interface Fulfillment {
	provider: string;
	order_id: string;
	item_id: string;
	customer_email: string | null;
	created_at: number;
}

let orders: Fulfillment[] = [];
let total = 0;

if (env.DB) {
	try {
		const like = `%${q}%`;
		const [rows, count] = await Promise.all([
			env.DB.prepare(
				`SELECT provider, order_id, item_id, customer_email, created_at FROM fulfillments
				 WHERE order_id LIKE ? OR customer_email LIKE ? OR item_id LIKE ?
				 ORDER BY created_at DESC LIMIT 200`,
			)
				.bind(like, like, like)
				.all<Fulfillment>(),
			env.DB.prepare(
				`SELECT COUNT(*) as n FROM fulfillments WHERE order_id LIKE ? OR customer_email LIKE ? OR item_id LIKE ?`,
			)
				.bind(like, like, like)
				.first<{ n: number }>(),
		]);
		orders = rows.results ?? [];
		total = count?.n ?? 0;
	} catch (error) {
		console.error("Buzzyfly admin orders: failed to read D1", error);
	}
}
---

<AdminLayout title="Orders" active="orders">
	<h1>Orders</h1>
	<p class="admin-subtitle">{total} fulfilled order{total === 1 ? "" : "s"}.</p>

	{!env.DB && <p class="admin-notice admin-notice--warn">No D1 database bound — orders can't be listed.</p>}
	{resendError && <p class="admin-notice admin-notice--error">{resendError}</p>}
	{
		resent && (
			<p class="admin-notice admin-notice--success">
				New download link (valid 3 days): <a href={resent}>{resent}</a>
			</p>
		)
	}

	<div class="admin-card">
		<form method="GET" style="display:flex; gap: 0.75em; margin-bottom: 1em;">
			<input type="search" name="q" placeholder="Search by order id, item id, or email…" value={q} style="flex:1; padding:0.5em 0.75em; border:1px solid rgb(var(--gray-light)); border-radius:8px;" />
			<button class="admin-btn admin-btn--primary" type="submit">Search</button>
			{q && <a class="admin-btn" href="/admin/orders">Clear</a>}
		</form>

		{orders.length === 0 && <p>No orders found.</p>}
		{
			orders.length > 0 && (
				<table>
					<thead>
						<tr>
							<th>Order</th>
							<th>Item</th>
							<th>Provider</th>
							<th>Customer</th>
							<th>When</th>
							<th />
						</tr>
					</thead>
					<tbody>
						{orders.map((o) => (
							<tr>
								<td>{o.order_id}</td>
								<td>{o.item_id}</td>
								<td>{o.provider}</td>
								<td>{o.customer_email ?? "—"}</td>
								<td>{new Date(o.created_at).toLocaleString()}</td>
								<td>
									<form method="POST" action="/api/admin/orders/resend">
										<input type="hidden" name="provider" value={o.provider} />
										<input type="hidden" name="order_id" value={o.order_id} />
										<input type="hidden" name="q" value={q} />
										<button class="admin-btn" type="submit">Resend link</button>
									</form>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			)
		}
	</div>
</AdminLayout>
