---
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminHelp from "../../components/AdminHelp.astro";
import { getSettings } from "../../lib/settings";
import { getGitHubConfig } from "../../lib/github";
import { paypalKeyStatus } from "../../lib/paypal";

const env = Astro.locals.runtime.env;
const settings = await getSettings(env);
const paypal = await paypalKeyStatus(env);
const hasTokenSecret = Boolean(env.DOWNLOAD_TOKEN_SECRET);
const checkoutLive = paypal.accepted === true && hasTokenSecret && paypal.mode === "live";
const githubConfig = getGitHubConfig(env);
const status = Astro.url.searchParams.get("status");
const error = Astro.url.searchParams.get("error");
---

<AdminLayout title="Settings" active="settings">
	<h1>Site settings</h1>
	<p class="admin-subtitle">Buzzyfly branding &amp; monetization copy.</p>

	<AdminHelp title="How to use Settings" open={!githubConfig}>
		<p>
			The brand name, newsletter wording, and product description show on the public pages from the database as soon as you save. The dollar amount on a buy button stays the Stripe price, so the label and the charge never disagree.
		</p>
	</AdminHelp>
	{status === "saved" && <p class="admin-notice admin-notice--success">Saved to admin records.</p>}
	{status === "published" && <p class="admin-notice admin-notice--success">Saved and committed — the live site will update after the redeploy finishes.</p>}
	{error && <p class="admin-notice admin-notice--error">{error}</p>}

	<div class="admin-card">
		<h2 style="margin-top:0">Apps Pro checkout (PayPal)</h2>
		<p class={`admin-notice ${checkoutLive ? "admin-notice--success" : "admin-notice--error"}`}>
			{checkoutLive
				? "Live. /apps-pro shows \"Pay with PayPal\" and buyers are unlocked after paying."
				: "Not live yet. /apps-pro shows the \"Request Apps Pro\" form until every line below says OK."}
		</p>
		<ul>
			<li>PAYPAL_CLIENT_ID and PAYPAL_SECRET: {paypal.configured ? "OK, both found" : "MISSING. Add both in Cloudflare → buzzyfly → Settings → Variables and Secrets, type Secret, then Deploy."}</li>
			{paypal.configured && (
				<li>PayPal accepts the keys: {paypal.accepted ? "OK" : `NO (${paypal.error}). Re-copy the Client ID and Secret from the Live tab at developer.paypal.com.`}</li>
			)}
			<li>PayPal mode: {paypal.mode === "live" ? "OK, live (real payments)" : "sandbox (test money only). Remove PAYPAL_ENV in Cloudflare to take real payments."}</li>
			<li>DOWNLOAD_TOKEN_SECRET: {hasTokenSecret ? "OK" : "MISSING. Checkout refuses to charge without it. Add any long random text as a Secret with this name."}</li>
		</ul>
	</div>

	<div class="admin-card">
		<form class="admin-form" method="POST" action="/api/admin/settings">
			<label for="brandName">Brand name</label>
			<input id="brandName" name="brandName" type="text" value={settings.brandName} required />

			<label for="siteUrl">Site URL</label>
			<input id="siteUrl" name="siteUrl" type="url" value={settings.siteUrl} required />

			<label for="newsletterTitle">Newsletter title</label>
			<input id="newsletterTitle" name="newsletterTitle" type="text" value={settings.newsletterTitle} required />

			<label for="newsletterDescription">Newsletter description</label>
			<input id="newsletterDescription" name="newsletterDescription" type="text" value={settings.newsletterDescription} required />

			<label for="defaultProductTitle">Default product title</label>
			<input id="defaultProductTitle" name="defaultProductTitle" type="text" value={settings.defaultProductTitle} required />

			<label for="defaultProductPrice">Default product price</label>
			<input id="defaultProductPrice" name="defaultProductPrice" type="text" value={settings.defaultProductPrice} required />

			<label for="defaultProductDescription">Default product description</label>
			<input id="defaultProductDescription" name="defaultProductDescription" type="text" value={settings.defaultProductDescription} required />

			<label for="mailingAddress">Mailing address (for email footers)</label>
			<input
				id="mailingAddress"
				name="mailingAddress"
				type="text"
				value={settings.mailingAddress}
				placeholder="123 Main St, Springfield, IL 62701"
				autocomplete="street-address"
			/>
			<p class="admin-hint" style="margin:0.3em 0 0;font-size:0.9em;opacity:0.8;">
				{settings.mailingAddress.trim()
					? "Shown at the bottom of every subscriber email. Weekly emails are sending."
					: "Required by US anti-spam law in marketing email. Weekly subscriber emails are paused until this is filled in; the welcome email still sends. Home, business, or PO box address all work."}
			</p>

			<p style="margin-top:1.5em;">
				<button class="admin-btn admin-btn--primary" type="submit">Save settings</button>
			</p>
		</form>
	</div>
</AdminLayout>
