---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import { BUZZYFLY_CONFIG } from "../../../data/monetization";
import { getInboxMessage, replyFromAddress, replySubject, setRead } from "../../../lib/inbox";

const env = Astro.locals.runtime.env;
const id = Number(Astro.params.id);
const found = Number.isInteger(id) && id > 0 ? await getInboxMessage(env, id) : null;
if (!found) return Astro.redirect("/admin/inbox?error=" + encodeURIComponent("That message no longer exists."));

const { message, attachments } = found;
if (!message.read_at) await setRead(env, id, true);

const status = Astro.url.searchParams.get("status");
const error = Astro.url.searchParams.get("error");
const showImages = Astro.url.searchParams.get("images") === "1";

const sender = message.from_name ? `${message.from_name} <${message.from_address}>` : message.from_address;
const replyTo = message.reply_to ?? message.from_address;

// The email's HTML is shown in a sandboxed frame: no scripts, no access to
// this page, and no remote images unless asked for (they can track opens).
const csp = showImages
	? "default-src 'none'; img-src https: data:; style-src 'unsafe-inline' https:; font-src https: data:"
	: "default-src 'none'; img-src data:; style-src 'unsafe-inline'";
// A meta refresh could still navigate the frame itself, so it is dropped.
const safeHtml = message.html_body?.replace(/<meta[^>]*http-equiv\s*=\s*["']?refresh[^>]*>/gi, "");
const htmlDoc = safeHtml
	? `<!doctype html><html><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="${csp}"><base target="_blank"><style>body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;margin:16px;color:#16191c;word-wrap:break-word}img{max-width:100%;height:auto}</style></head><body>${safeHtml}</body></html>`
	: null;
const hasRemoteImages = !!message.html_body && /<img[^>]+src\s*=\s*["']?https?:/i.test(message.html_body);

function formatBytes(bytes: number): string {
	if (bytes < 1024) return `${bytes} B`;
	if (bytes < 1024 * 1024) return `${Math.round(bytes / 1024)} KB`;
	return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
}
---

<AdminLayout title={message.subject || "(no subject)"} active="inbox">
	<p><a href={message.archived ? "/admin/inbox?folder=archived" : "/admin/inbox"}>← Back to {message.archived ? "Archived" : "Buzzy Mail"}</a></p>
	<h1>{message.subject || "(no subject)"}</h1>

	{status === "sent" && <p class="admin-notice admin-notice--success">Reply sent to {replyTo}.</p>}
	{error && <p class="admin-notice admin-notice--error">{error}</p>}

	<div class="admin-card">
		<dl class="mail-head">
			<dt>From</dt>
			<dd>{sender}</dd>
			{message.reply_to && (<><dt>Reply-To</dt><dd>{message.reply_to}</dd></>)}
			<dt>To</dt>
			<dd>{message.to_address}</dd>
			<dt>Date</dt>
			<dd>{new Date(message.received_at).toLocaleString("en-US")}</dd>
			{message.replied_at && (<><dt>Replied</dt><dd>{new Date(message.replied_at).toLocaleString("en-US")}</dd></>)}
		</dl>

		<div class="mail-actions">
			<a class="admin-btn admin-btn--primary" href="#reply">Reply</a>
			<form method="POST" action={`/api/admin/inbox/${message.id}`}>
				<button class="admin-btn" type="submit" name="action" value="unread">Mark unread</button>
			</form>
			<form method="POST" action={`/api/admin/inbox/${message.id}`}>
				{message.archived
					? <button class="admin-btn" type="submit" name="action" value="unarchive">Move to Inbox</button>
					: <button class="admin-btn" type="submit" name="action" value="archive">Archive</button>}
			</form>
			<form method="POST" action={`/api/admin/inbox/${message.id}`} onsubmit="return confirm('Delete this email for good?')">
				<button class="admin-btn admin-btn--danger" type="submit" name="action" value="delete">Delete</button>
			</form>
		</div>

		{
			htmlDoc ? (
				<>
					{hasRemoteImages && !showImages && (
						<p class="mail-images">
							Images are hidden so the sender can't tell you opened this. <a href={`/admin/inbox/${message.id}?images=1`}>Show images</a>
						</p>
					)}
					<iframe
						class="mail-frame"
						title="Email content"
						sandbox="allow-popups allow-popups-to-escape-sandbox"
						referrerpolicy="no-referrer"
						srcdoc={htmlDoc}
					/>
					<details class="mail-text">
						<summary>Plain-text version</summary>
						<div class="mail-plain">{message.text_body || "(none)"}</div>
					</details>
				</>
			) : (
				<div class="mail-plain">{message.text_body || "(empty message)"}</div>
			)
		}

		{
			attachments.length > 0 && (
				<div class="mail-attachments">
					<h2>Attachments</h2>
					<ul>
						{attachments.map((a) => (
							<li>
								<a href={`/api/admin/inbox/attachment?id=${a.id}`}>📎 {a.filename}</a> <span>({formatBytes(a.size)})</span>
							</li>
						))}
					</ul>
					<p class="mail-warn">Only open attachments from people you expect them from.</p>
				</div>
			)
		}
	</div>

	<div class="admin-card" id="reply">
		<h2>Reply</h2>
		<p class="mail-reply-meta">
			To <strong>{replyTo}</strong> from <strong>{replyFromAddress(message.to_address)}</strong> · {replySubject(message.subject)}
		</p>
		<form class="admin-form" method="POST" action={`/api/admin/inbox/${message.id}`}>
			<input type="hidden" name="action" value="reply" />
			<label for="fromName">From name</label>
			<input id="fromName" name="fromName" type="text" value={BUZZYFLY_CONFIG.brandName} maxlength="60" required />
			<label for="body">Message</label>
			<textarea id="body" name="body" rows="10" required></textarea>
			<p class="mail-reply-note">The original email is quoted below your reply automatically.</p>
			<p><button class="admin-btn admin-btn--primary" type="submit">Send reply</button></p>
		</form>
	</div>
</AdminLayout>

<style>
	.mail-head {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.3em 1em;
		margin: 0 0 1em;
		font-size: 0.92em;
	}
	.mail-head dt {
		font-weight: 700;
		color: rgb(var(--gray));
	}
	.mail-head dd {
		margin: 0;
		word-break: break-word;
	}
	.mail-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin-bottom: 1.25em;
	}
	.mail-actions form {
		margin: 0;
	}
	.mail-actions .admin-btn {
		min-height: 44px;
		box-sizing: border-box;
	}
	.mail-frame {
		width: 100%;
		height: 70vh;
		min-height: 320px;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		background: #fff;
		resize: vertical;
	}
	.mail-plain {
		white-space: pre-wrap;
		word-break: break-word;
		font-size: 0.95em;
		line-height: 1.55;
	}
	.mail-text {
		margin-top: 0.75em;
		font-size: 0.9em;
	}
	.mail-images {
		font-size: 0.88em;
		color: rgb(var(--gray));
		margin: 0 0 0.5em;
	}
	.mail-attachments {
		margin-top: 1.25em;
		padding-top: 1em;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.mail-attachments h2 {
		font-size: 1em;
		margin: 0 0 0.5em;
	}
	.mail-attachments ul {
		margin: 0;
		padding-left: 0;
		list-style: none;
	}
	.mail-attachments li {
		margin-bottom: 0.3em;
	}
	.mail-warn,
	.mail-reply-meta,
	.mail-reply-note {
		font-size: 0.85em;
		color: rgb(var(--gray));
	}
</style>
