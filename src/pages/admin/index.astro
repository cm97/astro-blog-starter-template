---
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminHelp from "../../components/AdminHelp.astro";
import { auditTableExists, listAuditLog } from "../../lib/audit";

const env = Astro.locals.runtime.env;

let subscriberCount = 0;
let orderCount = 0;
let subscribersLast7d = 0;
let ordersLast7d = 0;
const sevenDaysAgo = Date.now() - 7 * 24 * 60 * 60 * 1000;

if (env.DB) {
	try {
		const [subs, orders, subs7d, orders7d] = await Promise.all([
			env.DB.prepare(`SELECT COUNT(*) as n FROM subscribers`).first<{ n: number }>(),
			env.DB.prepare(`SELECT COUNT(*) as n FROM fulfillments`).first<{ n: number }>(),
			env.DB
				.prepare(`SELECT COUNT(*) as n FROM subscribers WHERE created_at >= ?`)
				.bind(sevenDaysAgo)
				.first<{ n: number }>(),
			env.DB
				.prepare(`SELECT COUNT(*) as n FROM fulfillments WHERE created_at >= ?`)
				.bind(sevenDaysAgo)
				.first<{ n: number }>(),
		]);
		subscriberCount = subs?.n ?? 0;
		orderCount = orders?.n ?? 0;
		subscribersLast7d = subs7d?.n ?? 0;
		ordersLast7d = orders7d?.n ?? 0;
	} catch (error) {
		console.error("Buzzyfly admin dashboard: failed to read D1 stats", error);
	}
}

const auditReady = await auditTableExists(env);
const recentActivity = auditReady ? await listAuditLog(env, 8) : [];
const githubConfigured = Boolean(env.GITHUB_TOKEN && env.GITHUB_OWNER && env.GITHUB_REPO);

// One honest place to see what is switched on, what isn't, and what each
// missing piece actually costs you — rather than discovering a dead button.
const setup = [
	{
		label: "Sign-in",
		ok: true,
		unlocks: "You're here, so this works.",
		fix: null,
	},
	{
		label: "Database",
		ok: Boolean(env.DB),
		unlocks: "Subscribers, Orders and the counts above.",
		fix: "Bind the DB (buzzy-fly_db) D1 database to this Worker.",
	},
	{
		label: "File storage",
		ok: Boolean(env.MY_PRODUCTS),
		unlocks: "The Media library, and delivering files customers buy.",
		fix: "Bind the MY_PRODUCTS R2 bucket to this Worker.",
	},
	{
		label: "Activity log",
		ok: auditReady,
		unlocks: "A record of every sign-in and change.",
		fix: "Run: wrangler d1 execute buzzy-fly_db --remote --file=./migrations/0003_admin_console.sql",
	},
	{
		label: "Publishing",
		ok: githubConfigured,
		unlocks: "Writing, editing and publishing posts, and making Settings affect the live site.",
		fix: "Add GITHUB_TOKEN, GITHUB_OWNER and GITHUB_REPO as Worker secrets, then deploy.",
	},
	{
		label: "Grok replies",
		ok: Boolean((env as { XAI_API_KEY?: string }).XAI_API_KEY || process.env.XAI_API_KEY),
		unlocks: "A written email for each domain request and unpaid order. You still send it.",
		fix: "Set XAI_API_KEY on the Worker.",
	},
];

const missing = setup.filter((item) => !item.ok);

type QueueItem = { kind: "domain" | "order"; email: string; detail: string; price: string; when: number };
const queue: QueueItem[] = [];
if (env.DB) {
	try {
		const domains = await env.DB.prepare(
			`SELECT domain, email, created_at FROM domain_leads ORDER BY created_at DESC LIMIT 8`,
		).all<{ domain: string; email: string; created_at: number }>();
		for (const row of domains.results ?? []) {
			queue.push({ kind: "domain", email: row.email, detail: row.domain, price: "", when: row.created_at });
		}
	} catch {
		/* table may not exist yet */
	}
	try {
		const asked = await env.DB.prepare(
			`SELECT title, price, email, created_at FROM purchase_requests ORDER BY created_at DESC LIMIT 8`,
		).all<{ title: string; price: string; email: string; created_at: number }>();
		for (const row of asked.results ?? []) {
			queue.push({ kind: "order", email: row.email, detail: row.title, price: row.price, when: row.created_at });
		}
	} catch {
		/* table may not exist yet */
	}
}
queue.sort((a, b) => b.when - a.when);
---

<AdminLayout title="Dashboard" active="dashboard">
	<h1>Dashboard</h1>
	<p class="admin-subtitle">Buzzyfly, at a glance.</p>

	<AdminHelp title="What this console can do" open={missing.length > 0}>
		<ul>
			<li><strong>Needs you</strong> — domain requests and unpaid orders, with a Grok-written reply you can send.</li>
			<li><strong>Posts</strong> — write and publish to your blog.</li>
			<li><strong>Media</strong> — upload images and files, and copy links to use in posts.</li>
			<li><strong>Subscribers</strong> — your mailing list; search, remove, export.</li>
			<li><strong>Orders</strong> — purchases; re-send a customer's download link.</li>
			<li><strong>Settings</strong> — brand name and product wording used across the site.</li>
			<li><strong>Activity log</strong> — a record of everything done here.</li>
		</ul>
		<p>
			Each page has its own "How to use" panel like this one. Anything not switched on is listed
			below with what it would unlock.
		</p>
	</AdminHelp>

	<div class="admin-card">
		<h2>Setup</h2>
		{
			missing.length === 0 ? (
				<p>Everything is switched on. Nothing needs doing.</p>
			) : (
				<p>
					{missing.length} thing{missing.length === 1 ? "" : "s"} not switched on yet — each one
					below says what it would give you.
				</p>
			)
		}
		<ul class="setup-list">
			{
				setup.map((item) => (
					<li class:list={["setup-item", { "setup-item--off": !item.ok }]}>
						<span class="setup-mark">{item.ok ? "✓" : "○"}</span>
						<span class="setup-body">
							<strong>{item.label}</strong>
							<span class="setup-unlocks">{item.unlocks}</span>
							{!item.ok && item.fix && <code class="setup-fix">{item.fix}</code>}
						</span>
					</li>
				))
			}
		</ul>
	</div>

	<div class="admin-card">
		<h2>Needs you</h2>
		{queue.length === 0 && <p>Nothing waiting. New domain requests and kids-course orders show up here.</p>}
		{
			queue.map((item) => (
				<div class="queue-item">
					<p>
						<strong>{item.kind === "domain" ? item.detail : `${item.detail} · ${item.price}`}</strong>
						<br />
						{item.email}
					</p>
					<button
						class="admin-btn"
						type="button"
						data-draft
						data-kind={item.kind}
						data-email={item.email}
						data-detail={item.detail}
						data-price={item.price}
					>
						Write the reply
					</button>
					<div data-draft-out hidden></div>
				</div>
			))
		}
	</div>

	<div class="admin-stats">
		<div class="admin-stat">
			<div class="admin-stat__value">{subscriberCount}</div>
			<div class="admin-stat__label">Total subscribers</div>
		</div>
		<div class="admin-stat">
			<div class="admin-stat__value">{subscribersLast7d}</div>
			<div class="admin-stat__label">New subscribers (7d)</div>
		</div>
		<div class="admin-stat">
			<div class="admin-stat__value">{orderCount}</div>
			<div class="admin-stat__label">Total orders</div>
		</div>
		<div class="admin-stat">
			<div class="admin-stat__value">{ordersLast7d}</div>
			<div class="admin-stat__label">Orders (7d)</div>
		</div>
	</div>

	<div class="admin-card">
		<h2>Recent activity</h2>
		{recentActivity.length === 0 && <p>No admin activity recorded yet.</p>}
		{
			recentActivity.length > 0 && (
				<table>
					<thead>
						<tr>
							<th>When</th>
							<th>Who</th>
							<th>Action</th>
							<th>Detail</th>
						</tr>
					</thead>
					<tbody>
						{recentActivity.map((entry) => (
							<tr>
								<td>{new Date(entry.created_at).toLocaleString()}</td>
								<td>{entry.actor}</td>
								<td>{entry.action}</td>
								<td>{entry.detail ?? "—"}</td>
							</tr>
						))}
					</tbody>
				</table>
			)
		}
		<p><a class="admin-btn" href="/admin/log">View full activity log →</a></p>
	</div>
</AdminLayout>

<style>
	.queue-item {
		padding: 0.8em 0;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.queue-item p { margin: 0 0 0.4em; }
	.setup-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.setup-item {
		display: flex;
		gap: 0.7em;
		padding: 0.6em 0;
		border-top: 1px solid rgb(var(--gray-light));
		font-size: 0.92em;
	}
	.setup-item:first-child {
		border-top: none;
	}
	.setup-mark {
		flex: none;
		width: 1.2em;
		font-weight: 700;
		color: #1a7a3c;
	}
	.setup-item--off .setup-mark {
		color: rgb(var(--gray));
	}
	.setup-body {
		display: flex;
		flex-direction: column;
		gap: 0.15em;
		min-width: 0;
	}
	.setup-unlocks {
		color: rgb(var(--gray));
	}
	.setup-fix {
		margin-top: 0.3em;
		font-size: 0.85em;
		word-break: break-word;
		background: #fff4e0;
		color: #8a5a00;
		padding: 0.35em 0.5em;
		border-radius: 4px;
	}
</style>
