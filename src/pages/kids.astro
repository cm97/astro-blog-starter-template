---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import EmailOptin from "../components/EmailOptin.astro";
import { BUZZYFLY_CONFIG } from "../data/monetization";

const PRODUCTS = [
  {
    id: "morning-routine-chart",
    emoji: "☀️",
    title: "Morning Routine Chart",
    grades: "K–3",
    price: "$7",
    description: "A printable daily routine chart kids can follow independently — so the morning runs itself instead of running you.",
    features: [
      "Visual morning routine checklist",
      "Customizable chore chart",
      "Habit tracker for the school week",
      "Editable PDF — print as many copies as you need",
    ],
    stripeUrl: "",
    badge: null,
  },
  {
    id: "homework-planner-pack",
    emoji: "📚",
    title: "Homework Planner Pack",
    grades: "Grades 2–8",
    price: "$9",
    description: "Weekly homework tracker, assignment organizer, and test prep checklist — so nothing falls through the cracks on a busy school night.",
    features: [
      "Weekly homework tracker",
      "Per-subject assignment log",
      "Test prep countdown checklist",
      "Project due-date planner",
    ],
    stripeUrl: "",
    badge: null,
  },
  {
    id: "reading-log-bundle",
    emoji: "📖",
    title: "Reading Log Bundle",
    grades: "Grades 1–5",
    price: "$9",
    description: "Reading tracker, book review form, and reading goals sheet. Works for required reading and free choice — keeps kids motivated and accountable.",
    features: [
      "Monthly reading log (books + minutes)",
      "Book review template",
      "Reading goals worksheet",
      "Summer reading challenge tracker",
    ],
    stripeUrl: "",
    badge: null,
  },
  {
    id: "study-skills-toolkit",
    emoji: "🧠",
    title: "Study Skills Toolkit",
    grades: "Grades 4–8",
    price: "$12",
    description: "Note-taking templates, study schedule, and project planner — the tools kids need to study smarter, not longer.",
    features: [
      "Cornell note-taking template",
      "Weekly study schedule",
      "Multi-subject project planner",
      "Exam prep checklist",
      "Vocabulary study cards (printable)",
    ],
    stripeUrl: "",
    badge: "Most popular",
  },
  {
    id: "creative-writing-jumpstart",
    emoji: "✏️",
    title: "Creative Writing Jumpstart",
    grades: "Grades 2–6",
    price: "$9",
    description: "30 story starter prompts, a character sheet, and a plot organizer. Gets kids writing in minutes — even the ones who say they have nothing to write about.",
    features: [
      "30 age-appropriate story starters",
      "Character profile sheet",
      "Story plot organizer",
      "My Favorite Story mini-book template",
    ],
    stripeUrl: "",
    badge: null,
  },
  {
    id: "k8-complete-learning-pack",
    emoji: "🎒",
    title: "K–8 Complete Learning Pack",
    grades: "K–8",
    price: "$29",
    description: "Every product above in one download — morning routine, homework planner, reading log, study skills, and creative writing. Everything a K–8 student needs, ready to print.",
    features: [
      "Morning Routine Chart",
      "Homework Planner Pack",
      "Reading Log Bundle",
      "Study Skills Toolkit",
      "Creative Writing Jumpstart",
      "Lifetime access + future additions",
    ],
    stripeUrl: "",
    badge: "Best value",
  },
];

function orderUrl(product: typeof PRODUCTS[0]) {
  if (product.stripeUrl) return { href: product.stripeUrl, external: true };
  const subject = encodeURIComponent(`Order: ${product.title}`);
  const body = encodeURIComponent(
    `Hi,\n\nI'd like to order the ${product.title} (${product.price}).\n\nPlease send payment details and the download link.\n\nThanks,\n`
  );
  return { href: `mailto:${BUZZYFLY_CONFIG.orderEmail}?subject=${subject}&body=${body}`, external: false };
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Digital Products for Kids K–8 — ${BUZZYFLY_CONFIG.brandName}`}
      description="Printable planners, trackers, and activity packs for K–8 students. Homework planners, reading logs, study skills toolkits, and more — instant download, print at home."
    />
  </head>
  <body>
    <Header />
    <main>
      <section class="page-hero">
        <p class="eyebrow">Printable digital products for kids</p>
        <h1>The tools that make school less chaotic.</h1>
        <p class="lede">
          Homework planners, reading logs, study skill templates, and morning routine charts —
          designed for K–8 students, ready to print the same day you buy them.
        </p>
      </section>

      <section class="products-grid">
        {PRODUCTS.map((product) => {
          const order = orderUrl(product);
          return (
            <div class={`product-card${product.badge === "Most popular" ? " product-card--featured" : ""}`}>
              {product.badge && (
                <div class={`product-badge${product.badge === "Best value" ? " product-badge--value" : ""}`}>
                  {product.badge}
                </div>
              )}
              <div class="product-emoji">{product.emoji}</div>
              <div class="product-card__body">
                <p class="product-card__grades">{product.grades}</p>
                <h2 class="product-card__title">{product.title}</h2>
                <p class="product-card__price">{product.price}</p>
                <p class="product-card__description">{product.description}</p>
                <ul class="product-card__features">
                  {product.features.map((f) => <li>{f}</li>)}
                </ul>
              </div>
              <div class="product-card__footer">
                <a
                  class="product-cta"
                  href={order.href}
                  {...(order.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                >
                  Get {product.title} — {product.price}
                </a>
                <p class="product-microcopy">One-time payment. Instant PDF download.</p>
              </div>
            </div>
          );
        })}
      </section>

      <section class="how-it-works">
        <h2>How it works</h2>
        <ol class="steps">
          <li>
            <span class="step-num">1</span>
            <strong>Buy</strong>
            <p>Secure checkout — one-time payment, no subscription.</p>
          </li>
          <li>
            <span class="step-num">2</span>
            <strong>Download</strong>
            <p>Get your PDF instantly. Save it, print it as many times as you need.</p>
          </li>
          <li>
            <span class="step-num">3</span>
            <strong>Use it</strong>
            <p>Print, fill in, and repeat — designed to work all year long.</p>
          </li>
        </ol>
      </section>

      <section class="guarantee">
        <div class="guarantee__badge">30-day guarantee</div>
        <h2>If it doesn't work for your kid, you get your money back.</h2>
        <p>
          Use it for 30 days. If it's not a fit — email
          <a href={`mailto:${BUZZYFLY_CONFIG.orderEmail}`}>{BUZZYFLY_CONFIG.orderEmail}</a>
          and you get a full refund. No form, no questions.
        </p>
      </section>

      <EmailOptin
        title="Get a free sample pack"
        description="Drop your email and we'll send you a free printable homework tracker — no signup wall, no spam, just the PDF."
        buttonLabel="Send me the free tracker"
      />
    </main>
    <Footer />
  </body>
</html>

<style>
  :root {
    --kids-accent: #7c3aed;
    --kids-accent-dark: #5b21b6;
    --kids-green: #1a7a3c;
  }

  .page-hero {
    text-align: center;
    padding: 2.5em 1em 1.5em;
    max-width: 640px;
    margin: 0 auto;
  }
  .eyebrow {
    font-size: 0.8em;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: rgb(var(--gray));
    margin: 0 0 0.6em;
  }
  .page-hero h1 {
    font-size: clamp(1.6em, 4vw, 2.4em);
    margin: 0 0 0.5em;
    line-height: 1.2;
  }
  .lede {
    color: rgb(var(--gray-dark));
    line-height: 1.65;
    margin: 0;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
    gap: 1.5em;
    max-width: 1100px;
    margin: 2.5em auto;
    padding: 0 1em;
  }

  .product-card {
    border: 1px solid rgb(var(--gray-light));
    border-radius: 14px;
    background: rgb(var(--base, 255 255 255));
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }
  .product-card--featured {
    border-color: var(--kids-accent);
    box-shadow: 0 0 0 2px var(--kids-accent);
  }
  .product-badge {
    background: var(--kids-accent);
    color: #fff;
    font-size: 0.72em;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.35em 1em;
    text-align: center;
  }
  .product-badge--value { background: var(--kids-green); }
  .product-emoji {
    font-size: 2.4em;
    margin: 0.6em 0 0.2em;
    text-align: center;
  }
  .product-card__body {
    padding: 0.5em 1.5em 1em;
    flex: 1;
  }
  .product-card__title {
    font-size: 1.1em;
    margin: 0 0 0.2em;
    color: rgb(var(--black));
  }
  .product-card__grades {
    font-size: 0.78em;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--kids-accent);
    margin: 0 0 0.5em;
  }
  .product-card__price {
    font-size: 1.8em;
    font-weight: 700;
    color: rgb(var(--black));
    margin: 0 0 0.6em;
  }
  .product-card__description {
    font-size: 0.92em;
    color: rgb(var(--gray-dark));
    line-height: 1.6;
    margin: 0 0 1em;
  }
  .product-card__features {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .product-card__features li {
    font-size: 0.87em;
    color: rgb(var(--gray-dark));
    padding: 0.3em 0 0.3em 1.4em;
    position: relative;
    border-bottom: 1px solid rgb(var(--gray-light));
  }
  .product-card__features li:last-child { border-bottom: none; }
  .product-card__features li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--kids-green);
    font-weight: 700;
  }
  .product-card__footer { padding: 1em 1.5em 1.5em; }
  .product-cta {
    display: block;
    text-align: center;
    padding: 0.75em 1em;
    border-radius: 999px;
    background: var(--kids-accent);
    color: #fff;
    font-weight: 700;
    font-size: 0.95em;
    text-decoration: none;
    transition: background-color 0.15s;
  }
  .product-cta:hover { background: var(--kids-accent-dark); color: #fff; }
  .product-microcopy {
    font-size: 0.75em;
    color: rgb(var(--gray));
    text-align: center;
    margin: 0.6em 0 0;
  }

  .how-it-works {
    max-width: 700px;
    margin: 0 auto 3em;
    padding: 0 1em;
  }
  .how-it-works h2 { font-size: 1.4em; margin-bottom: 1em; text-align: center; }
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 1.2em;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .steps li {
    text-align: center;
    padding: 1.2em;
    border: 1px solid rgb(var(--gray-light));
    border-radius: 12px;
  }
  .step-num {
    display: inline-block;
    width: 2em;
    height: 2em;
    line-height: 2em;
    border-radius: 50%;
    background: var(--kids-accent);
    color: #fff;
    font-weight: 700;
    font-size: 0.9em;
    margin-bottom: 0.5em;
  }
  .steps li p { font-size: 0.9em; color: rgb(var(--gray-dark)); margin: 0.3em 0 0; }

  .guarantee {
    max-width: 600px;
    margin: 0 auto 3em;
    padding: 1.75em;
    border: 2px solid var(--kids-green);
    border-radius: 14px;
    background: rgba(26, 122, 60, 0.04);
    text-align: center;
  }
  .guarantee__badge {
    display: inline-block;
    padding: 0.3em 0.85em;
    border-radius: 999px;
    background: var(--kids-green);
    color: #fff;
    font-size: 0.78em;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 0.75em;
  }
  .guarantee h2 { font-size: 1.3em; margin: 0 0 0.5em; }
  .guarantee p { color: rgb(var(--gray-dark)); line-height: 1.65; margin: 0; }
</style>
