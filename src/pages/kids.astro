---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
export const prerender = true;
---
<!doctype html>
<html lang="en">
<head>
	<BaseHead title="Kids Club — Buzzy Lands" description="Retro platformer. Run, jump, grab nectar, stomp wasps, reach the hive." image="/kids/buzzy-buddy.jpg" />
</head>
<body class="kids-page">
	<Header />
	<main class="kids">
		<section class="meet">
			<img class="buddy" src="/kids/buzzy-buddy.jpg" width="640" height="640" alt="Buzzy" />
			<div class="hello">
				<p class="eyebrow">Kids Club</p>
				<h1>Buzzy Lands</h1>
				<p class="lede">Old-school platformer. Run the garden ledges, jump the gaps, grab every nectar drop, stomp the wasps, tag the hive.</p>
				<a class="go" href="#play">Play Buzzy Lands</a>
			</div>
		</section>
		<section id="play" class="cabinet">
			<div class="stage">
				<canvas id="buzzy-kids" width="960" height="540"></canvas>
				<div id="kids-overlay" class="overlay">
					<img src="/kids/buzzy-face.jpg" width="88" height="88" alt="" class="face" />
					<p class="overlay-kicker">Retro platform</p>
					<h2>Buzzy Lands</h2>
					<p>Left / Right to run. Jump. Get the nectar. Hit the hive.</p>
					<button id="kids-start" type="button">Start</button>
				</div>
			</div>
			<div class="hud-hint">
				<p><strong>Phone:</strong> on-screen Left · Jump · Right</p>
				<p><strong>Keys:</strong> A D or arrows + Space / Up</p>
			</div>
		</section>
		<p class="parents">Grown-ups: shop is on the <a href="/">main site</a>.</p>
	</main>
	<Footer />
	<script src="/kids/nectar-rush.js?v=plat1" defer></script>
</body>
</html>
<style>
.kids-page { background: #f6efe3; }
.kids { width: min(1100px, calc(100% - 2em)); margin: 0 auto; padding: 1.5em 0 4em; }
.meet { display: grid; grid-template-columns: minmax(0,.9fr) minmax(0,1.1fr); gap: 1.75em; align-items: center; margin-bottom: 2em; }
.buddy { width: 100%; border-radius: 28px; }
.eyebrow { margin: 0 0 .4em; font-size: .8em; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #2c5e4a; }
.hello h1 { font-size: clamp(2rem,5vw,3.2rem); margin: 0 0 .4em; }
.lede { font-size: 1.15em; color: #3d372f; }
.go { display: inline-block; margin-top: .4em; padding: .75em 1.4em; border-radius: 999px; background: #2c5e4a; color: #fff8e7 !important; font-weight: 700; text-decoration: none; }
.stage { position: relative; border-radius: 20px; overflow: hidden; background: #4aa3d8; box-shadow: 0 16px 36px rgba(42,36,28,.16); }
#buzzy-kids { display: block; width: 100%; height: auto; touch-action: none; }
.overlay { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 1.5em; background: rgba(246,239,227,.9); }
.overlay[hidden] { display: none; }
.face { width: 88px; height: 88px; border-radius: 50%; object-fit: cover; margin-bottom: .6em; }
.overlay-kicker { margin: 0; font-size: .8em; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #2c5e4a; }
.overlay button { padding: .8em 1.5em; border: 0; border-radius: 999px; background: #e8a317; font-weight: 700; font-size: 1.1em; min-height: 48px; cursor: pointer; }
.hud-hint { display: flex; gap: 1.5em; flex-wrap: wrap; margin: .8em 0 0; color: #5c5348; }
.parents { margin: 1.5em 0 0; font-size: .9em; color: #5c5348; }
@media (max-width: 760px) { .meet { grid-template-columns: 1fr; } }
</style>
