---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Kids Club — Flower Pop with Buzzy"
			description="Tap blooming flowers. Do not tap wasps. Fast garden game for kids."
			image="/kids/buzzy-buddy.jpg"
		/>
	</head>
	<body class="kids-page">
		<Header />
		<main class="kids">
			<section class="meet">
				<img class="buddy" src="/kids/buzzy-buddy.jpg" width="640" height="640" alt="Buzzy the cream cartoon fly waving in a flower garden" />
				<div class="hello">
					<p class="eyebrow">Kids Club</p>
					<h1>Hi. I’m Buzzy.<br />Pop the flowers.</h1>
					<p class="lede">Flowers pop up. Tap them. Wasps are mean — don’t tap those. Golden blooms are bonus. That’s the whole game.</p>
					<a class="go" href="#play">Play Flower Pop</a>
				</div>
			</section>
			<section id="play" class="cabinet" aria-label="Flower Pop">
				<div class="stage">
					<canvas id="buzzy-kids" width="960" height="540"></canvas>
					<div id="kids-overlay" class="overlay">
						<img src="/kids/buzzy-face.jpg" width="88" height="88" alt="" class="face" />
						<p class="overlay-kicker">New game</p>
						<h2>Flower Pop</h2>
						<p>Tap flowers. Skip wasps. Golden = extra points.</p>
						<button id="kids-start" type="button">Pop ’em!</button>
					</div>
				</div>
				<div class="hud-hint">
					<p><strong>Phone:</strong> tap the blooms</p>
					<p><strong>Skip:</strong> the stripy wasps</p>
				</div>
			</section>
			<p class="parents">Grown-ups: shop is on the <a href="/">main site</a>.</p>
		</main>
		<Footer />
		<script src="/kids/nectar-rush.js?v=pop3" defer></script>
	</body>
</html>
<style>
	.kids-page { background: #f6efe3; }
	.kids { width: min(1100px, calc(100% - 2em)); max-width: 1100px; margin: 0 auto; padding: 1.5em 0 4em; }
	.meet { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 1.75em; align-items: center; margin-bottom: 2.5em; }
	.buddy { width: 100%; border-radius: 28px; box-shadow: 0 18px 40px rgba(42, 36, 28, 0.18); }
	.eyebrow { margin: 0 0 0.4em; font-size: 0.8em; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #2c5e4a; }
	.hello h1 { font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1.05; margin: 0 0 0.5em; }
	.lede { font-size: 1.15em; color: #3d372f; max-width: 32em; }
	.go { display: inline-block; margin-top: 0.4em; padding: 0.75em 1.4em; border-radius: 999px; background: #2c5e4a; color: #fff8e7 !important; font-weight: 700; text-decoration: none; }
	.cabinet { margin: 0 0 2em; }
	.stage { position: relative; border-radius: 20px; overflow: hidden; background: #8ec5e8; box-shadow: 0 16px 36px rgba(42, 36, 28, 0.16); }
	#buzzy-kids { display: block; width: 100%; height: auto; touch-action: manipulation; }
	.overlay { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 1.5em; background: rgba(246, 239, 227, 0.88); }
	.overlay[hidden] { display: none; }
	.face { width: 88px; height: 88px; border-radius: 50%; object-fit: cover; margin-bottom: 0.6em; }
	.overlay-kicker { margin: 0; font-size: 0.8em; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #2c5e4a; }
	.overlay h2 { margin: 0.2em 0 0.3em; font-size: 1.8em; }
	.overlay button { padding: 0.8em 1.5em; border: 0; border-radius: 999px; background: #e8a317; color: #1a1612; font-weight: 700; font-size: 1.1em; cursor: pointer; min-height: 48px; }
	.hud-hint { display: flex; gap: 1.5em; flex-wrap: wrap; margin: 0.8em 0 0; color: #5c5348; }
	.parents { margin: 1.5em 0 0; font-size: 0.9em; color: #5c5348; }
	@media (max-width: 760px) { .meet { grid-template-columns: 1fr; } }
</style>
