---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EmailOptin from '../../components/EmailOptin.astro';
import ProductCallout from '../../components/ProductCallout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { BUZZYFLY_CONFIG } from '../../data/monetization';

export const prerender = false;

const brandHero = '/buzzyfly-brand-about.svg';
function cardImage(src?: string) {
	if (!src) return brandHero;
	if (src.includes('blog-placeholder') || src.includes('buzzyfly-brand-about.jpg')) return brandHero;
	return src;
}

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const categories = [...new Set(allPosts.map((p) => p.data.category).filter(Boolean))];
const activeCategory = Astro.url.searchParams.get('category');

const posts = activeCategory
	? allPosts.filter((p) => p.data.category === activeCategory)
	: allPosts;

const featured = posts[0];
const rest = posts.slice(1);

const categoryCounts = allPosts.reduce<Record<string, number>>((acc, p) => {
	const c = p.data.category;
	if (c) acc[c] = (acc[c] ?? 0) + 1;
	return acc;
}, {});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.blog-page { width: var(--max-width); padding-bottom: var(--space-8); }
			.blog-hero { margin: var(--space-4) 0 var(--space-4); }
			.blog-hero h1 { font-size: clamp(2.1em, 7vw, 3.4em); line-height: 1.04; margin: 0 0 var(--space-2); }
			.blog-hero p { max-width: 36em; margin: 0; color: rgb(var(--gray-dark)); font-size: 1.05em; }
			.cat-bar { display: flex; flex-wrap: wrap; gap: var(--space-1); margin: 0 0 var(--space-6); }
			.cat-pill { display: inline-flex; align-items: center; min-height: 44px; box-sizing: border-box; padding: 0 var(--space-2); border-radius: 999px; border: 1px solid var(--line-strong); text-decoration: none; color: var(--muted); font-size: 0.8em; font-weight: 600; }
			.cat-pill:hover { color: var(--ink); border-color: var(--ink); }
			.cat-pill.active { background: var(--ink); color: var(--bg); border-color: var(--ink); }
			.featured { display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--space-4); align-items: center; padding: var(--space-3); border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--surface); margin-bottom: var(--space-4); }
			.featured img { width: 100%; border-radius: 8px; }
			.tag { display: inline-block; font-size: 0.75em; font-weight: 600; color: var(--muted); margin-bottom: var(--space-1); }
			.featured h2 { margin: 0 0 var(--space-1); font-size: clamp(1.4em, 4vw, 1.9em); }
			.featured h2 a, .card h3 a { color: var(--ink); text-decoration: none; }
			.featured h2 a:hover, .card h3 a:hover { text-decoration: underline; }
			.featured p { color: rgb(var(--gray-dark)); margin: 0 0 var(--space-2); }
			.meta { font-size: 0.8em; color: var(--muted); }
			/* Two columns at most. */
			.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr)); gap: var(--space-2); }
			@media (min-width: 1000px) { .grid { grid-template-columns: 1fr 1fr; } }
			.card { border: 1px solid var(--line); border-radius: var(--radius-card); overflow: hidden; background: var(--surface); display: flex; flex-direction: column; transition: border-color 0.15s ease; }
			.card:hover { border-color: var(--line-strong); }
			.card img { width: 100%; height: 180px; object-fit: cover; border-radius: 0; }
			.card-body { padding: var(--space-3); display: flex; flex-direction: column; flex: 1; }
			.card .tag { margin-bottom: 0; }
			.card h3 { margin: 4px 0 var(--space-1); font-size: 1.15em; }
			.card p { margin: 0 0 var(--space-1); color: rgb(var(--gray-dark)); font-size: 0.9em; flex: 1; }
			.read { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; font-size: 0.85em; color: var(--ink); }
			.sticky-cta { position: fixed; bottom: 0; left: 0; right: 0; background: var(--surface); border-top: 1px solid var(--line); padding: var(--space-1) var(--gutter); display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); z-index: 50; font-size: 0.85em; color: rgb(var(--gray-dark)); }
			.sticky-cta .price { font-family: var(--font-display); font-weight: 800; color: var(--ink); margin-left: auto; }
			body { padding-bottom: 72px; }
			@media (max-width: 760px) {
				.featured { grid-template-columns: 1fr; }
				.sticky-cta span:first-child { display: none; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="blog-page">
			<section class="blog-hero">
				<h1>The Buzzyfly Notebook</h1>
				<p>Real workflows, checklists, and the ugly truths about running a one-person business — written so you stop rebuilding everything from memory.</p>
			</section>

			{
				categories.length > 0 && (
					<nav class="cat-bar" aria-label="Categories">
						<a class:list={["cat-pill", { active: !activeCategory }]} href="/blog">All ({allPosts.length})</a>
						{categories.map((c) => (
							<a class:list={["cat-pill", { active: activeCategory === c }]} href={`/blog?category=${encodeURIComponent(c)}`}>{c} ({categoryCounts[c] ?? 0})</a>
						))}
					</nav>
				)
			}

			{
				featured && (
					<article class="featured">
						<img src={cardImage(featured.data.heroImage)} alt="" width={640} height={360} />
						<div>
							{featured.data.category && <span class="tag">{featured.data.category}</span>}
							<h2><a href={`/blog/${featured.id}/`}>{featured.data.title}</a></h2>
							<p>{featured.data.description}</p>
							<p class="meta"><FormattedDate date={featured.data.pubDate} /></p>
							<a class="read" href={`/blog/${featured.id}/`}>Read it →</a>
						</div>
					</article>
				)
			}

			<section class="grid">
				{
					rest.map((post) => (
						<article class="card">
							<img src={cardImage(post.data.heroImage)} alt="" width={400} height={200} />
							<div class="card-body">
								{post.data.category && <span class="tag">{post.data.category}</span>}
								<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
								<p>{post.data.description}</p>
								<p class="meta"><FormattedDate date={post.data.pubDate} /></p>
								<a class="read" href={`/blog/${post.id}/`}>Read →</a>
							</div>
						</article>
					))
				}
			</section>

			<ProductCallout />
			<EmailOptin />
		</main>
		<Footer />
		<div class="sticky-cta">
			<span>Stop rebuilding onboarding from memory.</span>
			<span class="price">{BUZZYFLY_CONFIG.defaultProductPrice}</span>
			<a class="btn-primary" href="/store">Get the Digital System</a>
		</div>
	</body>
</html>
