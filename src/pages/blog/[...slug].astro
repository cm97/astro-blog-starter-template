---
import { type CollectionEntry, getCollection, getEntryBySlug } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { render } from 'astro:content';

export const prerender = false;

export async function getStaticPaths() {
	return [];
}

const slug = Astro.params.slug;
const post = slug ? await getEntryBySlug('blog', slug) : undefined;

if (!post) {
	return Astro.redirect('/blog');
}

const { Content } = await render(post);

const all = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const idx = all.findIndex((p) => p.id === post.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;
const related = all
	.filter((p) => p.id !== post.id && p.data.category && p.data.category === post.data.category)
	.slice(0, 3);
---

<BlogPost {...post.data} prev={prev} next={next} related={related} currentId={post.id}>
	<Content />
</BlogPost>
