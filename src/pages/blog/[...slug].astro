---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

// Bake every essay at deploy time. Request-time SSR was 500ing on Read
// (Astro 5 dropped getEntryBySlug; worker render of the collection is also
// a timeout risk). Static HTML cannot 500 the way the old page did.
export const prerender = true;

export async function getStaticPaths() {
	// getStaticPaths runs on its own, so its helpers live inside it.
	// Words too common to say two posts are about the same thing.
	const STOP = new Set(['the', 'a', 'an', 'and', 'or', 'to', 'of', 'for', 'in', 'on', 'that', 'this', 'your', 'you', 'when', 'with', 'exact', 'reply', 'send', 'how', 'what', 'why', 'it', 'is', 'are', 'without', 'just']);
	const words = (p: CollectionEntry<'blog'>) =>
		new Set(`${p.id} ${p.data.title}`.toLowerCase().split(/[^a-z0-9]+/).filter((w) => w.length > 2 && !STOP.has(w)));

	// Three related posts for internal linking: same category first, then the
	// posts that share the most topic words, so no post ends without links.
	function relatedPosts(post: CollectionEntry<'blog'>, all: CollectionEntry<'blog'>[]) {
		const mine = words(post);
		return all
			.filter((p) => p.id !== post.id)
			.map((p) => {
				let score = 0;
				for (const w of words(p)) if (mine.has(w)) score += 1;
				if (post.data.category && p.data.category === post.data.category) score += 2;
				return { p, score };
			})
			.filter((x) => x.score > 0)
			.sort((a, b) => b.score - a.score)
			.slice(0, 3)
			.map((x) => x.p);
	}

	const all = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);

	return all.map((post, idx) => ({
		params: { slug: post.id },
		props: {
			post,
			prev: idx > 0 ? all[idx - 1] : null,
			next: idx < all.length - 1 ? all[idx + 1] : null,
			related: relatedPosts(post, all),
		},
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
	prev: CollectionEntry<'blog'> | null;
	next: CollectionEntry<'blog'> | null;
	related: CollectionEntry<'blog'>[];
}

const { post, prev, next, related } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} prev={prev} next={next} related={related} currentId={post.id}>
	<Content />
</BlogPost>
