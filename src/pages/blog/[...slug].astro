---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

// Bake every essay at deploy time. Request-time SSR was 500ing on Read
// (Astro 5 dropped getEntryBySlug; worker render of the collection is also
// a timeout risk). Static HTML cannot 500 the way the old page did.
export const prerender = true;

export async function getStaticPaths() {
	const all = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);

	// Drafts get a page (see `draft` in content.config.ts) but never appear in
	// another post's prev/next or related links.
	const published = all.filter((p) => !p.data.draft);

	return all.map((post) => {
		const idx = published.indexOf(post);
		return {
			params: { slug: post.id },
			props: {
				post,
				prev: idx > 0 ? published[idx - 1] : null,
				next: idx >= 0 && idx < published.length - 1 ? published[idx + 1] : null,
				related: published
					.filter((p) => p.id !== post.id && p.data.category && p.data.category === post.data.category)
					.slice(0, 3),
			},
		};
	});
}

interface Props {
	post: CollectionEntry<'blog'>;
	prev: CollectionEntry<'blog'> | null;
	next: CollectionEntry<'blog'> | null;
	related: CollectionEntry<'blog'>[];
}

const { post, prev, next, related } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} prev={prev} next={next} related={related} currentId={post.id}>
	<Content />
</BlogPost>
