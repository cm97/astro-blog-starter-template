---
import { getCollection, getEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export const prerender = false;

const raw = Astro.params.slug;
const id = decodeURIComponent(String(raw ?? '')).replace(/\/+$/, '');

let post = id ? await getEntry('blog', id) : undefined;
if (!post && id) {
	const allPosts = await getCollection('blog');
	post = allPosts.find((p) => p.id === id || p.id.endsWith(`/${id}`));
}

if (!post) {
	return Astro.redirect('/blog');
}

const { Content } = await render(post);

const all = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const idx = all.findIndex((p) => p.id === post.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null;
const related = all
	.filter((p) => p.id !== post.id && p.data.category && p.data.category === post.data.category)
	.slice(0, 3);
---

<BlogPost {...post.data} prev={prev} next={next} related={related} currentId={post.id}>
	<Content />
</BlogPost>
