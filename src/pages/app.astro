---
// src/pages/app.astro
const pageTitle = "Buzzyfly Workspace";
---
<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#090d16" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans select-none antialiased">
    <!-- Header -->
    <header class="sticky top-0 z-40 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 px-4 py-3 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center font-bold text-white text-base shadow-sm">
          B
        </div>
        <div>
          <h1 class="text-sm font-semibold tracking-tight text-white leading-none">Buzzyfly</h1>
          <span class="text-[11px] text-emerald-400 font-medium">Workspace Active</span>
        </div>
      </div>
      <button class="p-2 text-slate-400 hover:text-white rounded-lg active:bg-slate-800" aria-label="Notifications">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>
      </button>
    </header>

    <!-- Workspace Main -->
    <main class="flex-1 p-4 pb-24 overflow-y-auto max-w-lg mx-auto w-full space-y-4">
      <section class="p-4 rounded-2xl bg-gradient-to-br from-indigo-900/40 via-slate-900 to-slate-900 border border-indigo-500/20 shadow-lg">
        <p class="text-xs uppercase tracking-wider text-indigo-400 font-semibold mb-1">Operational Hub</p>
        <h2 class="text-lg font-bold text-white">Automation Engine & Workspaces</h2>
        <p class="text-xs text-slate-400 mt-1">Manage cloud workflows, operational templates, and active integrations.</p>
      </section>

      <section class="grid grid-cols-2 gap-3">
        <button class="flex flex-col items-start p-4 rounded-xl bg-slate-900 border border-slate-800 active:scale-[0.98] transition-transform">
          <div class="w-9 h-9 rounded-lg bg-indigo-500/10 text-indigo-400 flex items-center justify-center mb-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <span class="text-sm font-semibold text-white">Automations</span>
          <span class="text-[11px] text-slate-400">Manage jobs</span>
        </button>

        <button class="flex flex-col items-start p-4 rounded-xl bg-slate-900 border border-slate-800 active:scale-[0.98] transition-transform">
          <div class="w-9 h-9 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <span class="text-sm font-semibold text-white">Templates</span>
          <span class="text-[11px] text-slate-400">Library & docs</span>
        </button>

        <button class="flex flex-col items-start p-4 rounded-xl bg-slate-900 border border-slate-800 active:scale-[0.98] transition-transform">
          <div class="w-9 h-9 rounded-lg bg-sky-500/10 text-sky-400 flex items-center justify-center mb-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7c0-2-1-3-3-3H7C5 4 4 5 4 7z" />
            </svg>
          </div>
          <span class="text-sm font-semibold text-white">Cloud Storage</span>
          <span class="text-[11px] text-slate-400">D1 & R2 files</span>
        </button>

        <button class="flex flex-col items-start p-4 rounded-xl bg-slate-900 border border-slate-800 active:scale-[0.98] transition-transform">
          <div class="w-9 h-9 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center mb-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            </svg>
          </div>
          <span class="text-sm font-semibold text-white">Settings</span>
          <span class="text-[11px] text-slate-400">Profiles & keys</span>
        </button>
      </section>
    </main>

    <!-- Bottom Navigation -->
    <nav class="fixed bottom-0 left-0 right-0 z-40 bg-slate-900/95 backdrop-blur-lg border-t border-slate-800 px-6 py-2 flex items-center justify-around max-w-lg mx-auto">
      <a href="/app" class="flex flex-col items-center text-indigo-400">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
        </svg>
        <span class="text-[10px] font-medium mt-1">Dashboard</span>
      </a>

      <button class="flex flex-col items-center text-slate-400 hover:text-white">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
        </svg>
        <span class="text-[10px] font-medium mt-1">Activity</span>
      </button>

      <button class="flex flex-col items-center text-slate-400 hover:text-white">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span class="text-[10px] font-medium mt-1">Account</span>
      </button>
    </nav>
  </body>
</html>
