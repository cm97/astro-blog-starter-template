---
// src/pages/app.astro — Buzzyfly Digital System browser app
const pageTitle = "Buzzyfly Today";
---
<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="theme-color" content="#090d16" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans antialiased">
    <header class="sticky top-0 z-40 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 px-4 py-3 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center font-bold text-white text-base">B</div>
        <div>
          <h1 class="text-sm font-semibold tracking-tight text-white leading-none">Buzzyfly</h1>
          <span class="text-[11px] text-emerald-400 font-medium">Today</span>
        </div>
      </div>
    </header>

    <main class="flex-1 p-4 pb-24 max-w-lg mx-auto w-full space-y-4">
      <section class="p-4 rounded-2xl bg-gradient-to-br from-indigo-900/40 via-slate-900 to-slate-900 border border-indigo-500/20">
        <p class="text-xs uppercase tracking-wider text-indigo-400 font-semibold mb-1">Today</p>
        <h2 class="text-lg font-bold text-white">Who needs you and what to send</h2>
        <p class="text-xs text-slate-400 mt-1">No download. No Excel. Open this on your phone.</p>
      </section>

      <section class="space-y-3">
        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
          <p class="text-xs text-amber-400 font-medium mb-1">Follow-up due</p>
          <p class="text-sm font-semibold text-white">Alex — proposal sent 3 days ago</p>
          <p class="text-xs text-slate-400 mt-1 mb-2">Send this:</p>
          <pre class="text-xs bg-slate-950 p-2 rounded overflow-x-auto">Hi Alex — the proposal for [service] is still the one I sent [date]. One question: is [start date] still the date, or did it move?</pre>
          <button class="mt-2 text-xs text-indigo-400">Copy email</button>
        </div>

        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
          <p class="text-xs text-emerald-400 font-medium mb-1">New client onboarding</p>
          <p class="text-sm font-semibold text-white">Jordan — YES received yesterday</p>
          <p class="text-xs text-slate-400 mt-1">Send intake + kickoff note today.</p>
        </div>

        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
          <p class="text-xs text-sky-400 font-medium mb-1">Monday reset</p>
          <p class="text-sm font-semibold text-white">20-minute clear + 3 priorities</p>
          <ol class="text-xs text-slate-400 mt-1 list-decimal list-inside space-y-1">
            <li>Clear anything under 2 minutes</li>
            <li>Write three priorities</li>
            <li>List who is waiting on you</li>
          </ol>
        </div>
      </section>
    </main>

    <nav class="fixed bottom-0 left-0 right-0 z-40 bg-slate-900/95 backdrop-blur-lg border-t border-slate-800 px-6 py-2 flex items-center justify-around max-w-lg mx-auto">
      <a href="/app" class="flex flex-col items-center text-indigo-400">
        <span class="text-[10px] font-medium mt-1">Today</span>
      </a>
      <a href="/store" class="flex flex-col items-center text-slate-400">
        <span class="text-[10px] font-medium mt-1">Store</span>
      </a>
    </nav>
  </body>
</html>
