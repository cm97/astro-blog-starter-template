---
// The Digital System web app. Buyers only: the server checks the access key
// (from the thank-you page or the delivery email) before rendering the app.
import AppShell from "../components/AppShell.astro";
import { APP_ITEM_ID, resolveAppAccess } from "../lib/appAccess";

export const prerender = false;
Astro.response.headers.set("cache-control", "private, no-store");

const access = await resolveAppAccess(Astro.locals.runtime.env, Astro.url, Astro.cookies, APP_ITEM_ID);
if (access.redirect) return Astro.redirect(access.redirect, 302);
if (!access.unlocked) Astro.response.status = 402;

const NAV = [
	{ id: "today", label: "Today", icon: "☀️" },
	{ id: "clients", label: "Clients", icon: "👥" },
	{ id: "emails", label: "Emails", icon: "✉️" },
	{ id: "reset", label: "Reset", icon: "🔁" },
	{ id: "pricing", label: "Pricing", icon: "💲" },
	{ id: "settings", label: "More", icon: "⚙️" },
];
---
<AppShell itemId={APP_ITEM_ID} unlocked={access.unlocked} badLink={access.badLink} edition="system" nav={NAV} appName="Today" />
