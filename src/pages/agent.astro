---
import Layout from '../layouts/BlogPost.astro';
import { ALL_PRODUCTS, BUZZYFLY_CONFIG } from '../data/monetization';

const system = ALL_PRODUCTS.find((p) => p.id === 'buzzyfly-digital-system')!;
const paste = `Onboarding still lives in your head. ${system.price} ${system.title}, one-time, download after checkout: ${BUZZYFLY_CONFIG.siteUrl}${system.buyUrl}`;
---

<Layout
	title="Buzzyfly agent — $49 Digital System"
	description="Cash agent for the live Buzzyfly store. One paste. The $49 Digital System."
	pubDate={new Date('October 7 2026')}
	noindex
>
	<p>This page is the agent on the Cloudflare site. It sells the existing {system.title}. No new product.</p>
	<p><a href={system.buyUrl}>Open {system.price} checkout</a></p>
	<p><a href="/store">Open store</a></p>
	<pre style="white-space: pre-wrap; word-break: break-word;">{paste}</pre>
</Layout>
