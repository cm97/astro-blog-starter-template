---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export const prerender = true;

// Only the $49 Digital System is for sale (owner rule 5), so the kids pack is "Coming soon" with no order path.
const CONTACT = "support@buzzyfly.com";

const ITEMS = [
	{ title: "Morning Routine Chart", grades: "K–3" },
	{ title: "Homework Planner Pack", grades: "2–8" },
	{ title: "Reading Log Bundle", grades: "1–5" },
	{ title: "Study Skills Toolkit", grades: "4–8" },
	{ title: "Creative Writing Jumpstart", grades: "2–6" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Kids Course — K–8 Learning Pack (coming soon) | Buzzyfly"
			description="Printable K–8 routines: morning chart, homework planner, reading log, study skills, writing jumpstart. Coming soon."
			image="/kids/buzzy-buddy.jpg"
		/>
	</head>
	<body>
		<Header />
		<main class="course">
			<p class="eyebrow">Parents · K–8 printables</p>
			<h1>Kids Course — the K–8 pack</h1>
			<p class="lede">
				Morning routine, homework planner, reading log, study skills, and writing jumpstart.
				Print at home.
			</p>
			<p class="price">Coming soon</p>
			<p class="micro">Not for sale yet. Questions: <a href={`mailto:${CONTACT}`}>{CONTACT}</a>.</p>

			<h2>What will be in the pack</h2>
			<ul class="grid">
				{
					ITEMS.map((item) => (
						<li>
							<strong>{item.title}</strong>
							<span>Grades {item.grades}</span>
						</li>
					))
				}
			</ul>
			<p class="note">The Buzzy Lands game stays free at <a href="/buzzy-lands">/buzzy-lands</a>.</p>
		</main>
		<Footer />
	</body>
</html>
<style>
	.course { width: min(720px, calc(100% - 2em)); margin: 0 auto; padding: 2em 0 4em; }
	.eyebrow { margin: 0 0 0.4em; font-size: 0.8em; letter-spacing: 0.08em; text-transform: uppercase; color: #2c5e4a; font-weight: 700; }
	h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 0 0 0.4em; }
	.lede { color: rgb(var(--gray-dark)); max-width: 36em; }
	.price { font-size: 2.2em; font-weight: 700; margin: 0.4em 0; }
	.cta { display: inline-block; margin-top: 0.8em; padding: 0.75em 1.4em; border-radius: 999px; background: #2c5e4a; color: #fff !important; font-weight: 700; text-decoration: none; }
	.order { display: grid; gap: 0.4em; max-width: 28em; margin: 0.6em 0 0.4em; }
	.order input, .order select { font: inherit; padding: 0.55em 0.7em; border: 1px solid rgb(var(--gray-light)); border-radius: 10px; }
	.order button { justify-self: start; min-height: 48px; padding: 0.55em 1.2em; border: 0; border-radius: 999px; background: #2c5e4a; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
	.cta:hover { background: #1f4636; }
	.micro, .note { font-size: 0.9em; color: rgb(var(--gray)); }
	h2 { margin-top: 2em; }
	.grid { list-style: none; padding: 0; display: grid; gap: 0.8em; }
	.grid li { border: 1px solid rgb(var(--gray-light)); border-radius: 12px; padding: 0.9em 1em; display: grid; gap: 0.25em; }
	.grid span { color: rgb(var(--gray)); font-size: 0.92em; }
	.grid a { font-weight: 700; }
</style>
