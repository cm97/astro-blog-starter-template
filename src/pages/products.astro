---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import EmailOptin from "../components/EmailOptin.astro";
import { BUZZYFLY_CONFIG, ALL_PRODUCTS } from "../data/monetization";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`All Products — ${BUZZYFLY_CONFIG.brandName}`}
			description="Practical templates and systems for small business owners. Pick the one that solves your most urgent problem — or get everything in the bundle."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-hero">
				<p class="eyebrow">Digital products for small businesses</p>
				<h1>Pick the problem you want to solve first.</h1>
				<p class="lede">
					Every product is a standalone template you can run immediately.
					Buy one, buy all — no subscriptions, no fluff.
				</p>
			</section>

			<section class="products-grid">
				{ALL_PRODUCTS.map((product) => (
					<div class={`product-card${product.badge === "Most popular" ? " product-card--featured" : ""}`}>
						{product.badge && (
							<div class={`product-badge${product.badge === "Best value" ? " product-badge--value" : ""}`}>
								{product.badge}
							</div>
						)}
						<div class="product-card__body">
							<h2 class="product-card__title">{product.title}</h2>
							<p class="product-card__price">{product.price}</p>
							<p class="product-card__description">{product.description}</p>
							<ul class="product-card__features">
								{product.features.map((f) => <li>{f}</li>)}
							</ul>
						</div>
						<div class="product-card__footer">
							<a
								class="product-cta"
								href={product.stripeUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								Get {product.title} — {product.price}
							</a>
							<p class="product-microcopy">One-time payment. Secure checkout by Stripe.</p>
						</div>
					</div>
				))}
			</section>

			<section class="guarantee">
				<div class="guarantee__badge">30-day guarantee</div>
				<h2>Every product is covered by the same guarantee.</h2>
				<p>
					Use it for 30 days. If it doesn't help — email
					<a href={`mailto:${BUZZYFLY_CONFIG.orderEmail}`}>{BUZZYFLY_CONFIG.orderEmail}</a>
					and you get your money back. No form, no questions.
				</p>
			</section>

			<EmailOptin />
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-hero {
		text-align: center;
		padding: 2.5em 1em 1.5em;
		max-width: 640px;
		margin: 0 auto;
	}
	.eyebrow {
		font-size: 0.8em;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: rgb(var(--gray));
		margin: 0 0 0.6em;
	}
	.page-hero h1 {
		font-size: clamp(1.6em, 4vw, 2.4em);
		margin: 0 0 0.5em;
		line-height: 1.2;
	}
	.lede {
		color: rgb(var(--gray-dark));
		line-height: 1.65;
		margin: 0;
	}

	.products-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
		gap: 1.5em;
		max-width: 1100px;
		margin: 2.5em auto;
		padding: 0 1em;
	}

	.product-card {
		border: 1px solid rgb(var(--gray-light));
		border-radius: 14px;
		background: rgb(var(--base, 255 255 255));
		display: flex;
		flex-direction: column;
		position: relative;
		overflow: hidden;
	}
	.product-card--featured {
		border-color: var(--accent);
		box-shadow: 0 0 0 2px var(--accent);
	}
	.product-card__body {
		padding: 1.5em 1.5em 1em;
		flex: 1;
	}
	.product-card__title {
		font-size: 1.15em;
		margin: 0 0 0.2em;
		color: rgb(var(--black));
	}
	.product-card__price {
		font-size: 1.9em;
		font-weight: 700;
		color: rgb(var(--black));
		margin: 0 0 0.6em;
	}
	.product-card__description {
		font-size: 0.92em;
		color: rgb(var(--gray-dark));
		line-height: 1.6;
		margin: 0 0 1em;
	}
	.product-card__features {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.product-card__features li {
		font-size: 0.88em;
		color: rgb(var(--gray-dark));
		padding: 0.3em 0 0.3em 1.4em;
		position: relative;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.product-card__features li:last-child {
		border-bottom: none;
	}
	.product-card__features li::before {
		content: "✓";
		position: absolute;
		left: 0;
		color: #1a7a3c;
		font-weight: 700;
	}
	.product-card__footer {
		padding: 1em 1.5em 1.5em;
	}
	.product-cta {
		display: block;
		text-align: center;
		padding: 0.75em 1em;
		border-radius: 999px;
		background: var(--accent);
		color: #fff;
		font-weight: 700;
		font-size: 0.95em;
		text-decoration: none;
		transition: background-color 0.15s;
	}
	.product-cta:hover {
		background: var(--accent-dark);
		color: #fff;
	}
	.product-card--featured .product-cta {
		background: var(--accent);
	}
	.product-microcopy {
		font-size: 0.75em;
		color: rgb(var(--gray));
		text-align: center;
		margin: 0.6em 0 0;
	}

	.product-badge {
		background: var(--accent);
		color: #fff;
		font-size: 0.72em;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: 0.35em 1em;
		text-align: center;
	}
	.product-badge--value {
		background: #7c3aed;
	}

	.guarantee {
		max-width: 600px;
		margin: 0 auto 3em;
		padding: 1.75em;
		border: 2px solid #1a7a3c;
		border-radius: 14px;
		background: rgba(26, 122, 60, 0.04);
		text-align: center;
	}
	.guarantee__badge {
		display: inline-block;
		padding: 0.3em 0.85em;
		border-radius: 999px;
		background: #1a7a3c;
		color: #fff;
		font-size: 0.78em;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		margin-bottom: 0.75em;
	}
	.guarantee h2 {
		font-size: 1.3em;
		margin: 0 0 0.5em;
	}
	.guarantee p {
		color: rgb(var(--gray-dark));
		line-height: 1.65;
		margin: 0;
	}
</style>
