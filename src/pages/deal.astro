---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ALL_PRODUCTS, BUZZYFLY_CONFIG } from "../data/monetization";

const bundle = ALL_PRODUCTS.find((p) => p.id === "complete-business-bundle")!;
const system = ALL_PRODUCTS.find((p) => p.id === "buzzyfly-digital-system")!;
const catalog = ALL_PRODUCTS.map((p) => ({
	id: p.id,
	title: p.title,
	price: Number(p.price.replace("$", "")),
	stripeUrl: p.stripeUrl,
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Complete Business Bundle $97 — Buzzyfly"
			description="One download: onboarding, follow-ups, and the 20-minute weekly reset. $97 once. Stripe checkout. No subscription."
		/>
		<style>
			.deal { max-width: 720px; margin: 0 auto; }
			.deal h1 { font-size: 2rem; line-height: 1.15; margin-bottom: 0.3em; }
			.price { font-size: 2.4rem; font-weight: 800; margin: 0.2em 0; }
			.card { border: 1px solid rgb(var(--gray-light)); border-radius: 12px; padding: 1rem 1.1rem; margin: 1rem 0; }
			.cta { display: inline-block; background: var(--accent); color: #1d1606; font-weight: 700; padding: 0.8em 1.1em; border-radius: 8px; text-decoration: none; }
			label { display: block; margin-top: 0.7em; font-size: 0.9em; }
			input, select, textarea { width: 100%; margin-top: 0.3em; padding: 0.6em; font: inherit; }
			textarea { min-height: 7em; }
			button.copy { margin-top: 0.6em; font: inherit; padding: 0.55em 0.8em; }
			.muted { color: rgb(var(--gray-dark)); }
			table { width: 100%; border-collapse: collapse; }
			td, th { text-align: left; padding: 0.35em 0.2em; border-bottom: 1px solid rgb(var(--gray-light)); }
		</style>
	</head>
	<body>
		<Header />
		<main class="deal">
			<p class="muted">One public offer. Existing files. Stripe checkout. No PayPal button — PayPal is not wired.</p>
			<h1>{bundle.title}</h1>
			<p class="price">{bundle.price}</p>
			<p>{bundle.description}</p>
			<ul>
				{bundle.features.map((f) => <li>{f}</li>)}
			</ul>
			<p>{BUZZYFLY_CONFIG.guarantee}</p>
			<p><a class="cta" href={bundle.stripeUrl}>Get the bundle — {bundle.price}</a></p>
			<p class="muted">Downsell if they stall: <a href={system.stripeUrl}>{system.title} {system.price}</a></p>

			<div class="card">
				<h2>Units to a target</h2>
				<label>Target ($)<input id="target" type="number" value="10000" min="15" /></label>
				<label>Offer
					<select id="offer">
						{catalog.map((p) => <option value={p.price}>{p.title} ${p.price}</option>)}
					</select>
				</label>
				<p id="units"></p>
				<table><tbody id="table"></tbody></table>
			</div>

			<div class="card">
				<h2>Paste today</h2>
				<textarea id="xpost" readonly>Client signs, then you blank on the welcome email. Complete Business Bundle is the onboarding checklist, 5 follow-ups, and the 20-minute Monday reset. $97 once. https://buzzyfly.com/deal</textarea>
				<button class="copy" type="button" data-copy="xpost">Copy post</button>
				<textarea id="email" readonly>Monday reset is 20 minutes. The Complete Business Bundle ($97) is that plus onboarding and the follow-up emails. One download. No subscription. https://buzzyfly.com/deal</textarea>
				<button class="copy" type="button" data-copy="email">Copy email</button>
			</div>
		</main>
		<Footer />
		<script define:vars={{ catalog }}>
			const $ = (id) => document.getElementById(id);
			function render() {
				const target = Number($("target").value) || 10000;
				const price = Number($("offer").value);
				const units = Math.ceil(target / price);
				$("units").textContent = units + " sales · " + (units / 30).toFixed(1) + " per day";
				$("table").innerHTML = catalog.map((p) => {
					const u = Math.ceil(target / p.price);
					return "<tr><td>$" + p.price + "</td><td>" + u + "</td><td>" + (u / 30).toFixed(1) + "/day</td><td><a href=\"" + p.stripeUrl + "\">Stripe</a></td></tr>";
				}).join("");
			}
			$("target").oninput = render;
			$("offer").onchange = render;
			document.querySelectorAll(".copy").forEach((btn) => {
				btn.onclick = async () => {
					await navigator.clipboard.writeText($(btn.dataset.copy).value);
					btn.textContent = "Copied";
				};
			});
			render();
		</script>
	</body>
</html>
