---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteSearch from '../components/SiteSearch.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Search · ${SITE_TITLE}`}
			description="Search every post and page on Buzzyfly."
		/>
		<!-- Results are built in the browser, so there is nothing here for a
		     crawler to index. Keep this page out of search engines and let it
		     point at the real content instead. -->
		<meta name="robots" content="noindex, follow" />
	</head>
	<body>
		<Header />
		<main>
			<SiteSearch
				standalone
				limit={20}
				heading="Search Buzzyfly"
				hint="Search every post and page. Use ↑ ↓ to move through results, Enter to open one."
			/>
		</main>
		<Footer />
	</body>
</html>
