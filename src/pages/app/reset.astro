---
// The $15 Weekly Reset web app: the Digital System's reset screens on their
// own. Buyers of either product get in; the Digital System's key opens it too.
import AppShell from "../../components/AppShell.astro";
import { RESET_APP_ITEM_ID, resolveAppAccess } from "../../lib/appAccess";

export const prerender = false;
Astro.response.headers.set("cache-control", "private, no-store");

const access = await resolveAppAccess(Astro.locals.runtime.env, Astro.url, Astro.cookies, RESET_APP_ITEM_ID);
if (access.redirect) return Astro.redirect(access.redirect, 302);
if (!access.unlocked) Astro.response.status = 402;

const NAV = [
	{ id: "reset", label: "Monday", icon: "🔁" },
	{ id: "week", label: "This week", icon: "📅" },
	{ id: "log", label: "Log", icon: "📈" },
	{ id: "settings", label: "More", icon: "⚙️" },
];
---
<AppShell itemId={RESET_APP_ITEM_ID} unlocked={access.unlocked} badLink={access.badLink} edition="reset" nav={NAV} appName="Weekly Reset" />
