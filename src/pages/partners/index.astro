---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { BUZZYFLY_CONFIG, DONE_FOR_YOU, getProduct } from "../../data/monetization";
import { DEFAULT_RATE_PCT, HOLD_DAYS, SETUP_RATE_PCT } from "../../lib/affiliates";

const system = getProduct("buzzyfly-digital-system")!;
const bundle = getProduct("complete-business-bundle")!;
const setup = getProduct(DONE_FOR_YOU.productId)!;
const dollars = (price: string) => Number(price.replace(/[^0-9.]/g, ""));
const per = (price: string, pct: number) => `$${((dollars(price) * pct) / 100).toFixed(2).replace(/\.00$/, "")}`;

const RULES = [
	"Say you're a partner. A short line like “I earn a commission if you buy” is enough. The law requires it in most places.",
	"No spam. No buying ads on the word “Buzzyfly”. No coupon or deal sites.",
	"Don't promise buyers income or results. Describe what's in the files.",
	"Your own purchases don't earn commission. Refunded orders don't either.",
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Partner program — earn ${DEFAULT_RATE_PCT}% recommending Buzzyfly`}
			description={`Recommend Buzzyfly's client-system templates to the freelancers, coaches and consultants you already help. Earn ${DEFAULT_RATE_PCT}% of every sale. Free to join.`}
		/>
		<style>
			main { width: 760px; }
			.eyebrow { margin: 0 0 0.8em; font-size: 0.78em; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
			h1 { font-size: clamp(1.8em, 6vw, 2.6em); line-height: 1.12; margin: 0 0 0.5em; }
			.lede { font-size: 1.05em; color: rgb(var(--gray-dark)); }
			section { margin-top: 2.5em; }
			h2 { font-size: clamp(1.3em, 4.5vw, 1.6em); }
			.earn { width: 100%; border-collapse: collapse; }
			.earn th, .earn td { text-align: left; padding: 0.6em 0.7em; border-bottom: 1px solid rgb(var(--gray-light)); font-size: 0.95em; }
			.earn th { font-size: 0.78em; text-transform: uppercase; letter-spacing: 0.05em; color: rgb(var(--gray)); }
			.earn td:last-child { font-weight: 700; }
			.steps { padding-left: 1.2em; }
			.steps li { margin-bottom: 0.5em; }
			form { display: grid; gap: 1em; padding: 1.4em; border-radius: 14px; background: rgba(var(--gray-light), 45%); }
			label { display: grid; gap: 0.3em; font-weight: 700; font-size: 0.92em; }
			label span.hint { font-weight: 400; color: rgb(var(--gray)); font-size: 0.9em; }
			input, textarea { font: inherit; font-weight: 400; padding: 0.65em 0.75em; min-height: 44px; box-sizing: border-box; border: 1px solid rgb(var(--gray)); border-radius: 8px; background: #fff; width: 100%; }
			textarea { min-height: 88px; resize: vertical; }
			input:focus-visible, textarea:focus-visible, button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
			.check { display: flex; gap: 0.6em; align-items: flex-start; font-weight: 400; }
			.check input { width: 22px; min-height: 22px; height: 22px; margin-top: 0.15em; flex: none; }
			.hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
			button { min-height: 52px; border: 0; border-radius: 999px; background: var(--accent); color: #fff; font: inherit; font-weight: 800; font-size: 1.1em; cursor: pointer; }
			button:hover { background: var(--accent-dark); }
			button[disabled] { opacity: 0.6; cursor: wait; }
			.status { margin: 0; font-weight: 700; }
			.status.ok { color: #1f6b3a; }
			.status.err { color: #a11; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="eyebrow">Buzzyfly partner program</p>
			<h1>Your audience asks how to stop dropping clients. Send them here and earn {DEFAULT_RATE_PCT}%.</h1>
			<p class="lede">
				You run a newsletter, a community, a course or a coaching practice for freelancers and solo service providers.
				They already ask you for onboarding emails and follow-up templates. Buzzyfly has them. You get {DEFAULT_RATE_PCT}% of every sale you send.
			</p>

			<section aria-labelledby="earn-heading">
				<h2 id="earn-heading">What you earn per sale</h2>
				<table class="earn">
					<thead><tr><th>Product</th><th>Price</th><th>You get</th></tr></thead>
					<tbody>
						<tr><td>{system.title}</td><td>{system.price}</td><td>{per(system.price, DEFAULT_RATE_PCT)}</td></tr>
						<tr><td>{bundle.title}</td><td>{bundle.price}</td><td>{per(bundle.price, DEFAULT_RATE_PCT)}</td></tr>
						<tr><td>{setup.title}</td><td>{setup.price}</td><td>{per(setup.price, SETUP_RATE_PCT)} ({SETUP_RATE_PCT}%)</td></tr>
						<tr><td>Single kits</td><td>$15–$29</td><td>{DEFAULT_RATE_PCT}%</td></tr>
					</tbody>
				</table>
				<p>
					Your link remembers the visitor for 30 days. Commissions are paid by PayPal once the {HOLD_DAYS}-day money-back window on each sale has closed.
				</p>
			</section>

			<section aria-labelledby="how-heading">
				<h2 id="how-heading">How it works</h2>
				<ol class="steps">
					<li>Apply below. It takes two minutes.</li>
					<li>Once approved, you get your link and a private page with your clicks, sales and earnings.</li>
					<li>Share the link in your newsletter, community, course or client emails.</li>
				</ol>
			</section>

			<section aria-labelledby="rules-heading">
				<h2 id="rules-heading">The rules</h2>
				<ul>{RULES.map((r) => <li>{r}</li>)}</ul>
			</section>

			<section aria-labelledby="apply-heading">
				<h2 id="apply-heading">Apply</h2>
				<form id="partner-form" method="POST" action="/api/partner-apply">
					<label>Your name <input name="name" required maxlength="80" autocomplete="name" /></label>
					<label>Email <input name="email" type="email" required maxlength="160" autocomplete="email" /></label>
					<label>
						Where you'd share Buzzyfly
						<span class="hint">Website, newsletter, community or social profile.</span>
						<input name="website" required maxlength="200" placeholder="https://" />
					</label>
					<label>
						Who is your audience?
						<span class="hint">One or two sentences. Roughly how many people?</span>
						<textarea name="audience" required maxlength="600"></textarea>
					</label>
					<label>
						Link name you'd like
						<span class="hint">Letters, numbers and dashes. Your link becomes buzzyfly.com/r/your-name.</span>
						<input name="code" maxlength="32" pattern="[A-Za-z0-9-]{2,32}" />
					</label>
					<label>
						PayPal email for payouts
						<span class="hint">Leave blank to use the email above.</span>
						<input name="payout_email" type="email" maxlength="160" />
					</label>
					<label class="hp" aria-hidden="true">Leave empty <input name="company" tabindex="-1" autocomplete="off" /></label>
					<label class="check">
						<input type="checkbox" name="agree" value="yes" required />
						<span>I'll follow the rules above, including saying I'm a partner when I share the link.</span>
					</label>
					<button type="submit">Apply to partner</button>
					<p class="status" id="partner-status" role="status" aria-live="polite"></p>
				</form>
				<p>Questions? Email <a href={`mailto:${BUZZYFLY_CONFIG.orderEmail}`}>{BUZZYFLY_CONFIG.orderEmail}</a>.</p>
			</section>
		</main>
		<Footer />
		<script>
			const form = document.getElementById("partner-form") as HTMLFormElement | null;
			const status = document.getElementById("partner-status");
			form?.addEventListener("submit", async (event) => {
				event.preventDefault();
				if (!status) return;
				const button = form.querySelector("button");
				button?.setAttribute("disabled", "");
				status.className = "status";
				status.textContent = "Sending…";
				try {
					const res = await fetch("/api/partner-apply", {
						method: "POST",
						headers: { "content-type": "application/json" },
						body: JSON.stringify(Object.fromEntries(new FormData(form))),
					});
					const data = (await res.json().catch(() => ({}))) as { ok?: boolean; message?: string; error?: string };
					if (res.ok && data.ok) {
						status.className = "status ok";
						status.textContent = data.message ?? "Thanks. You'll hear back by email.";
						form.reset();
					} else {
						status.className = "status err";
						status.textContent = data.error ?? "That didn't go through. Please try again.";
					}
				} catch {
					status.className = "status err";
					status.textContent = "That didn't go through. Check your connection and try again.";
				} finally {
					button?.removeAttribute("disabled");
				}
			});
		</script>
	</body>
</html>
