---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { EXPLAINER_VIDEOS, getVideo, fmtTime } from '../../data/videos';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const video = getVideo(slug);
if (!video) {
	return Astro.redirect('/videos');
}
const queue = EXPLAINER_VIDEOS.filter((v) => v.slug !== video.slug);
const perSlide = Math.round((video.seconds / video.slides.length) * 1000);
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${video.title} — Buzzyfly`} description={video.description} />
		<style>
			body.yt-page { background:#0f0f0f; color:#f1f1f1; margin:0; font-family:system-ui,-apple-system,sans-serif; }
			body.yt-page header { background:#0f0f0f !important; box-shadow:none !important; border-bottom:1px solid #272727; }
			body.yt-page footer { background:#0f0f0f !important; border-top:1px solid #272727; }
			body.yt-page header nav a,
			body.yt-page header h2 a,
			body.yt-page footer a,
			body.yt-page footer p { color:#f1f1f1 !important; }

			.yt-wrap { max-width:1280px; margin:0 auto; padding:16px 16px 48px; }
			.yt-layout { display:grid; grid-template-columns:minmax(0,1fr) 402px; gap:24px; align-items:start; }

			/* ══ PLAYER SHELL ══ */
			.player-wrap { min-width:0; }
			.player {
				position:relative;
				aspect-ratio:16/9;
				background:#000;
				border-radius:12px;
				overflow:hidden;
				cursor:pointer;
				user-select:none;
			}

			/* ── Poster state (default) ── */
			.player-poster {
				position:absolute;
				inset:0;
				z-index:10;
				transition:opacity .35s;
			}
			.player-poster img {
				width:100%; height:100%;
				object-fit:cover;
				display:block;
			}
			/* Big play button centred on poster */
			.poster-play {
				position:absolute;
				inset:0;
				display:flex;
				align-items:center;
				justify-content:center;
				background:rgba(0,0,0,.35);
				transition:background .2s;
			}
			.player:hover .poster-play { background:rgba(0,0,0,.5); }
			.poster-play-btn {
				width:72px; height:72px;
				border-radius:50%;
				background:rgba(255,255,255,.92);
				display:flex;
				align-items:center;
				justify-content:center;
				box-shadow:0 4px 24px rgba(0,0,0,.5);
				transition:transform .2s, background .2s;
			}
			.player:hover .poster-play-btn { transform:scale(1.08); background:#fff; }
			.poster-play-btn svg { width:28px; height:28px; margin-left:4px; }

			/* Poster hidden once playing */
			.player.playing .player-poster,
			.player.ended   .player-poster { opacity:0; pointer-events:none; }

			/* ── Motion-graphics slide player ── */
			.explainer {
				position:absolute;
				inset:0;
				overflow:hidden;
				opacity:0;
				transition:opacity .4s;
			}
			.player.playing .explainer,
			.player.ended   .explainer { opacity:1; }

			/* Animated background */
			.exp-bg {
				position:absolute;
				inset:-20%;
				animation:bgshift 8s ease-in-out infinite alternate;
			}
			/* bg color set per-slide via JS */
			@keyframes bgshift {
				0%   { transform:translate(0,0) scale(1); }
				50%  { transform:translate(3%,2%) scale(1.04); }
				100% { transform:translate(-2%,3%) scale(1.02); }
			}

			/* Grid lines */
			.exp-grid {
				position:absolute;
				inset:0;
				background-image:
					linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
					linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
				background-size:48px 48px;
				pointer-events:none;
			}

			/* Slide content */
			.exp-content {
				position:absolute;
				inset:0;
				display:flex;
				flex-direction:column;
				justify-content:center;
				padding:7% 8%;
			}
			.slide-kicker {
				font-size:clamp(.65rem,.9vw,.85rem);
				font-weight:700;
				letter-spacing:.14em;
				text-transform:uppercase;
				color:#f4c27a;
				margin:0 0 .55rem;
			}
			.slide-headline {
				font-size:clamp(1.2rem,3.5vw,2.6rem);
				font-weight:800;
				color:#fff;
				line-height:1.15;
				margin:0 0 .6rem;
			}
			.slide-sub {
				font-size:clamp(.82rem,1.5vw,1.05rem);
				color:rgba(255,255,255,.72);
				line-height:1.55;
				margin:0;
				max-width:36rem;
			}

			/* Buzzyfly brand mark */
			.exp-brand {
				position:absolute;
				top:14px; left:16px;
				font-size:.72rem;
				font-weight:800;
				letter-spacing:.1em;
				color:rgba(244,194,122,.6);
				text-transform:uppercase;
				z-index:2;
			}

			/* ── End card ── */
			.end-card {
				position:absolute;
				inset:0;
				display:flex;
				flex-direction:column;
				align-items:center;
				justify-content:center;
				gap:16px;
				background:rgba(0,0,0,.7);
				opacity:0;
				pointer-events:none;
				transition:opacity .4s;
			}
			.player.ended .end-card { opacity:1; pointer-events:auto; }
			.end-card h3 { font-size:1.4rem; font-weight:800; color:#fff; margin:0; text-align:center; }
			.end-cta {
				display:inline-flex;
				align-items:center;
				gap:8px;
				padding:.6em 1.6em;
				background:#f4c27a;
				color:#0f0f0f;
				font-weight:700;
				font-size:1rem;
				border-radius:999px;
				text-decoration:none;
				transition:background .15s;
			}
			.end-cta:hover { background:#f9d898; }
			.end-replay {
				background:none;
				border:none;
				color:rgba(255,255,255,.6);
				font-size:.85rem;
				cursor:pointer;
				text-decoration:underline;
				padding:0;
			}
			.end-replay:hover { color:#fff; }

			/* ── Controls bar ── */
			.controls {
				position:absolute;
				bottom:0; left:0; right:0;
				padding:0 12px 10px;
				background:linear-gradient(transparent, rgba(0,0,0,.8));
				z-index:20;
				opacity:0;
				transition:opacity .25s;
			}
			.player:hover .controls,
			.player.ended .controls  { opacity:1; }
			.player.playing .controls { opacity:0; }
			.player.playing:hover .controls { opacity:1; }

			/* Progress / timeline */
			.progress-rail {
				width:100%;
				height:4px;
				background:rgba(255,255,255,.25);
				border-radius:4px;
				margin-bottom:8px;
				cursor:pointer;
				position:relative;
			}
			.progress-fill {
				height:100%;
				background:#f4c27a;
				border-radius:4px;
				width:0%;
				transition:width 0s linear;
				pointer-events:none;
			}
			.controls-row {
				display:flex;
				align-items:center;
				gap:10px;
			}
			.ctrl-btn {
				background:none;
				border:none;
				color:#fff;
				cursor:pointer;
				padding:0;
				display:flex;
				align-items:center;
			}
			.ctrl-btn svg { width:22px; height:22px; }
			.ctrl-time {
				font-size:.78rem;
				color:rgba(255,255,255,.75);
				font-variant-numeric:tabular-nums;
				margin-left:2px;
			}
			.ctrl-title {
				flex:1;
				font-size:.78rem;
				color:rgba(255,255,255,.6);
				white-space:nowrap;
				overflow:hidden;
				text-overflow:ellipsis;
				margin:0 8px;
			}
			.ctrl-fullscreen { margin-left:auto; }

			/* Centre pause icon flash */
			.centre-icon {
				position:absolute;
				inset:0;
				display:flex;
				align-items:center;
				justify-content:center;
				pointer-events:none;
				z-index:15;
			}
			.centre-icon span {
				width:62px; height:62px;
				border-radius:50%;
				background:rgba(0,0,0,.55);
				display:flex;
				align-items:center;
				justify-content:center;
				opacity:0;
				transform:scale(.8);
				transition:opacity .15s, transform .15s;
			}
			.centre-icon span.show { opacity:1; transform:scale(1); }
			.centre-icon svg { width:30px; height:30px; fill:#fff; }

			/* ══ Below player ══ */
			.video-title {
				font-size:1.15rem;
				font-weight:600;
				color:#fff;
				margin:14px 0 8px;
				line-height:1.35;
			}
			.video-stats-row {
				display:flex;
				align-items:center;
				justify-content:space-between;
				flex-wrap:wrap;
				gap:8px;
				padding:10px 0;
				border-bottom:1px solid #272727;
			}
			.video-stats { font-size:.85rem; color:#aaa; margin:0; }
			.action-btns { display:flex; gap:6px; }
			.act-btn {
				display:flex;
				align-items:center;
				gap:5px;
				padding:.4em .9em;
				border-radius:999px;
				background:#272727;
				border:none;
				color:#f1f1f1;
				font-size:.82rem;
				font-weight:600;
				cursor:pointer;
				transition:background .15s;
				text-decoration:none;
			}
			.act-btn:hover { background:#3d3d3d; }
			.act-btn svg { width:16px; height:16px; }

			/* Channel row */
			.channel-row {
				display:flex;
				align-items:center;
				gap:12px;
				padding:14px 0;
				border-bottom:1px solid #272727;
			}
			.ch-avatar {
				width:42px; height:42px;
				border-radius:50%;
				background:#c97820;
				display:grid;
				place-items:center;
				font-weight:800;
				font-size:1.1rem;
				flex-shrink:0;
				overflow:hidden;
			}
			.ch-avatar img { width:100%; height:100%; object-fit:cover; border-radius:50%; }
			.ch-name { font-size:.9rem; font-weight:600; color:#fff; margin:0 0 2px; }
			.ch-subs { font-size:.78rem; color:#aaa; margin:0; }
			.subscribe-btn {
				margin-left:auto;
				padding:.45em 1.1em;
				border-radius:999px;
				background:#f1f1f1;
				color:#0f0f0f;
				font-weight:700;
				font-size:.85rem;
				border:none;
				cursor:pointer;
				transition:background .15s;
				white-space:nowrap;
				text-decoration:none;
			}
			.subscribe-btn:hover { background:#ccc; }

			/* Description */
			.desc-box { padding:12px 0; border-bottom:1px solid #272727; }
			.desc-text { font-size:.88rem; color:#ccc; line-height:1.55; margin:0; }

			/* ══ SIDEBAR ══ */
			.sidebar { min-width:0; }
			.sidebar-label {
				font-size:.8rem;
				font-weight:700;
				letter-spacing:.06em;
				text-transform:uppercase;
				color:#aaa;
				margin:0 0 10px;
			}
			.queue { display:flex; flex-direction:column; gap:6px; }
			.qcard {
				display:grid;
				grid-template-columns:168px 1fr;
				gap:8px;
				text-decoration:none;
				color:inherit;
				padding:5px;
				border-radius:8px;
				transition:background .15s;
			}
			.qcard:hover { background:#1f1f1f; }
			.qthumb {
				position:relative;
				aspect-ratio:16/9;
				border-radius:6px;
				overflow:hidden;
				background:#1a1a1a;
				flex-shrink:0;
			}
			.qthumb img { width:100%; height:100%; object-fit:cover; display:block; }
			.qdur {
				position:absolute;
				right:4px; bottom:4px;
				background:rgba(0,0,0,.85);
				color:#fff;
				font-size:10px;
				font-weight:600;
				padding:1px 4px;
				border-radius:3px;
			}
			.qtitle { font-size:.84rem; font-weight:500; color:#f1f1f1; margin:0 0 4px; line-height:1.35; }
			.qmeta  { font-size:.74rem; color:#aaa; margin:0; }

			@media (max-width:960px) {
				.yt-layout { grid-template-columns:1fr; }
				.sidebar { order:3; }
				.queue { display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:12px; }
				.qcard { grid-template-columns:140px 1fr; }
			}
			@media (max-width:540px) {
				.qcard { grid-template-columns:110px 1fr; }
			}
		</style>
	</head>
	<body class="yt-page">
		<Header />
		<main class="yt-wrap">
			<div class="yt-layout">

				<!-- Left: player + meta -->
				<div class="player-wrap">
					<div class="player" id="player">

						<!-- Poster (shown until play is clicked) -->
						<div class="player-poster" id="playerPoster">
							<img src={video.poster} alt={video.title} />
							<div class="poster-play" id="posterPlay">
								<div class="poster-play-btn">
									<!-- Play triangle -->
									<svg viewBox="0 0 28 28" fill="none">
										<polygon points="6,2 26,14 6,26" fill="#0f0f0f"/>
									</svg>
								</div>
							</div>
						</div>

						<!-- Slide explainer (motion graphics) -->
						<div class="explainer" id="explainer">
							<div class="exp-bg" id="expBg"></div>
							<div class="exp-grid"></div>
							<span class="exp-brand">Buzzyfly</span>

							<!-- Animated talking character -->
						<svg id="charSvg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 360"
							style="position:absolute;inset:0;width:100%;height:100%;display:block;" aria-hidden="true">
							<defs>
								<radialGradient id="skinGrad" cx="45%" cy="35%" r="65%">
									<stop offset="0%" stop-color="#e8b887"/>
									<stop offset="70%" stop-color="#d4956a"/>
									<stop offset="100%" stop-color="#b87848"/>
								</radialGradient>
								<radialGradient id="hairGrad" cx="50%" cy="60%" r="55%">
									<stop offset="0%" stop-color="#3a2010"/>
									<stop offset="100%" stop-color="#150800"/>
								</radialGradient>
								<radialGradient id="blazerGrad" cx="50%" cy="30%" r="70%">
									<stop offset="0%" stop-color="#252538"/>
									<stop offset="100%" stop-color="#0a0a18"/>
								</radialGradient>
							</defs>

							<!-- Shoulders / blazer -->
							<path d="M 148 360 L 158 292 Q 192 265 248 255 L 265 296 L 320 280 L 375 296 L 392 255 Q 448 265 482 292 L 492 360 Z" fill="url(#blazerGrad)"/>
							<!-- Lapel shadows -->
							<path d="M 265 296 L 252 344 L 308 344 L 290 296 Z" fill="rgba(5,5,20,0.7)"/>
							<path d="M 375 296 L 388 344 L 332 344 L 350 296 Z" fill="rgba(5,5,20,0.7)"/>
							<!-- White shirt -->
							<path d="M 290 296 L 320 336 L 350 296 L 320 280 Z" fill="#dde0ea"/>
							<!-- Tie -->
							<path d="M 314 283 L 323 334 L 326 283 L 323 272 L 317 272 Z" fill="#a86318"/>

							<!-- Neck -->
							<rect x="296" y="242" width="48" height="42" rx="8" fill="url(#skinGrad)"/>
							<ellipse cx="296" cy="263" rx="6" ry="20" fill="rgba(0,0,0,0.12)"/>
							<ellipse cx="344" cy="263" rx="6" ry="20" fill="rgba(0,0,0,0.12)"/>

							<!-- Ears -->
							<ellipse cx="244" cy="177" rx="15" ry="20" fill="url(#skinGrad)"/>
							<ellipse cx="396" cy="177" rx="15" ry="20" fill="url(#skinGrad)"/>
							<path d="M 247 164 Q 251 177 247 190" stroke="#c07848" stroke-width="2" fill="none"/>
							<path d="M 393 164 Q 389 177 393 190" stroke="#c07848" stroke-width="2" fill="none"/>

							<!-- Head -->
							<ellipse cx="320" cy="174" rx="78" ry="87" fill="url(#skinGrad)"/>

							<!-- Hair -->
							<ellipse cx="320" cy="96" rx="78" ry="50" fill="url(#hairGrad)"/>
							<path d="M 242 154 Q 248 107 280 89 Q 320 73 360 89 Q 392 107 398 154 Q 374 128 320 126 Q 266 128 242 154 Z" fill="url(#hairGrad)"/>
							<path d="M 243 155 Q 246 172 250 188 Q 256 171 260 157 Z" fill="url(#hairGrad)"/>
							<path d="M 397 155 Q 394 172 390 188 Q 384 171 380 157 Z" fill="url(#hairGrad)"/>

							<!-- Eyebrows -->
							<path d="M 274 143 Q 289 136 306 140" stroke="#2a1505" stroke-width="4" stroke-linecap="round" fill="none"/>
							<path d="M 334 140 Q 351 136 366 143" stroke="#2a1505" stroke-width="4" stroke-linecap="round" fill="none"/>

							<!-- Eye sockets -->
							<ellipse cx="290" cy="161" rx="21" ry="17" fill="rgba(150,90,40,0.18)"/>
							<ellipse cx="350" cy="161" rx="21" ry="17" fill="rgba(150,90,40,0.18)"/>

							<!-- Sclera -->
							<ellipse cx="290" cy="161" rx="18" ry="14" fill="white"/>
							<ellipse cx="350" cy="161" rx="18" ry="14" fill="white"/>

							<!-- Iris + pupil left -->
							<circle cx="290" cy="162" r="9.5" fill="#5a6e8a"/>
							<circle cx="290" cy="162" r="6" fill="#1a2030"/>
							<circle cx="292.5" cy="159" r="2.5" fill="white"/>

							<!-- Iris + pupil right -->
							<circle cx="350" cy="162" r="9.5" fill="#5a6e8a"/>
							<circle cx="350" cy="162" r="6" fill="#1a2030"/>
							<circle cx="352.5" cy="159" r="2.5" fill="white"/>

							<!-- Eyelids (blink) — pivot from top edge of eye -->
							<ellipse id="eyelid-L" cx="290" cy="161" rx="19" ry="15"
								fill="#d4956a" style="transform-origin:290px 146px;transform:scaleY(0);transition:transform 0.07s ease-in;"/>
							<ellipse id="eyelid-R" cx="350" cy="161" rx="19" ry="15"
								fill="#d4956a" style="transform-origin:350px 146px;transform:scaleY(0);transition:transform 0.07s ease-in;"/>

							<!-- Nose -->
							<path d="M 315 194 Q 312 207 309 212 Q 316 217 320 216 Q 324 217 331 212 Q 328 207 325 194" fill="rgba(160,95,50,0.32)"/>
							<ellipse cx="313" cy="211" rx="5" ry="4" fill="rgba(120,70,40,0.38)"/>
							<ellipse cx="327" cy="211" rx="5" ry="4" fill="rgba(120,70,40,0.38)"/>

							<!-- Cheek warmth -->
							<ellipse cx="266" cy="192" rx="22" ry="13" fill="rgba(220,130,80,0.18)"/>
							<ellipse cx="374" cy="192" rx="22" ry="13" fill="rgba(220,130,80,0.18)"/>

							<!-- Mouth CLOSED -->
							<path id="mouth-closed" d="M 302 221 Q 311 228 320 226 Q 329 228 338 221"
								stroke="#8a4c35" stroke-width="2.5" fill="none" stroke-linecap="round"/>
							<path d="M 306 225 Q 320 231 334 225 Q 320 235 306 225 Z" fill="rgba(180,110,80,0.3)"/>

							<!-- Mouth OPEN -->
							<g id="mouth-open" style="display:none">
								<path d="M 300 219 Q 320 234 340 219 Q 334 243 320 247 Q 306 243 300 219 Z" fill="#8a3830"/>
								<path d="M 303 223 Q 320 232 337 223 L 335 230 Q 320 235 305 230 Z" fill="#f0ede8"/>
								<path d="M 306 230 Q 320 235 334 230 L 332 237 Q 320 241 308 237 Z" fill="#e8e5e0"/>
								<ellipse cx="320" cy="238" rx="9" ry="5" fill="#c85050" opacity="0.55"/>
								<path d="M 300 219 Q 311 214 320 216 Q 329 214 340 219" fill="#c07060" stroke="none"/>
							</g>

							<!-- BF badge -->
							<rect x="370" y="314" width="38" height="28" rx="5" fill="#c97820"/>
							<text x="389" y="332" text-anchor="middle" fill="white"
								font-size="12" font-weight="800" font-family="system-ui,Arial,sans-serif">BF</text>
						</svg>
						</div>

						<!-- End card -->
						<div class="end-card" id="endCard">
							<h3>Get the full system</h3>
							<a class="end-cta" href="/store">
								<svg viewBox="0 0 24 24" fill="currentColor" style="width:18px;height:18px"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
								Buy now — from $15
							</a>
							<button class="end-replay" id="endReplay">Watch again</button>
						</div>

						<!-- Controls bar -->
						<div class="controls" id="controls">
							<div class="progress-rail" id="progressRail">
								<div class="progress-fill" id="progressFill"></div>
							</div>
							<div class="controls-row">
								<button class="ctrl-btn" id="ctrlPlayPause" title="Play / Pause">
									<!-- Pause icon by default (shown while playing) -->
									<svg id="iconPause" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>
									<svg id="iconPlay" viewBox="0 0 24 24" fill="currentColor" style="display:none"><polygon points="5,3 19,12 5,21"/></svg>
								</button>
								<span class="ctrl-time" id="ctrlTime">0:00 / {fmtTime(video.seconds)}</span>
								<span class="ctrl-title">{video.title}</span>
								<button class="ctrl-btn ctrl-fullscreen" id="ctrlFullscreen" title="Fullscreen">
									<svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
								</button>
							</div>
						</div>

						<!-- Centre flash icon (pause/play indicator) -->
						<div class="centre-icon">
							<span id="centreIcon">
								<svg id="centreIconSvg" viewBox="0 0 30 30"><polygon points="5,2 25,15 5,28"/></svg>
							</span>
						</div>

					</div><!-- /.player -->

					<!-- Title and actions -->
					<h1 class="video-title">{video.title}</h1>
					<div class="video-stats-row">
						<p class="video-stats">{video.views} views · {video.date}</p>
						<div class="action-btns">
							<button class="act-btn" id="likeBtn" title="Like">
								<svg viewBox="0 0 24 24" fill="currentColor"><path d="M1 21h4V9H1v12zm22-11c0-1.1-.9-2-2-2h-6.31l.95-4.57.03-.32c0-.41-.17-.79-.44-1.06L14.17 1 7.59 7.59C7.22 7.95 7 8.45 7 9v10c0 1.1.9 2 2 2h9c.83 0 1.54-.5 1.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73v-2z"/></svg>
								Like
							</button>
							<button class="act-btn" title="Share" onclick="navigator.share ? navigator.share({title:document.title,url:location.href}) : navigator.clipboard.writeText(location.href).then(()=>alert('Link copied!'))">
								<svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"/></svg>
								Share
							</button>
							<a class="act-btn" href="/store">
								<svg viewBox="0 0 24 24" fill="currentColor"><path d="M11 9h2V6h3V4h-3V1h-2v3H8v2h3v3zm-1 11c-1.1 0-1.99.9-1.99 2S8.9 24 10 24s2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2zm-8.9-5h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1 1 0 0 0 22 6h-16l-.94-2H2v2h2l3.6 7.59L6.25 16c-.16.28-.25.61-.25.96C6 18.1 6.9 19 8 19h14v-2H8.42c-.14 0-.25-.11-.25-.25l.03-.15.9-1.6z"/></svg>
								Get the system
							</a>
						</div>
					</div>

					<!-- Channel -->
					<div class="channel-row">
						<div class="ch-avatar">
							<img src="/buzzyfly-logo.svg" alt="Buzzyfly" />
						</div>
						<div>
							<p class="ch-name">Buzzyfly</p>
							<p class="ch-subs">Official explainers</p>
						</div>
						<a class="subscribe-btn" href="/store">Get the system</a>
					</div>

					<!-- Description -->
					<div class="desc-box">
						<p class="desc-text">{video.description}</p>
					</div>
				</div>

				<!-- Right: sidebar queue -->
				<aside class="sidebar">
					<p class="sidebar-label">Up next</p>
					<div class="queue">
						{queue.map((v) => (
							<a class="qcard" href={`/videos/${v.slug}`}>
								<div class="qthumb">
									<img src={v.poster} alt={v.title} loading="lazy" />
									<span class="qdur">{fmtTime(v.seconds)}</span>
								</div>
								<div>
									<p class="qtitle">{v.title}</p>
									<p class="qmeta">Buzzyfly · {v.views} views</p>
								</div>
							</a>
						))}
					</div>
				</aside>

			</div>
		</main>
		<Footer />

		<script is:inline define:vars={{ script: video.script ?? '', totalSeconds: video.seconds, videoTitle: video.title }}>
			const playerEl      = document.getElementById('player');
			const posterPlay    = document.getElementById('posterPlay');
			const explainer     = document.getElementById('explainer');
			const expBg         = document.getElementById('expBg');
			const endReplay     = document.getElementById('endReplay');
			const progressFill  = document.getElementById('progressFill');
			const progressRail  = document.getElementById('progressRail');
			const ctrlPlayPause = document.getElementById('ctrlPlayPause');
			const iconPlay      = document.getElementById('iconPlay');
			const iconPause     = document.getElementById('iconPause');
			const ctrlTime      = document.getElementById('ctrlTime');
			const ctrlFullscreen= document.getElementById('ctrlFullscreen');
			const centreIcon    = document.getElementById('centreIcon');
			const centreIconSvg = document.getElementById('centreIconSvg');
			const likeBtn       = document.getElementById('likeBtn');
			const mouthClosed   = document.getElementById('mouth-closed');
			const mouthOpen     = document.getElementById('mouth-open');
			const eyelidL       = document.getElementById('eyelid-L');
			const eyelidR       = document.getElementById('eyelid-R');
			const charSvg       = document.getElementById('charSvg');

			const BG_SETS = [
				'radial-gradient(ellipse 60% 50% at 20% 30%, rgba(201,120,32,0.4) 0%, transparent 70%), radial-gradient(ellipse 50% 60% at 80% 70%, rgba(35,55,255,0.28) 0%, transparent 65%), #0f0f0f',
				'radial-gradient(ellipse 55% 55% at 75% 25%, rgba(35,200,120,0.3) 0%, transparent 70%), radial-gradient(ellipse 60% 50% at 20% 75%, rgba(120,35,255,0.25) 0%, transparent 65%), #0a0a0a',
				'radial-gradient(ellipse 70% 50% at 50% 20%, rgba(255,60,80,0.28) 0%, transparent 70%), radial-gradient(ellipse 50% 60% at 80% 80%, rgba(201,120,32,0.3) 0%, transparent 65%), #0f0f0f',
				'radial-gradient(ellipse 60% 60% at 10% 60%, rgba(35,55,255,0.35) 0%, transparent 70%), radial-gradient(ellipse 55% 50% at 85% 30%, rgba(35,200,200,0.2) 0%, transparent 65%), #0a0a12',
			];
			let bgIdx = 0;

			let started = false;
			let ended   = false;
			let paused  = false;

			/* Progress timer */
			let timeRaf   = null;
			let timeStart = null;
			let timeAccum = 0;

			function fmtMs(ms) {
				const s = Math.floor(ms / 1000);
				return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
			}
			function fmtSecs(s) {
				return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
			}
			function setIcons(playing) {
				iconPause.style.display = playing ? '' : 'none';
				iconPlay.style.display  = playing ? 'none' : '';
			}
			function flashCentre(isPlay) {
				centreIconSvg.innerHTML = isPlay
					? '<polygon points="5,2 25,15 5,28"/>'
					: '<rect x="6" y="4" width="5" height="22" rx="2"/><rect x="15" y="4" width="5" height="22" rx="2"/>';
				centreIcon.classList.add('show');
				setTimeout(() => centreIcon.classList.remove('show'), 600);
			}

			/* ── Mouth ── */
			let mouthTimer = null;
			function setMouth(open) {
				if (mouthClosed) mouthClosed.style.display = open ? 'none' : '';
				if (mouthOpen)   mouthOpen.style.display   = open ? '' : 'none';
			}

			/* ── Blink ── */
			let blinkTimer = null;
			function doBlink() {
				if (!eyelidL || !eyelidR) return;
				eyelidL.style.transition = 'transform 0.07s ease-in';
				eyelidR.style.transition = 'transform 0.07s ease-in';
				eyelidL.style.transform  = 'scaleY(1)';
				eyelidR.style.transform  = 'scaleY(1)';
				setTimeout(() => {
					eyelidL.style.transition = 'transform 0.10s ease-out';
					eyelidR.style.transition = 'transform 0.10s ease-out';
					eyelidL.style.transform  = 'scaleY(0)';
					eyelidR.style.transform  = 'scaleY(0)';
				}, 130);
				blinkTimer = setTimeout(doBlink, 2600 + Math.random() * 3400);
			}
			function startBlink() { blinkTimer = setTimeout(doBlink, 1200 + Math.random() * 1800); }
			function stopBlink()  { clearTimeout(blinkTimer); blinkTimer = null; }

			/* ── Background cycle ── */
			let bgTimer = null;
			function cycleBg() {
				expBg.style.background = BG_SETS[bgIdx % BG_SETS.length];
				bgIdx++;
			}
			function startBgCycle() { cycleBg(); bgTimer = setInterval(cycleBg, 9000); }
			function stopBgCycle()  { clearInterval(bgTimer); bgTimer = null; }

			/* ── Progress RAF ── */
			function timeFrame(now) {
				if (timeStart === null) timeStart = now;
				const dt  = timeAccum + (now - timeStart);
				const pct = Math.min(1, dt / (totalSeconds * 1000));
				progressFill.style.width  = (pct * 100) + '%';
				ctrlTime.textContent = fmtMs(dt) + ' / ' + fmtSecs(totalSeconds);
				if (pct < 1) timeRaf = requestAnimationFrame(timeFrame);
			}

			/* ── Speech synthesis ── */
			const synth = window.speechSynthesis;
			let utter       = null;
			let chromePatch = null;

			function pickVoice() {
				const voices = synth.getVoices();
				const names = [
					'Google UK English Male',
					'Microsoft Guy Online (Natural) - English (United States)',
					'Microsoft David Desktop - English (United States)',
					'Daniel', 'Alex', 'Fred',
				];
				for (const n of names) {
					const v = voices.find(v => v.name === n);
					if (v) return v;
				}
				return voices.find(v => v.lang && v.lang.toLowerCase().startsWith('en')) || null;
			}

			function startSpeech() {
				if (!synth) return;
				synth.cancel();
				utter = new SpeechSynthesisUtterance(script);
				utter.rate   = 0.92;
				utter.pitch  = 1.0;
				utter.volume = 1.0;

				const applyVoice = () => { const v = pickVoice(); if (v) utter.voice = v; };
				if (synth.getVoices().length > 0) applyVoice();
				else synth.addEventListener('voiceschanged', applyVoice, { once: true });

				utter.onboundary = (e) => {
					if (e.name === 'word') {
						setMouth(true);
						clearTimeout(mouthTimer);
						mouthTimer = setTimeout(() => setMouth(false), 185);
					}
				};
				utter.onend   = () => { clearInterval(chromePatch); setMouth(false); onEnd(); };
				utter.onerror = () => { clearInterval(chromePatch); setMouth(false); };

				synth.speak(utter);

				/* Chrome stops speech after ~15s without this */
				chromePatch = setInterval(() => {
					if (!synth.speaking) { clearInterval(chromePatch); return; }
					synth.pause(); synth.resume();
				}, 14000);
			}

			function pauseSpeech() {
				if (synth.speaking && !synth.paused) synth.pause();
				clearInterval(chromePatch);
			}
			function resumeSpeech() {
				if (synth.paused) {
					synth.resume();
					chromePatch = setInterval(() => {
						if (!synth.speaking) { clearInterval(chromePatch); return; }
						synth.pause(); synth.resume();
					}, 14000);
				}
			}
			function stopSpeech() {
				synth.cancel();
				clearInterval(chromePatch);
				setMouth(false);
			}

			function onEnd() {
				ended = true; started = false; paused = false;
				cancelAnimationFrame(timeRaf); timeRaf = null;
				progressFill.style.width = '100%';
				ctrlTime.textContent = fmtSecs(totalSeconds) + ' / ' + fmtSecs(totalSeconds);
				setIcons(false);
				playerEl.classList.remove('playing');
				playerEl.classList.add('ended');
				stopBlink(); stopBgCycle(); setMouth(false);
			}

			/* ── Play / Pause / Reset ── */
			function play() {
				if (ended) return;
				paused = false; started = true;
				playerEl.classList.add('playing');
				playerEl.classList.remove('ended');
				setIcons(true);

				if (!synth.speaking && !synth.paused) startSpeech();
				else if (synth.paused) resumeSpeech();

				timeStart = null;
				timeRaf = requestAnimationFrame(timeFrame);
				startBlink();
				if (!bgTimer) startBgCycle();
			}

			function pause() {
				paused = true;
				pauseSpeech();
				setMouth(false);
				if (timeStart !== null) { timeAccum += performance.now() - timeStart; timeStart = null; }
				cancelAnimationFrame(timeRaf); timeRaf = null;
				setIcons(false);
				stopBlink();
			}

			function togglePlayPause() {
				if (ended || !started) return;
				if (paused) { play(); flashCentre(true); }
				else        { pause(); flashCentre(false); }
			}

			function reset() {
				stopSpeech();
				cancelAnimationFrame(timeRaf);
				stopBlink(); stopBgCycle();
				timeStart = null; timeAccum = 0;
				ended = false; paused = false; started = false; bgIdx = 0;
				progressFill.style.width = '0%';
				ctrlTime.textContent = '0:00 / ' + fmtSecs(totalSeconds);
				setIcons(false);
				playerEl.classList.remove('playing', 'ended');
				setMouth(false);
			}

			/* ── Events ── */
			posterPlay.addEventListener('click', (e) => { e.stopPropagation(); play(); });
			explainer.addEventListener('click', togglePlayPause);

			ctrlPlayPause.addEventListener('click', (e) => {
				e.stopPropagation();
				if (!started) { play(); flashCentre(true); return; }
				togglePlayPause();
			});

			endReplay.addEventListener('click', (e) => { e.stopPropagation(); reset(); play(); });

			progressRail.addEventListener('click', (e) => {
				e.stopPropagation();
				if (!started) return;
				const rect = progressRail.getBoundingClientRect();
				const pct  = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
				timeAccum  = pct * totalSeconds * 1000;
				if (timeStart !== null) timeStart = performance.now();
				progressFill.style.width = (pct * 100) + '%';
				ctrlTime.textContent = fmtMs(timeAccum) + ' / ' + fmtSecs(totalSeconds);
			});

			ctrlFullscreen.addEventListener('click', (e) => {
				e.stopPropagation();
				if (!document.fullscreenElement) playerEl.requestFullscreen?.();
				else document.exitFullscreen?.();
			});

			likeBtn.addEventListener('click', () => {
				const liked = likeBtn.dataset.liked === '1';
				likeBtn.dataset.liked    = liked ? '0' : '1';
				likeBtn.style.color      = liked ? '' : '#f4c27a';
				likeBtn.style.background = liked ? '' : '#3d2e00';
			});

			document.addEventListener('keydown', (e) => {
				if (e.code === 'Space' && e.target === document.body) {
					e.preventDefault();
					if (!started) play(); else togglePlayPause();
				}
			});

			document.addEventListener('visibilitychange', () => {
				if (document.hidden && started && !paused) pause();
			});
		</script>
	</body>
</html>
