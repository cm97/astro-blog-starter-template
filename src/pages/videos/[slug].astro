---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { EXPLAINER_VIDEOS, getVideo, fmtTime } from '../../data/videos';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const video = getVideo(slug);
if (!video) {
	return Astro.redirect('/videos');
}
const queue = EXPLAINER_VIDEOS.filter((v) => v.slug !== video.slug);
const slideDurMs = Math.round((video.seconds / video.slides.length) * 1000);
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${video.title} — Buzzyfly Videos`} description={video.description} />
		<style>
			body.yt-page { background:#0f0f0f; color:#f1f1f1; margin:0; }
			body.yt-page header, body.yt-page footer { background:#111 !important; box-shadow:none !important; border-bottom:1px solid #222; }
			body.yt-page header nav a, body.yt-page header h2 a, body.yt-page footer a, body.yt-page footer p { color:#f1f1f1 !important; }
			.yt { max-width:1280px; margin:0 auto; padding:16px 16px 48px; }
			.yt-stage { display:grid; grid-template-columns:minmax(0,1fr) 402px; gap:24px; }

			/* ── Player shell ── */
			.player {
				position: relative;
				aspect-ratio: 16/9;
				border-radius: 12px;
				overflow: hidden;
				background: #000;
				cursor: pointer;
				user-select: none;
			}

			/* Real video — hidden until src loads */
			.player video {
				display: none;
				width: 100%; height: 100%;
				object-fit: cover;
			}
			.player.has-video video { display: block; }
			.player.has-video .slide-player { display: none; }

			/* ── Slide player ── */
			.slide-player {
				position: absolute;
				inset: 0;
				display: flex;
				flex-direction: column;
				justify-content: center;
				padding: 8%;
				background: linear-gradient(135deg, #1a1208, #3d2a12 55%, #0f0f0f);
				overflow: hidden;
			}

			/* Animated content area */
			.slide-content {
				opacity: 1;
				transform: translateY(0);
				transition: opacity 0.45s ease, transform 0.45s ease;
			}
			.slide-content.exit {
				opacity: 0;
				transform: translateY(-12px);
			}
			.slide-content.enter {
				opacity: 0;
				transform: translateY(14px);
			}

			.s-kicker {
				color: #f4c27a;
				letter-spacing: .12em;
				text-transform: uppercase;
				font-size: .8rem;
				margin: 0 0 .5rem;
				font-weight: 700;
			}
			.s-line {
				font-size: clamp(1.3rem, 3.2vw, 2.4rem);
				font-weight: 700;
				line-height: 1.2;
				margin: 0 0 .6rem;
				color: #fff;
			}
			.s-sub {
				color: #d4d4d4;
				font-size: clamp(.88rem, 1.6vw, 1.1rem);
				max-width: 36rem;
				margin: 0;
				line-height: 1.5;
			}

			/* Progress bar */
			.s-progress {
				position: absolute;
				bottom: 0; left: 0; right: 0;
				height: 3px;
				background: rgba(255,255,255,0.15);
			}
			.s-progress-fill {
				height: 100%;
				background: #f4c27a;
				width: 0%;
				transition: none;
			}

			/* Pause indicator */
			.s-status {
				position: absolute;
				top: 12px; right: 14px;
				font-size: 11px;
				color: rgba(255,255,255,0.45);
				letter-spacing: .06em;
				text-transform: uppercase;
			}

			/* ── Meta ── */
			.meta h1 { font-size: 1.2rem; margin: 14px 0 6px; color: #fff; line-height: 1.35; }
			.stats { color: #aaa; font-size: .88rem; margin: 0 0 10px; }
			.channel { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
			.avatar { width: 40px; height: 40px; border-radius: 50%; background: #c97820; display: grid; place-items: center; font-weight: 800; font-size: 1.1rem; flex-shrink: 0; }
			.desc { color: #ccc; font-size: .9rem; margin: 0; max-width: 46rem; line-height: 1.55; }

			/* ── Queue ── */
			.queue { display: flex; flex-direction: column; gap: 8px; max-height: 78vh; overflow: auto; }
			.queue-label { font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #777; margin: 0 0 4px; }
			.card { display: grid; grid-template-columns: 168px 1fr; gap: 10px; color: inherit; text-decoration: none; padding: 6px; border-radius: 10px; transition: background 0.15s; }
			.card:hover { background: #2a2a2a; }
			.card.active-card { background: #2a2a2a; border-left: 2px solid #f4c27a; padding-left: 4px; }
			.thumb { position: relative; aspect-ratio: 16/9; border-radius: 8px; background: #2b1c0d; overflow: hidden; flex-shrink: 0; }
			.thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
			.dur { position: absolute; right: 5px; bottom: 5px; background: rgba(0,0,0,.85); color: #fff; font-size: 11px; padding: 1px 4px; border-radius: 3px; }
			.card h3 { font-size: .88rem; margin: 0 0 4px; line-height: 1.3; color: #fff; }
			.card p { margin: 0; color: #999; font-size: .76rem; }

			@media (max-width: 960px) { .yt-stage { grid-template-columns: 1fr; } .queue { max-height: none; } }
			@media (max-width: 540px) { .card { grid-template-columns: 120px 1fr; } }
		</style>
	</head>
	<body class="yt-page">
		<Header />
		<main class="yt">
			<section class="yt-stage">
				<div>
					<div class="player" id="player">
						<!-- Real video (hidden until mp4 loads) -->
						<video id="vid" controls playsinline poster={video.poster} preload="none">
							<source src={video.src} type="video/mp4" />
						</video>

						<!-- Slide player (always visible until real video takes over) -->
						<div class="slide-player" id="slidePlr">
							<div class="slide-content" id="slideContent">
								<p class="s-kicker" id="sKicker">{video.slides[0][0]}</p>
								<p class="s-line"   id="sLine"  >{video.slides[0][1]}</p>
								<p class="s-sub"    id="sSub"   >{video.slides[0][2]}</p>
							</div>
							<div class="s-progress">
								<div class="s-progress-fill" id="sBar"></div>
							</div>
							<span class="s-status" id="sStatus">▶ playing</span>
						</div>
					</div>

					<div class="meta">
						<h1>{video.title}</h1>
						<p class="stats">{video.views} views · {video.date} · {fmtTime(video.seconds)}</p>
						<div class="channel">
							<div class="avatar">B</div>
							<div>
								<strong>Buzzyfly</strong>
								<div style="color:#aaa;font-size:.8rem">Official explainers</div>
							</div>
						</div>
						<p class="desc">{video.description}</p>
					</div>
				</div>

				<aside class="queue">
					<p class="queue-label">Up next</p>
					{queue.map((v) => (
						<a class={`card ${v.slug === slug ? 'active-card' : ''}`} href={`/videos/${v.slug}`}>
							<div class="thumb">
								<img src={v.poster} alt="" loading="lazy" />
								<span class="dur">{fmtTime(v.seconds)}</span>
							</div>
							<div>
								<h3>{v.title}</h3>
								<p>Buzzyfly · {v.views} views · {v.date}</p>
							</div>
						</a>
					))}
				</aside>
			</section>
		</main>
		<Footer />

		<script is:inline define:vars={{ slides: video.slides, slideDurMs }}>
			const player     = document.getElementById('player');
			const vid        = document.getElementById('vid');
			const sContent   = document.getElementById('slideContent');
			const sKicker    = document.getElementById('sKicker');
			const sLine      = document.getElementById('sLine');
			const sSub       = document.getElementById('sSub');
			const sBar       = document.getElementById('sBar');
			const sStatus    = document.getElementById('sStatus');

			let idx = 0;
			let paused = false;
			let startTime = null;
			let rafId = null;
			let elapsed = 0; // ms accumulated before current RAF segment

			/* ── Progress bar animation via RAF ── */
			function animBar(ts) {
				if (paused) return;
				if (startTime === null) startTime = ts;
				const pct = Math.min(100, ((elapsed + ts - startTime) / slideDurMs) * 100);
				sBar.style.width = pct + '%';
				if (pct < 100) {
					rafId = requestAnimationFrame(animBar);
				} else {
					advance();
				}
			}

			function startBar() {
				startTime = null;
				rafId = requestAnimationFrame(animBar);
			}

			/* ── Slide transition ── */
			function showSlide(i) {
				const s = slides[i];
				// exit current
				sContent.classList.add('exit');
				setTimeout(() => {
					sKicker.textContent = s[0];
					sLine.textContent   = s[1];
					sSub.textContent    = s[2];
					sBar.style.width = '0%';
					sContent.classList.remove('exit');
					sContent.classList.add('enter');
					requestAnimationFrame(() => requestAnimationFrame(() => {
						sContent.classList.remove('enter');
					}));
					elapsed = 0;
					startBar();
				}, 420);
			}

			function advance() {
				idx = (idx + 1) % slides.length;
				showSlide(idx);
			}

			/* ── Pause / resume on click ── */
			player.addEventListener('click', () => {
				if (player.classList.contains('has-video')) return; // let real video handle it
				paused = !paused;
				sStatus.textContent = paused ? '⏸ paused' : '▶ playing';
				if (!paused) {
					elapsed = parseFloat(sBar.style.width || '0') / 100 * slideDurMs;
					startTime = null;
					rafId = requestAnimationFrame(animBar);
				} else {
					cancelAnimationFrame(rafId);
					// record how far through we were
					elapsed = parseFloat(sBar.style.width || '0') / 100 * slideDurMs;
				}
			});

			/* ── If a real MP4 exists, let the native player take over ── */
			vid.addEventListener('canplay', () => {
				player.classList.add('has-video');
				cancelAnimationFrame(rafId);
			});

			/* ── Start immediately ── */
			startBar();
		</script>
	</body>
</html>
