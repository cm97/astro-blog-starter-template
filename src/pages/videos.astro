---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Buzzyfly Videos"
			description="Original explainer videos for the Buzzyfly Digital System."
		/>
		<style>
			body.yt-page { background:#0f0f0f; color:#f1f1f1; margin:0; }
			body.yt-page header, body.yt-page footer { background:#0f0f0f !important; box-shadow:none !important; color:#f1f1f1; }
			body.yt-page header nav a, body.yt-page header h2 a, body.yt-page footer a, body.yt-page footer p { color:#f1f1f1 !important; }
			.yt { max-width:1280px; margin:0 auto; padding:16px 16px 48px; }
			.yt-stage { display:grid; grid-template-columns:minmax(0,1fr) 402px; gap:24px; align-items:start; }
			.player { background:#000; border-radius:12px; overflow:hidden; aspect-ratio:16/9; }
			.player video { width:100%; height:100%; display:block; object-fit:contain; background:#000; }
			.meta h1 { font-size:1.25rem; margin:14px 0 6px; }
			.stats { color:#aaa; font-size:0.9rem; margin:0 0 10px; }
			.channel { display:flex; align-items:center; gap:10px; }
			.avatar { width:40px; height:40px; border-radius:50%; background:#c97820; display:grid; place-items:center; font-weight:800; }
			.queue { display:flex; flex-direction:column; gap:10px; max-height:78vh; overflow:auto; }
			.card, .tile { background:transparent; border:0; color:inherit; text-align:left; cursor:pointer; padding:4px; border-radius:10px; }
			.card { display:grid; grid-template-columns:168px 1fr; gap:8px; }
			.card:hover, .card.active, .tile:hover { background:#3d3d3d; }
			.thumb { position:relative; aspect-ratio:16/9; border-radius:8px; overflow:hidden; background:#2b1c0d; }
			.thumb img { width:100%; height:100%; object-fit:cover; display:block; }
			.thumb span.dur { position:absolute; right:6px; bottom:6px; background:rgba(0,0,0,.8); color:#fff; font-size:11px; padding:1px 4px; border-radius:3px; }
			.card h3, .tile h3 { font-size:0.92rem; margin:0 0 4px; line-height:1.3; }
			.card p, .tile p { margin:0; color:#aaa; font-size:0.78rem; }
			.grid-wrap { margin-top:36px; }
			.grid-wrap h2 { font-size:1.05rem; margin:0 0 14px; }
			.grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:18px; }
			.tile { padding:0; }
			.tile .thumb { margin-bottom:8px; }
			@media (max-width:960px) { .yt-stage { grid-template-columns:1fr; } .queue { max-height:none; } }
		</style>
	</head>
	<body class="yt-page">
		<Header />
		<main class="yt">
			<section class="yt-stage">
				<div>
					<div class="player">
						<video id="vid" controls playsinline poster="/videos/meet-buzzyfly.jpg">
							<source src="/videos/meet-buzzyfly.mp4" type="video/mp4" />
						</video>
					</div>
					<div class="meta">
						<h1 id="title">Meet Buzzyfly — stop rebuilding onboarding from memory</h1>
						<p class="stats" id="stats">Original · 0:09 · Sep 11, 2026</p>
						<div class="channel">
							<div class="avatar">B</div>
							<div>
								<strong>Buzzyfly</strong>
								<div style="color:#aaa;font-size:0.8rem">Official explainers</div>
							</div>
						</div>
					</div>
				</div>
				<aside class="queue" id="queue"></aside>
			</section>
			<section class="grid-wrap">
				<h2>More from Buzzyfly</h2>
				<div class="grid" id="grid"></div>
			</section>
		</main>
		<Footer />
		<script is:inline>
			const videos = [
				{ src: '/videos/meet-buzzyfly.mp4', poster: '/videos/meet-buzzyfly.jpg', title: 'Meet Buzzyfly — stop rebuilding onboarding from memory', dur: '0:09' },
				{ src: '/videos/how-to-use.mp4', poster: '/videos/how-to-use.jpg', title: 'How to use Buzzyfly after you download the zip', dur: '0:09' },
				{ src: '/videos/whats-in-the-zip.mp4', poster: '/videos/whats-in-the-zip.jpg', title: 'What is actually in the Digital System zip', dur: '0:09' },
				{ src: '/videos/advantages.mp4', poster: '/videos/advantages.jpg', title: 'Why people buy Buzzyfly — the advantages', dur: '0:09' },
				{ src: '/videos/weekly-reset.mp4', poster: '/videos/weekly-reset.jpg', title: 'Weekly Reset Checklist — $15, 20 minutes', dur: '0:09' },
				{ src: '/videos/onboarding-kit.mp4', poster: '/videos/onboarding-kit.jpg', title: 'Client Onboarding Kit — $29 walkthrough', dur: '0:09' },
				{ src: '/videos/follow-up-emails.mp4', poster: '/videos/follow-up-emails.jpg', title: 'Follow-Up Email Templates — $19', dur: '0:09' },
				{ src: '/videos/complete-bundle.mp4', poster: '/videos/complete-bundle.jpg', title: 'Complete Business Bundle — $97, everything', dur: '0:09' }
			];
			let current = 0;
			const vid = document.getElementById('vid');
			function load(i, play) {
				current = i;
				vid.poster = videos[i].poster;
				vid.src = videos[i].src;
				document.getElementById('title').textContent = videos[i].title;
				document.getElementById('stats').textContent = 'Original \u00b7 ' + videos[i].dur + ' \u00b7 Sep 11, 2026';
				render();
				if (play) vid.play();
			}
			function card(v, i, cls) {
				return '<button class="' + cls + (i === current ? ' active' : '') + '" data-i="' + i + '"><div class="thumb"><img src="' + v.poster + '" alt=""><span class="dur">' + v.dur + '</span></div>' + (cls === 'card' ? '<div>' : '') + '<h3>' + v.title + '</h3><p>Buzzyfly \u00b7 original</p>' + (cls === 'card' ? '</div>' : '') + '</button>';
			}
			function render() {
				document.getElementById('queue').innerHTML = videos.map((v, i) => card(v, i, 'card')).join('');
				document.getElementById('grid').innerHTML = videos.map((v, i) => card(v, i, 'tile')).join('');
			}
			document.addEventListener('click', (e) => {
				const b = e.target.closest('[data-i]');
				if (!b) return;
				load(Number(b.getAttribute('data-i')), true);
			});
			vid.addEventListener('ended', () => { if (current < videos.length - 1) load(current + 1, true); });
			render();
		</script>
	</body>
</html>
