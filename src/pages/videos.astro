---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { EXPLAINER_VIDEOS, fmtTime } from '../data/videos';

export const prerender = false;

const featured = EXPLAINER_VIDEOS[0];
const rest = EXPLAINER_VIDEOS.slice(1);
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Buzzyfly Videos" description="Official explainer videos for the Buzzyfly Digital System." />
		<style>
			body.yt-page { background:#0f0f0f; color:#f1f1f1; margin:0; }
			body.yt-page header, body.yt-page footer { background:#0f0f0f !important; box-shadow:none !important; }
			body.yt-page header nav a, body.yt-page header h2 a, body.yt-page footer a, body.yt-page footer p { color:#f1f1f1 !important; }
			.yt { max-width:1280px; margin:0 auto; padding:16px 16px 48px; }
			.yt-stage { display:grid; grid-template-columns:minmax(0,1fr) 402px; gap:24px; }
			.hero { display:block; color:inherit; text-decoration:none; }
			.hero-thumb { position:relative; aspect-ratio:16/9; border-radius:12px; overflow:hidden; background:#1a1208; }
			.hero-thumb img { width:100%; height:100%; object-fit:cover; display:block; }
			.hero-thumb .play { position:absolute; inset:0; display:grid; place-items:center; font-size:48px; color:#fff; text-shadow:0 2px 12px #000; }
			.hero h1 { font-size:1.25rem; margin:14px 0 6px; color:#fff; }
			.stats { color:#aaa; font-size:.9rem; margin:0 0 10px; }
			.queue, .grid { display:flex; flex-direction:column; gap:10px; }
			.card { display:grid; grid-template-columns:168px 1fr; gap:8px; color:inherit; text-decoration:none; padding:4px; border-radius:10px; }
			.card:hover, .tile:hover { background:#3d3d3d; }
			.thumb { position:relative; aspect-ratio:16/9; border-radius:8px; overflow:hidden; background:#2b1c0d; }
			.thumb img { width:100%; height:100%; object-fit:cover; display:block; }
			.dur { position:absolute; right:6px; bottom:6px; background:rgba(0,0,0,.8); color:#fff; font-size:11px; padding:1px 4px; border-radius:3px; }
			.card h3, .tile h3 { font-size:.92rem; margin:0 0 4px; line-height:1.3; color:#fff; }
			.card p, .tile p { margin:0; color:#aaa; font-size:.78rem; }
			.grid-wrap { margin-top:36px; }
			.grid-wrap h2 { font-size:1.05rem; margin:0 0 14px; }
			.grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:18px; }
			.tile { text-decoration:none; color:inherit; }
			.tile .thumb { margin-bottom:8px; }
			@media (max-width:960px) { .yt-stage { grid-template-columns:1fr; } }
		</style>
	</head>
	<body class="yt-page">
		<Header />
		<main class="yt">
			<section class="yt-stage">
				<a class="hero" href={`/videos/${featured.slug}`}>
					<div class="hero-thumb">
						<img src={featured.poster} alt="" />
						<div class="play">▶</div>
					</div>
					<h1>{featured.title}</h1>
					<p class="stats">{featured.views} views · {featured.date} · {fmtTime(featured.seconds)}</p>
				</a>
				<aside class="queue">
					{rest.map((v) => (
						<a class="card" href={`/videos/${v.slug}`}>
							<div class="thumb">
								<img src={v.poster} alt="" />
								<span class="dur">{fmtTime(v.seconds)}</span>
							</div>
							<div>
								<h3>{v.title}</h3>
								<p>Buzzyfly · {v.views} views · {v.date}</p>
							</div>
						</a>
					))}
				</aside>
			</section>
			<section class="grid-wrap">
				<h2>More from Buzzyfly</h2>
				<div class="grid">
					{EXPLAINER_VIDEOS.map((v) => (
						<a class="tile" href={`/videos/${v.slug}`}>
							<div class="thumb">
								<img src={v.poster} alt="" />
								<span class="dur">{fmtTime(v.seconds)}</span>
							</div>
							<h3>{v.title}</h3>
							<p>Buzzyfly · {v.views} views · {v.date}</p>
						</a>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
