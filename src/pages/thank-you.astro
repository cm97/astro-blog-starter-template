---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { BUZZYFLY_CONFIG, ALL_PRODUCTS, UPSELL_MAP } from "../data/monetization";
import { env } from "cloudflare:workers";

export const prerender = false;

// Stripe passes the session ID in ?s= when the Payment Link success URL is
// https://buzzyfly.com/thank-you?s={CHECKOUT_SESSION_ID}
const sessionId = Astro.url.searchParams.get("s") ?? "";

// Look up what they bought from D1 so we can show a targeted upsell.
let purchasedItemId: string | null = null;
if (sessionId && env?.DB) {
	try {
		const row = await env.DB.prepare(
			`SELECT item_id FROM fulfillments WHERE order_id = ? LIMIT 1`,
		)
			.bind(sessionId)
			.first<{ item_id: string }>();
		if (row) purchasedItemId = row.item_id;
	} catch {
		// non-critical — upsell degrades gracefully to the bundle
	}
}

const upsellId = purchasedItemId ? UPSELL_MAP[purchasedItemId] : "complete-business-bundle";
const upsell = upsellId ? ALL_PRODUCTS.find((p) => p.id === upsellId) ?? null : null;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Order confirmed — ${BUZZYFLY_CONFIG.brandName}`}
			description="Your order is confirmed. Check your email for your download link."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="ty-hero">
				<div class="ty-check">✓</div>
				<h1>You're all set.</h1>
				<p class="ty-lede">
					Your download link is on its way to the email address you checked out with.
					It should arrive within a few minutes.
				</p>
				<p class="ty-note">
					If you don't see it, check your spam folder. Still nothing after 10 minutes?
					Email <a href={`mailto:${BUZZYFLY_CONFIG.orderEmail}`}>{BUZZYFLY_CONFIG.orderEmail}</a>
					and you'll get a person, not a ticket queue.
				</p>
			</section>

			{upsell && (
				<section class="ty-upsell">
					<p class="ty-upsell__eyebrow">Before you go</p>
					<h2 class="ty-upsell__title">{upsell.title}</h2>
					<p class="ty-upsell__desc">{upsell.description}</p>
					<ul class="ty-upsell__features">
						{upsell.features.map((f) => <li>{f}</li>)}
					</ul>
					<div class="ty-upsell__cta-row">
						<a class="ty-upsell__cta" href={upsell.stripeUrl} target="_blank" rel="noopener noreferrer">
							Add {upsell.title} — {upsell.price}
						</a>
						<span class="ty-upsell__guarantee">One-time payment. 30-day money-back guarantee.</span>
					</div>
				</section>
			)}

			<div class="ty-actions">
				<a class="btn btn--primary" href="/products">See all products</a>
				<a class="btn btn--secondary" href="/blog">Read the blog</a>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.ty-hero {
		text-align: center;
		max-width: 540px;
		margin: 4em auto 2em;
		padding: 0 1em;
	}
	.ty-check {
		width: 64px;
		height: 64px;
		background: #1a7a3c;
		color: #fff;
		font-size: 2em;
		font-weight: 700;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 1em;
	}
	.ty-hero h1 {
		font-size: 2.2em;
		margin: 0 0 0.4em;
	}
	.ty-lede {
		font-size: 1.1em;
		color: rgb(var(--gray-dark));
		line-height: 1.65;
		margin: 0 0 1em;
	}
	.ty-note {
		font-size: 0.9em;
		color: rgb(var(--gray));
		line-height: 1.6;
		margin: 0;
	}

	.ty-upsell {
		max-width: 560px;
		margin: 0 auto 2.5em;
		padding: 1.75em;
		border: 2px solid var(--accent);
		border-radius: 14px;
		background: rgba(var(--accent-rgb, 31 77 58), 0.03);
	}
	.ty-upsell__eyebrow {
		font-size: 0.75em;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: var(--accent);
		font-weight: 700;
		margin: 0 0 0.5em;
	}
	.ty-upsell__title {
		font-size: 1.4em;
		margin: 0 0 0.4em;
	}
	.ty-upsell__desc {
		color: rgb(var(--gray-dark));
		font-size: 0.95em;
		line-height: 1.6;
		margin: 0 0 1em;
	}
	.ty-upsell__features {
		list-style: none;
		padding: 0;
		margin: 0 0 1.5em;
	}
	.ty-upsell__features li {
		font-size: 0.88em;
		color: rgb(var(--gray-dark));
		padding: 0.3em 0 0.3em 1.4em;
		position: relative;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.ty-upsell__features li:last-child { border-bottom: none; }
	.ty-upsell__features li::before {
		content: "✓";
		position: absolute;
		left: 0;
		color: #1a7a3c;
		font-weight: 700;
	}
	.ty-upsell__cta-row {
		display: flex;
		align-items: center;
		gap: 1em;
		flex-wrap: wrap;
	}
	.ty-upsell__cta {
		display: inline-block;
		padding: 0.75em 1.5em;
		border-radius: 999px;
		background: var(--accent);
		color: #fff;
		font-weight: 700;
		text-decoration: none;
		font-size: 0.95em;
		transition: background-color 0.15s;
		white-space: nowrap;
	}
	.ty-upsell__cta:hover { background: var(--accent-dark); color: #fff; }
	.ty-upsell__guarantee {
		font-size: 0.75em;
		color: rgb(var(--gray));
	}

	.ty-actions {
		display: flex;
		gap: 0.75em;
		justify-content: center;
		flex-wrap: wrap;
		margin-bottom: 3em;
	}
	.btn {
		display: inline-block;
		padding: 0.75em 1.75em;
		border-radius: 999px;
		font-weight: 700;
		text-decoration: none;
		transition: background-color 0.15s;
	}
	.btn--primary { background: var(--accent); color: #fff; }
	.btn--primary:hover { background: var(--accent-dark); color: #fff; }
	.btn--secondary {
		border: 2px solid rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
	}
	.btn--secondary:hover { border-color: var(--accent); color: var(--accent); }
</style>
