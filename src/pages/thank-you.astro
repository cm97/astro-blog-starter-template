---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { BUZZYFLY_CONFIG } from "../data/monetization";

export const prerender = false;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Order confirmed — ${BUZZYFLY_CONFIG.brandName}`}
			description="Your order is confirmed. Open the app."
		/>
		<meta name="robots" content="noindex" />
	</head>
	<body>
		<Header />
		<main>
			<section class="ty-hero">
				<div class="ty-check">✓</div>
				<h1>Your app is ready.</h1>
				<p class="ty-lede">Thanks for buying the Buzzyfly Digital System.</p>
				<p><a class="btn btn--primary" href="/app">Open the app</a></p>
				<p class="ty-note">
					No download. Bookmark /app or open it from your phone.
				</p>
				<p class="ty-note">
					Need help? Email
					<a href={`mailto:${BUZZYFLY_CONFIG.supportEmail}`}>{BUZZYFLY_CONFIG.supportEmail}</a>
					from the address you checked out with.
				</p>
			</section>

			<div class="ty-actions">
				<a class="btn btn--secondary" href="/store">Back to store</a>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.ty-hero {
		text-align: center;
		max-width: 540px;
		margin: 4em auto 2em;
		padding: 0 1em;
	}
	.ty-check {
		width: 64px;
		height: 64px;
		background: #1a7a3c;
		color: #fff;
		font-size: 2em;
		font-weight: 700;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 1em;
	}
	.ty-hero h1 {
		font-size: 2.2em;
		margin: 0 0 0.4em;
	}
	.ty-lede {
		font-size: 1.1em;
		color: rgb(var(--gray-dark));
		line-height: 1.65;
		margin: 0 0 1em;
	}
	.ty-note {
		font-size: 0.9em;
		color: rgb(var(--gray));
		line-height: 1.6;
		margin: 0.5em 0;
	}
	.ty-actions {
		display: flex;
		gap: 0.75em;
		justify-content: center;
		flex-wrap: wrap;
		margin-bottom: 3em;
	}
	.btn {
		display: inline-block;
		padding: 0.75em 1.75em;
		border-radius: 999px;
		font-weight: 700;
		text-decoration: none;
		transition: background-color 0.15s;
	}
	.btn--primary { background: var(--accent); color: #fff; }
	.btn--primary:hover { background: var(--accent-dark); color: #fff; }
	.btn--secondary {
		border: 2px solid rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
	}
	.btn--secondary:hover { border-color: var(--accent); color: var(--accent); }
</style>
