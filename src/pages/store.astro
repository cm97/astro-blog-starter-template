---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import EmailOptin from "../components/EmailOptin.astro";
import ProductCallout from "../components/ProductCallout.astro";
import MoneyPrinterBanner from "../components/MoneyPrinterBanner.astro";
import {
	AUTOMATIC_DELIVERY_ENABLED,
	ALL_PRODUCTS,
	BUZZYFLY_CONFIG,
	getOrderAction,
} from "../data/monetization";
import { getSettings } from "../lib/settings";

export const prerender = false;

const settings = await getSettings(Astro.locals.runtime?.env);
const system = ALL_PRODUCTS.find((p) => p.id === "buzzyfly-digital-system")!;
const systemDescription =
	settings.defaultProductDescription && settings.defaultProductDescription !== BUZZYFLY_CONFIG.defaultProductDescription
		? settings.defaultProductDescription
		: system.description;
const systemOrder = getOrderAction(system.id);
const singles = ALL_PRODUCTS.filter((p) => p.id !== system.id && p.id !== "complete-business-bundle");
const guarantee = "30-day refund if files were not delivered or are materially not what the listing described. No change-of-mind refunds after a valid download.";

const TRUST = [
	{ label: AUTOMATIC_DELIVERY_ENABLED ? "Download after purchase" : "Emailed after payment" },
	{ label: "No subscription" },
	{ label: "30-day delivery guarantee" },
	{ label: "Built by a solo creator" },
];

const CONTENTS = [
	{ folder: "checklists/", items: "onboarding, weekly reset, follow-up, intake, scope creep, retention" },
	{ folder: "templates/", items: "proposal, discovery questions, follow-up emails, one-page plan" },
	{ folder: "scripts/", items: "the 'how to say no' lines that keep the client" },
];

const FAQ = [
	{
		q: "Which one should I buy?",
		a: "Start with the $49 Digital System. It covers onboarding, weekly planning and follow-ups. Only need one piece? Grab that single kit. Want every file? Take the bundle.",
	},
	{
		q: "Is this a course?",
		a: "No. There are no videos to watch. You get plain checklists, templates and scripts. Open one and run it today.",
	},
	{
		q: "How do I get the files?",
		a: AUTOMATIC_DELIVERY_ENABLED
			? "Pay once through Stripe. Download from the thank-you page right after purchase."
			: "Pay once through Stripe. Your download is emailed to the address you checked out with.",
	},
	{
		q: "Do I need an account?",
		a: "No. There is no login and no subscription. Pay once and the files are yours to keep.",
	},
	{
		q: "What if it doesn't help?",
		a: guarantee,
	},
	{
		q: "Who is it not for?",
		a: "If you already run a documented system that works, skip it. You would be buying what you already have.",
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Store — ${BUZZYFLY_CONFIG.brandName}`}
			description="Run your client business from checklists, not memory. Onboarding, weekly planning and follow-up systems for coaches and solo service providers. One-time payment. 30-day delivery guarantee."
		/>
		<style>
			main { width: var(--max-width); }
			.store-hero { padding: var(--space-6) 0 var(--space-4); }
			.store-eyebrow { margin: 0 0 var(--space-2); font-size: 0.8em; font-weight: 600; color: var(--muted); }
			.store-hero h1 { font-size: clamp(2.1em, 7vw, 3.6em); line-height: 1.04; max-width: 13em; margin: 0 0 var(--space-3); }
			.store-lede { max-width: 32em; margin: 0 0 var(--space-4); color: rgb(var(--gray-dark)); font-size: 1.05em; }
			.store-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-3); }
			.store-cta { min-height: 56px; padding: 0 var(--space-4); font-size: 1.05em; }
			.store-secondary { display: inline-flex; align-items: center; min-height: 44px; font-size: 0.88em; color: var(--muted); }
			.trust-row { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); padding: var(--space-3) 0 0; margin: var(--space-4) 0 0; border-top: 1px solid var(--line); }
			.trust-row li { font-size: 0.8em; font-weight: 600; color: var(--muted); }
			.section-head { margin: var(--space-8) 0 0; }
			.section-head h2 { font-size: clamp(1.5em, 4.5vw, 2.1em); }
			.section-head p { color: var(--muted); margin: 0; }
			.featured-wrap { max-width: 760px; scroll-margin-top: var(--space-2); }
			.featured-wrap :global(.product-callout) { margin: var(--space-2) 0 0; }
			/* Two columns at most. No three-up feature grids. */
			.singles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: var(--space-2); max-width: 1000px; }
			@media (min-width: 1100px) { .singles { grid-template-columns: 1fr 1fr; } }
			.singles :global(.product-callout) { margin: var(--space-3) 0 0; font-size: 0.92em; }
			.store-section { max-width: 720px; margin: var(--space-8) 0 0; }
			.store-section h2 { font-size: 1.6em; }
			.contents-table { width: 100%; border-collapse: collapse; margin-top: var(--space-2); }
			.contents-table th, .contents-table td { text-align: left; padding: 12px var(--space-2) 12px 0; border-bottom: 1px solid var(--line); font-size: 0.9em; vertical-align: top; }
			.contents-table th { color: var(--muted); font-size: 0.78em; font-weight: 600; }
			.contents-table code { white-space: nowrap; }
			.faq details { border-bottom: 1px solid var(--line); }
			.faq summary { cursor: pointer; display: flex; align-items: center; min-height: 56px; box-sizing: border-box; font-weight: 600; color: var(--ink); }
			.faq summary::-webkit-details-marker { display: none; }
			.faq summary::after { content: "+"; margin-left: auto; padding-left: var(--space-2); color: var(--muted); }
			.faq details[open] summary::after { content: "–"; }
			.faq details p { margin: 0 0 var(--space-3); color: rgb(var(--gray-dark)); font-size: 0.95em; }
			.final-cta { margin: var(--space-8) 0 0; max-width: 760px; padding: var(--space-6) var(--space-3); border-radius: var(--radius-card); background: var(--surface); border: 1px solid var(--line); }
			.final-cta h2 { font-size: clamp(1.4em, 4.5vw, 1.9em); font-weight: 800; }
			.final-cta p { margin: var(--space-2) 0 0; font-size: 0.82em; color: var(--muted); }
			.final-cta + :global(.email-optin) { max-width: 760px; box-sizing: border-box; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="store-hero">
				<p class="store-eyebrow">For coaches, consultants and solo service providers</p>
				<h1>Run your client business from checklists, not memory.</h1>
				<p class="store-lede">
					You lose hours rebuilding onboarding emails. Proposals go quiet and you never follow up.
					Monday starts with a scramble. Pick the system that ends it.
				</p>
				<div class="store-actions">
					<a class="btn-primary store-cta" href={systemOrder.href}>Get the Digital System — {system.price}</a>
					<a class="store-secondary" href="#all-products">Or compare every product ↓</a>
				</div>
				<ul class="trust-row" aria-label="Why buying here is low risk">
					{TRUST.map((t) => <li>{t.label}</li>)}
				</ul>
			</section>

			<div class="featured-wrap" id="digital-system">
				<ProductCallout productId={system.id} description={systemDescription} featured headingLevel="h2" />
			</div>

			<section id="all-products" aria-labelledby="singles-heading">
				<div class="section-head">
					<h2 id="singles-heading">Only need one piece?</h2>
					<p>Fix the problem that hurts most this week.</p>
				</div>
				<div class="singles">
					{singles.map((p) => <ProductCallout productId={p.id} />)}
				</div>
			</section>

			<MoneyPrinterBanner variant="section" />

			<section class="store-section">
				<h2>What's actually in the Digital System zip</h2>
				<table class="contents-table">
					<thead><tr><th>Folder</th><th>Contains</th></tr></thead>
					<tbody>
						{CONTENTS.map((c) => (
							<tr><td><code>{c.folder}</code></td><td>{c.items}</td></tr>
						))}
					</tbody>
				</table>
				<p>
					The full file list is in <a href="/blog/product-contents/">What's Actually Inside</a>.
				</p>
			</section>

			<section class="store-section faq" aria-labelledby="faq-heading">
				<h2 id="faq-heading">Questions before you buy</h2>
				{FAQ.map((item) => (
					<details>
						<summary>{item.q}</summary>
						<p>{item.a}</p>
					</details>
				))}
			</section>

			<section class="final-cta">
				<h2>Stop rebuilding your process from memory.</h2>
				<a class="btn-primary store-cta" href={systemOrder.href}>Get the Digital System — {system.price}</a>
				<p>One-time payment. No subscription. {guarantee}</p>
			</section>

			<EmailOptin title="Not ready to buy? Start with the free checklist." />
		</main>
		<Footer />
	</body>
</html>
