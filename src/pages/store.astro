---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import EmailOptin from "../components/EmailOptin.astro";
import ProductCallout from "../components/ProductCallout.astro";
import PayPalLink from "../components/PayPalLink.astro";
import {
	ALL_PRODUCTS,
	BUZZYFLY_CONFIG,
	getOrderAction,
} from "../data/monetization";
import { getSettings } from "../lib/settings";

export const prerender = false;

const settings = await getSettings(Astro.locals.runtime?.env);
const system = ALL_PRODUCTS.find((p) => p.id === "buzzyfly-digital-system")!;
const systemDescription =
	settings.defaultProductDescription && settings.defaultProductDescription !== BUZZYFLY_CONFIG.defaultProductDescription
		? settings.defaultProductDescription
		: system.description;
const systemOrder = getOrderAction(system.id);
const singles = ALL_PRODUCTS.filter((p) => p.id !== system.id);
const guarantee = BUZZYFLY_CONFIG.guarantee;

// Product structured data for the one product on sale. The price comes from
// the product data, and there are no ratings or reviews because none exist yet.
const productLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Product',
	name: system.title,
	description: system.description,
	image: `${BUZZYFLY_CONFIG.siteUrl}/og-default.jpg`,
	url: `${BUZZYFLY_CONFIG.siteUrl}/store`,
	brand: { '@type': 'Brand', name: BUZZYFLY_CONFIG.brandName },
	offers: {
		'@type': 'Offer',
		price: system.price.replace(/[^0-9.]/g, ''),
		priceCurrency: 'USD',
		availability: 'https://schema.org/InStock',
		url: `${BUZZYFLY_CONFIG.siteUrl}/store`,
		seller: { '@type': 'Organization', name: BUZZYFLY_CONFIG.brandName, url: BUZZYFLY_CONFIG.siteUrl },
	},
}).replace(/</g, '\\u003c');

const TRUST = [
	{ icon: "⚡", label: "Open in your browser after purchase" },
	{ icon: "🔁", label: "No subscription" },
	{ icon: "🛡️", label: guarantee },
	{ icon: "🐝", label: "Built by a solo creator" },
];

const CONTENTS = [
	{ folder: "Today", items: "Who needs a follow-up today, onboarding steps due, and this week's #1 priority" },
	{ folder: "Follow-ups", items: "Every lead, proposal and client, with the next follow-up date worked out for you" },
	{ folder: "Email writer", items: "Emails that fill in the client's name, project and your sign-off. Copy and paste." },
	{ folder: "Onboarding", items: "A 10-step plan for each new client, with due dates and client notes" },
	{ folder: "Weekly reset", items: "A guided 20-minute Monday plan and priority scorer" },
	{ folder: "Proposals and pricing", items: "Your hourly floor, project and retainer prices" },
	{ folder: "Scope guard", items: "The exact words when a client asks for more than they paid for" },
];

const FAQ = [
	{
		q: "Which one should I buy?",
		a: "The $49 Digital System. It is the browser web app: follow-ups, onboarding, weekly reset, proposals and pricing. Everything runs in the browser. No download.",
	},
	{
		q: "Is this a course or a spreadsheet?",
		a: "No. It is a web app. Open it in your browser on phone or computer. No Excel, no files, no macros.",
	},
	{
		q: "How do I get it?",
		a: "Pay once through Stripe. After purchase you land in the app. No download.",
	},
	{
		q: "Do I need an account?",
		a: "No account or password. Your purchase comes with a private access link that unlocks the app. Your client list is saved on your own device, and you can back it up to move it to another one. No subscription.",
	},
	{
		q: "What is the refund policy?",
		a: guarantee,
	},
	{
		q: "Who is it not for?",
		a: "If you already run a documented system that works, skip it.",
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Store: Client Follow-Up and Onboarding App | ${BUZZYFLY_CONFIG.brandName}`}
			description="Run your client business from a browser web app, not memory. Follow-up, onboarding and weekly reset in one place. $49 one-time."
		/>
		<script type="application/ld+json" set:html={productLd} />
		<style>
			main { width: 1000px; }
			.store-hero { text-align: center; padding: 1em 0 1.5em; }
			.store-eyebrow { margin: 0 0 0.8em; font-size: 0.78em; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
			.store-hero h1 { font-size: clamp(1.8em, 6vw, 2.8em); line-height: 1.12; max-width: 15em; margin: 0 auto 0.5em; }
			.store-lede { max-width: 32em; margin: 0 auto 1.6em; color: rgb(var(--gray-dark)); font-size: 1.05em; }
			.store-cta { display: inline-flex; align-items: center; justify-content: center; min-height: 72px; max-width: 100%; white-space: normal; text-align: center; padding: 1.2em 3.2em; border-radius: 999px; background: var(--accent); color: #fff; font-weight: 800; font-size: 1.65em; text-decoration: none; box-shadow: 0 6px 18px rgba(35, 55, 255, 0.35); transition: background-color 0.15s ease-in-out, transform 0.15s ease-in-out, box-shadow 0.15s ease-in-out; }
			.store-cta:hover { background: var(--accent-dark); color: #fff; transform: translateY(-2px); box-shadow: 0 10px 24px rgba(0, 13, 138, 0.4); }
			.store-cta:active { transform: translateY(0); box-shadow: 0 3px 10px rgba(35, 55, 255, 0.35); }
			@media (max-width: 720px) { .store-cta { padding: 1em 1.8em; font-size: 1.35em; } }
			.store-secondary { display: inline-block; margin-top: 0.9em; font-size: 0.9em; padding: 0.6em 0.4em; }
			.trust-row { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6em; padding: 0; margin: 1.5em 0 0; }
			@media (max-width: 720px) { .trust-row { grid-template-columns: 1fr 1fr; } }
			.trust-row li { display: flex; align-items: center; justify-content: center; gap: 0.45em; padding: 0.7em 0.5em; border-radius: 10px; background: rgba(var(--gray-light), 55%); font-size: 0.82em; font-weight: 700; color: rgb(var(--gray-dark)); text-align: center; line-height: 1.3; }
			.section-head { text-align: center; margin: 2.5em 0 0; }
			.section-head h2 { font-size: clamp(1.4em, 4.5vw, 1.9em); }
			.section-head p { color: rgb(var(--gray)); margin: 0; }
			.featured-wrap { max-width: 640px; margin: 0 auto; scroll-margin-top: 1em; }
			.featured-wrap :global(.product-callout) { margin-top: 1.5em; }
			.singles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 0 1.5em; }
			.singles :global(.product-callout) { margin: 1.5em 0 0; font-size: 0.92em; }
			.store-section { max-width: 720px; margin: 3em auto 0; }
			.store-section h2 { font-size: 1.6em; }
			.contents-table { width: 100%; border-collapse: collapse; margin-top: 1em; }
			.contents-table th, .contents-table td { text-align: left; padding: 0.6em 0.8em; border-bottom: 1px solid rgb(var(--gray-light)); font-size: 0.92em; vertical-align: top; }
			.contents-table th { color: rgb(var(--gray)); font-size: 0.78em; text-transform: uppercase; letter-spacing: 0.05em; }
			.faq details { border-bottom: 1px solid rgb(var(--gray-light)); }
			.faq summary { cursor: pointer; padding: 0.7em 0; min-height: 44px; box-sizing: border-box; font-weight: 700; color: rgb(var(--black)); list-style-position: inside; }
			.faq details p { margin: 0 0 1em; color: rgb(var(--gray-dark)); font-size: 0.95em; }
			.final-cta { text-align: center; margin: 3em auto 0; max-width: 720px; padding: 2em 1em; border-radius: 16px; background: rgba(35, 55, 255, 0.05); border: 1px solid rgba(35, 55, 255, 0.15); }
			.final-cta h2 { font-size: clamp(1.3em, 4.5vw, 1.7em); }
			.final-cta p { margin: 0.8em 0 0; font-size: 0.85em; color: rgb(var(--gray-dark)); }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="store-hero">
				<p class="store-eyebrow">For coaches, consultants and solo service providers</p>
				<h1>Run your client business from a browser app, not memory.</h1>
				<p class="store-lede">
					You lose hours rebuilding onboarding emails. Proposals go quiet and you never follow up.
					Monday starts with a scramble. Open the app. See who needs you today and the email to send.
				</p>
				<a class="store-cta" href={systemOrder.href}>Get the Digital System — {system.price}</a>
				<br />
				{systemOrder.live && <PayPalLink href={systemOrder.paypalHref} />}
				<br />
				<a class="store-secondary" href="#digital-system">See what's inside ↓</a>
				<ul class="trust-row" aria-label="Why buying here is low risk">
					{TRUST.map((t) => <li><span aria-hidden="true">{t.icon}</span>{t.label}</li>)}
				</ul>
			</section>

			<div class="featured-wrap" id="digital-system">
				<ProductCallout productId={system.id} description={systemDescription} featured headingLevel="h2" />
			</div>

			<section id="all-products" aria-labelledby="singles-heading">
				<div class="section-head">
					<h2 id="singles-heading">Coming soon</h2>
					<p>Single tools, not for sale yet. Each one is already inside the Digital System app.</p>
				</div>
				<div class="singles">
					{singles.map((p) => <ProductCallout productId={p.id} />)}
				</div>
			</section>

			<section class="store-section">
				<h2>What's inside the Digital System app</h2>
				<table class="contents-table">
					<thead><tr><th>Screen</th><th>What it does</th></tr></thead>
					<tbody>
						{CONTENTS.map((c) => (
							<tr><td><strong>{c.folder}</strong></td><td>{c.items}</td></tr>
						))}
					</tbody>
				</table>
				<p>Works in any modern browser on phone or computer. No download. No Excel.</p>
			</section>

			<section class="store-section faq" aria-labelledby="faq-heading">
				<h2 id="faq-heading">Questions before you buy</h2>
				{FAQ.map((item) => (
					<details>
						<summary>{item.q}</summary>
						<p>{item.a}</p>
					</details>
				))}
			</section>

			<section class="final-cta">
				<h2>Stop rebuilding your process from memory.</h2>
				<a class="store-cta" href={systemOrder.href}>Get the Digital System — {system.price}</a>
				<br />
				{systemOrder.live && <PayPalLink href={systemOrder.paypalHref} />}
				<p>One-time payment. No subscription. {guarantee}</p>
			</section>

			<EmailOptin title="Not ready to buy? Start with the free checklist." />
		</main>
		<Footer />
	</body>
</html>
