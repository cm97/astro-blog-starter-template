---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import EmailOptin from "../components/EmailOptin.astro";
import {
	AUTOMATIC_DELIVERY_ENABLED,
	BUZZYFLY_CONFIG,
	getOrderAction,
} from "../data/monetization";
import { getSettings } from "../lib/settings";

export const prerender = false;

const settings = await getSettings(Astro.locals.runtime?.env);
const title = settings.defaultProductTitle || BUZZYFLY_CONFIG.defaultProductTitle;
const price = BUZZYFLY_CONFIG.defaultProductPrice;
const description = settings.defaultProductDescription || BUZZYFLY_CONFIG.defaultProductDescription;
const order = getOrderAction(title);

const INCLUDED = [
	"The core operating framework — the onboarding, weekly planning, and follow-up workflows",
	"The 20-minute weekly reset checklist, ready to run instead of rebuilt from scratch",
	"Lifetime access, including future updates to the system",
];

const CONTENTS = [
	{ folder: "checklists/", items: "onboarding, weekly reset, follow-up, intake, scope-creep, retention" },
	{ folder: "templates/", items: "proposal, discovery questions, follow-up emails, one-page plan" },
	{ folder: "scripts/", items: "the 'how to say no' lines that don't lose the client" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${title} — ${BUZZYFLY_CONFIG.brandName}`}
			description={description}
		/>
		<style>
			.store-hero { text-align: center; padding-bottom: 1em; border-bottom: 1px solid rgb(var(--gray-light)); }
			.store-eyebrow { margin: 0 0 0.4em 0; font-size: 0.8em; letter-spacing: 0.06em; text-transform: uppercase; color: rgb(var(--gray)); }
			.store-hero h1 { font-size: 2.6em; margin-bottom: 0.3em; }
			.store-lede { max-width: 32em; margin: 0 auto 1.4em; color: rgb(var(--gray-dark)); }
			.store-buy { display: flex; align-items: center; justify-content: center; gap: 1em; flex-wrap: wrap; }
			.store-price { font-size: 2.4em; font-weight: 800; color: rgb(var(--black)); }
			.store-cta { display: inline-block; padding: 1.15em 2.8em; border-radius: 999px; background: var(--accent); color: #fff; font-weight: 800; font-size: 1.4em; text-decoration: none; transition: background-color 0.15s ease-in-out; }
			.store-cta:hover { background: var(--accent-dark); color: #fff; }
			.store-microcopy { margin: 0.9em 0 0; font-size: 0.85em; color: rgb(var(--gray-dark)); }
			.store-section { margin-top: 2.5em; }
			.store-section h2 { font-size: 1.6em; }
			.store-list { padding-left: 1.2em; color: rgb(var(--gray-dark)); }
			.store-list li { margin-bottom: 0.5em; }
			.store-notice { padding: 1em 1.2em; border-radius: 12px; border: 1px solid rgb(var(--gray-light)); background: rgba(var(--gray-light), 40%); font-size: 0.95em; }
			.contents-table { width: 100%; border-collapse: collapse; margin-top: 1em; }
			.contents-table th, .contents-table td { text-align: left; padding: 0.6em 0.8em; border-bottom: 1px solid rgb(var(--gray-light)); font-size: 0.95em; }
			.contents-table th { color: rgb(var(--gray)); font-size: 0.8em; text-transform: uppercase; letter-spacing: 0.05em; }
			.contents-table code { background: rgb(var(--gray-light)); padding: 0.1em 0.4em; border-radius: 4px; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="store-hero">
				<p class="store-eyebrow">The core system. Everything most people need, in one download.</p>
				<h1>{title}</h1>
				<p class="store-lede">{description}</p>

				<div class="store-buy">
					<span class="store-price">{price}</span>
					{
						order.external ? (
							<a class="store-cta" href={order.href} target="_blank" rel="noopener noreferrer">{order.label} — Digital System</a>
						) : (
							<a class="store-cta" href={order.href}>{order.label} — Digital System</a>
						)
					}
				</div>
				<p class="store-microcopy">
					One-time payment. Download after purchase on the thank-you page. 30-day refund if the files are not delivered or not as listed.
				</p>
			</section>

			<section class="store-section">
				<h2>What you get</h2>
				<ul class="store-list">
					{INCLUDED.map((item) => <li>{item}</li>)}
				</ul>
				<p>
					The long version of why this exists is in
					<a href="/blog/first-post/">Why I Built the Buzzyfly Digital System</a>, and a
					plain contents list is in
					<a href="/blog/product-contents/">What's Actually Inside</a>.
				</p>
			</section>

			<section class="store-section">
				<h2>What's actually in the zip</h2>
				<table class="contents-table">
					<thead><tr><th>Folder</th><th>Contains</th></tr></thead>
					<tbody>
						{CONTENTS.map((c) => (
							<tr><td><code>{c.folder}</code></td><td>{c.items}</td></tr>
						))}
					</tbody>
				</table>
			</section>

			<section class="store-section">
				<h2>Who it's for</h2>
				<p>
					One- or few-person businesses where the process lives in someone's head. If
					onboarding a new client means rebuilding the same steps from memory, or
					follow-ups only happen when you remember them, this is aimed squarely at you.
				</p>
				<p>
					It is <strong>not</strong> for you if you already run a documented, working
					system — you'd be buying something you've already built.
				</p>
			</section>

			<section class="store-section">
				<h2>How it arrives</h2>
				{
					AUTOMATIC_DELIVERY_ENABLED ? (
						<ol class="store-list">
							<li>Pay securely through Stripe.</li>
							<li>Download after purchase on the thank-you page.</li>
							<li>The files are yours to keep. 30-day refund if the files are not delivered or not as listed.</li>
						</ol>
					) : (
						<>
							<ol class="store-list">
								<li>Pay securely through Stripe.</li>
								<li>Your download is emailed to the address you checked out with.</li>
								<li>The files are yours to keep.</li>
							</ol>
							<p class="store-notice">
								If the files are not delivered or not as listed, email
								<a href={`mailto:${BUZZYFLY_CONFIG.orderEmail}`}>
									{BUZZYFLY_CONFIG.orderEmail}
								</a>{" "}
								within 30 days for a refund.
							</p>
						</>
					)
				}
			</section>

			<section class="store-section">
				<h2>Ready to stop rebuilding it from memory?</h2>
				<div class="store-buy">
					<span class="store-price">{price}</span>
					{
						order.external ? (
							<a class="store-cta" href={order.href} target="_blank" rel="noopener noreferrer">{order.label} — Digital System</a>
						) : (
							<a class="store-cta" href={order.href}>{order.label} — Digital System</a>
						)
					}
				</div>
				<p class="store-microcopy">
					Other packs stay secondary. Start with the $49 Digital System. The <a href="/products">Complete Business Bundle</a> is the smaller add-on, not the main button.
				</p>
			</section>

			<section class="store-section">
				<h2>Questions</h2>
				<p>
					Anything at all —
					<a href={`mailto:${BUZZYFLY_CONFIG.orderEmail}`}>{BUZZYFLY_CONFIG.orderEmail}</a>.
					It's a small operation, so you're emailing the person who built it.
				</p>
			</section>

			<EmailOptin />
		</main>
		<Footer />
	</body>
</html>
