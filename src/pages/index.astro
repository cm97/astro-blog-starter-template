---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Placeholder copy below — swap in real brand messaging whenever it's ready.
const pillars = [
	{
		title: 'Relentless',
		description: "We don't slow down. Buzzy Fly keeps moving, keeps building, keeps buzzing.",
	},
	{
		title: 'Bold',
		description: 'Small in size, loud in impact. We show up different, on purpose.',
	},
	{
		title: 'Community-driven',
		description: 'Built with — and for — the people who follow along.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image="/buzzyfly-badge.webp" />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-badge-frame">
					<img class="hero-badge" src="/buzzyfly-badge.webp" alt="Buzzy Fly badge logo" width="260" height="141" />
				</div>
				<h1>Buzzy Fly</h1>
				<p class="tagline">{SITE_DESCRIPTION}</p>
				<a class="cta" href="/blog">Read the Blog</a>
			</section>

			<section class="pillars">
				{
					pillars.map((pillar) => (
						<div class="pillar-card">
							<h3>{pillar.title}</h3>
							<p>{pillar.description}</p>
						</div>
					))
				}
			</section>

			<section class="about-teaser">
				<img src="/buzzyfly-badge.webp" alt="" width="72" height="72" aria-hidden="true" />
				<div>
					<h2>The story so far</h2>
					<p>
						Buzzy Fly is just getting started. This is a placeholder home page — come back soon for
						the full story, or <a href="/about">read more on the About page</a>.
					</p>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: 0;
	}
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75em;
		padding: 4em 1em 5em;
		text-align: center;
		background: linear-gradient(180deg, #123230 0%, #1c4b49 100%);
		color: white;
	}
	.hero-badge-frame {
		display: inline-block;
		padding: 0.75em 1em;
		border-radius: 16px;
		background: white;
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
	}
	.hero-badge {
		display: block;
		width: 180px;
		height: auto;
	}
	.hero h1 {
		margin: 0;
		color: white;
		font-size: 3.052em;
	}
	.hero .tagline {
		margin: 0;
		max-width: 32em;
		font-size: 1.25em;
		color: rgba(255, 255, 255, 0.85);
	}
	.hero .cta {
		display: inline-block;
		margin-top: 0.5em;
		padding: 0.75em 1.75em;
		border-radius: 999px;
		background: white;
		color: #123230;
		font-weight: 700;
		text-decoration: none;
		box-shadow: var(--box-shadow);
		transition: transform 0.15s ease;
	}
	.hero .cta:hover {
		transform: translateY(-2px);
		color: #123230;
	}

	.pillars {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5em;
		max-width: 1020px;
		margin: 0 auto;
		padding: 3.5em 1.5em;
	}
	.pillar-card {
		padding: 1.75em;
		border-radius: 12px;
		background: white;
		box-shadow: var(--box-shadow);
		text-align: left;
	}
	.pillar-card h3 {
		margin: 0 0 0.5em 0;
		color: #1c4b49;
	}
	.pillar-card p {
		margin: 0;
		color: rgb(var(--gray-dark));
	}

	.about-teaser {
		display: flex;
		align-items: center;
		gap: 1.5em;
		max-width: 720px;
		margin: 0 auto;
		padding: 1em 1.5em 5em;
	}
	.about-teaser img {
		flex-shrink: 0;
		object-fit: contain;
	}
	.about-teaser h2 {
		margin: 0 0 0.35em 0;
	}
	.about-teaser p {
		margin: 0;
		color: rgb(var(--gray-dark));
	}

	@media (max-width: 720px) {
		.hero {
			padding: 3em 1em 3.5em;
		}
		.hero h1 {
			font-size: 2.2em;
		}
		.pillars {
			grid-template-columns: 1fr;
			padding: 2.5em 1em;
		}
		.about-teaser {
			flex-direction: column;
			text-align: center;
			padding: 0.5em 1.5em 3.5em;
		}
	}
</style>
