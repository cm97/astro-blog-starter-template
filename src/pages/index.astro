---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import EmailOptin from "../components/EmailOptin.astro";
import ProductCallout from "../components/ProductCallout.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { BUZZYFLY_CONFIG, ALL_PRODUCTS, getOrderAction } from "../data/monetization";
import { getSettings } from "../lib/settings";

const settings = await getSettings(Astro.locals.runtime?.env);

const digitalSystem = ALL_PRODUCTS.find((p) => p.id === "buzzyfly-digital-system")!;
const order = getOrderAction(digitalSystem.id);
const guarantee = "30-day refund if files were not delivered or are materially not what the listing described. No change-of-mind refunds after a valid download.";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={settings.brandName || SITE_TITLE}
			description="Stop rebuilding your client process from scratch every week. Onboarding, weekly planning, and follow-ups as checklists you run in 20 minutes. $49 one-time."
		/>
		<style>
			main { width: var(--max-width); }
			section { padding: var(--space-12) 0; border-bottom: 1px solid var(--line); }
			@media (max-width: 720px) { section { padding: var(--space-8) 0; } }
			.hero { padding: var(--space-12) 0 var(--space-8); }
			@media (max-width: 720px) { .hero { padding: var(--space-8) 0 var(--space-6); } }
			.hero__eyebrow { display: block; font-size: 0.8em; font-weight: 600; color: var(--muted); margin-bottom: var(--space-2); }
			.hero h1 { font-size: clamp(2.1em, 7vw, 3.6em); line-height: 1.04; margin: 0 0 var(--space-3); max-width: 13em; }
			.hero__sub { font-size: 1.1em; color: rgb(var(--gray-dark)); max-width: 32em; margin: 0 0 var(--space-4); line-height: 1.6; }
			.hero__cta-group { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-3); }
			.hero .btn-primary { min-height: 56px; padding: 0 var(--space-4); font-size: 1.05em; }
			.hero__trust { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); font-size: 0.8em; color: var(--muted); font-weight: 600; }
			.optin-wrap { max-width: 720px; }
			h2.section-title { font-size: clamp(1.5em, 4.5vw, 2.1em); margin: 0 0 var(--space-4); max-width: 18em; }
			.pain__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); }
			@media (max-width: 640px) { .pain__grid { grid-template-columns: 1fr; } }
			.pain__item { padding: var(--space-3); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-card); }
			.pain__text { font-size: 0.95em; color: rgb(var(--gray-dark)); line-height: 1.55; margin: 0; }
			.outcome__sub { color: var(--muted); font-size: 0.95em; margin: calc(-1 * var(--space-3)) 0 var(--space-4); }
			.outcome__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); }
			@media (max-width: 640px) { .outcome__grid { grid-template-columns: 1fr; } }
			.outcome__card { padding: var(--space-3); border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--surface); }
			.outcome__card h3 { font-size: 1.05em; margin: 0 0 var(--space-1); }
			.outcome__card p { font-size: 0.88em; color: var(--muted); margin: 0; line-height: 1.55; }
			.featured__wrap { max-width: 720px; }
			.featured__wrap :global(.product-callout) { margin: 0; }
			.faq__list { max-width: 720px; }
			.faq__item { border-bottom: 1px solid var(--line); padding: var(--space-3) 0; }
			.faq__item:first-child { padding-top: 0; }
			.faq__item h3 { font-size: 1.05em; margin: 0 0 var(--space-1); }
			.faq__item p { font-size: 0.9em; color: rgb(var(--gray-dark)); margin: 0; line-height: 1.6; }
			.guarantee { border-bottom: none; }
			.guarantee__box { padding: var(--space-4) var(--space-3); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-card); max-width: 720px; }
			.guarantee__copy h2 { font-size: 1.2em; margin: 0 0 var(--space-1); }
			.guarantee__copy p { font-size: 0.88em; color: rgb(var(--gray-dark)); margin: 0; line-height: 1.55; }
			.final-cta { margin-top: var(--space-6); }
			.final-cta .btn-primary { min-height: 56px; padding: 0 var(--space-4); font-size: 1.05em; }
			.final-cta__alt { font-size: 0.85em; color: var(--muted); margin: var(--space-2) 0 0; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<span class="hero__eyebrow">For coaches and solo service providers</span>
				<h1>Stop rebuilding your client process from scratch every week.</h1>
				<p class="hero__sub">
					Onboarding, weekly planning and follow-ups become checklists you run in 20 minutes. The process still works on the weeks you're slammed.
				</p>
				<div class="hero__cta-group">
					<a class="btn-primary" href={order.href}>Get the Digital System — {digitalSystem.price}</a>
				</div>
				<ul class="hero__trust" aria-label="Purchase details">
					<li>One-time payment</li>
					<li>Download after purchase</li>
					<li>No subscription</li>
					<li>30-day delivery guarantee</li>
				</ul>
			</section>

			<div class="optin-wrap">
				<EmailOptin
					title="Not ready to buy? Get the free 20-minute weekly reset."
					description="The checklist that turns Monday from a scramble into a plan. Free. One email a week. Unsubscribe anytime."
				/>
			</div>

			<section class="pain">
				<h2 class="section-title">Sound familiar?</h2>
				<div class="pain__grid">
					<div class="pain__item"><p class="pain__text">A new client signs and you spend two hours piecing together an onboarding email from old messages.</p></div>
					<div class="pain__item"><p class="pain__text">You sent a proposal 12 days ago. You haven't followed up because you don't know what to say.</p></div>
					<div class="pain__item"><p class="pain__text">Monday arrives and you spend the first hour figuring out what you're supposed to be working on.</p></div>
					<div class="pain__item"><p class="pain__text">A client wrapped up three months ago. You've meant to check in — but you haven't, and now it's awkward.</p></div>
				</div>
			</section>

			<section class="outcome">
				<h2 class="section-title">What changes after you run it</h2>
				<p class="outcome__sub">Not more templates. A process that survives a slammed week.</p>
				<div class="outcome__grid">
					<div class="outcome__card"><h3>New client signs → you're ready in 20 minutes</h3><p>Welcome email, intake form, and kickoff agenda are already written. Fill in the name, hit send.</p></div>
					<div class="outcome__card"><h3>Quiet lead → a reply-generating follow-up</h3><p>Five word-for-word emails for every stage — proposal, mid-project, re-engagement. No staring at a blank screen.</p></div>
					<div class="outcome__card"><h3>Scope creep → a script that says no</h3><p>Six exact lines for when a client asks for "just one more thing" — without losing the client.</p></div>
					<div class="outcome__card"><h3>Monday → a 20-minute reset, not a scramble</h3><p>Clear inboxes, set one priority, check on every client. Same way every week.</p></div>
				</div>
			</section>

			<section class="featured" id="digital-system">
				<div class="featured__wrap">
					<ProductCallout productId={digitalSystem.id} featured headingLevel="h2" />
				</div>
			</section>

			<section class="faq" id="faq">
				<h2 class="section-title">Questions before you buy</h2>
				<div class="faq__list">
					<div class="faq__item">
						<h3>Is this for me?</h3>
						<p>If you're a coach, consultant, freelancer, or solo service provider and your client process lives in your head — onboarding means rebuilding from memory, follow-ups only happen when you remember — yes. Already run a documented system? Then skip it. You'd be buying something you've built.</p>
					</div>
					<div class="faq__item">
						<h3>What's actually in the download?</h3>
						<p>Six checklists, six templates, and one script — onboarding, weekly reset, follow-up emails, scope-creep scripts, retention, proposals, intake forms, and a pricing worksheet. Plain files. No course. No 200-tab spreadsheet.</p>
					</div>
					<div class="faq__item">
						<h3>How do I get it?</h3>
						<p>Pay once through Stripe. Download from the thank-you page right after purchase. The files are yours to keep, with lifetime updates.</p>
					</div>
					<div class="faq__item">
						<h3>What if it doesn't work for me?</h3>
						<p>{guarantee}</p>
					</div>
					<div class="faq__item">
						<h3>Do I need the whole thing at once?</h3>
						<p>No. Pick the one checklist that fixes your biggest problem this week, run it, then add the next. The system works because it's the same every time — not because it's perfect.</p>
					</div>
				</div>
			</section>

			<section class="guarantee">
				<div class="guarantee__box">
					<div class="guarantee__copy">
						<h2>30-day delivery guarantee</h2>
						<p>{guarantee} Support: {BUZZYFLY_CONFIG.orderEmail}</p>
					</div>
				</div>
				<div class="final-cta">
					<a class="btn-primary" href={order.href}>Get the Digital System — {digitalSystem.price}</a>
					<p class="final-cta__alt">Only need one piece, or want everything? <a href="/store#all-products">See every product</a>.</p>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
