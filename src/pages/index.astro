---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCallout from '../components/ProductCallout.astro';
import EmailOptin from '../components/EmailOptin.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { BUZZYFLY_CONFIG } from '../data/monetization';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.home {
				text-align: left;
			}
			.home-hero {
				text-align: center;
				padding: 1.5em 0 2em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.home-hero h1 {
				font-size: 2.4em;
				margin: 0 0 0.4em 0;
				line-height: 1.15;
			}
			.home-hero .lede {
				max-width: 38em;
				margin: 0 auto 1.4em;
				color: rgb(var(--gray-dark));
				font-size: 1.1em;
			}
			.home-hero .buy-row {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1em;
				flex-wrap: wrap;
			}
			.home-hero .price {
				font-size: 1.8em;
				font-weight: 700;
				color: rgb(var(--black));
			}
			.home-hero .cta {
				display: inline-block;
				padding: 0.7em 1.8em;
				border-radius: 999px;
				background: var(--accent);
				color: #fff;
				font-weight: 700;
				text-decoration: none;
				transition: background-color 0.15s ease-in-out;
			}
			.home-hero .cta:hover {
				background: var(--accent-dark);
				color: #fff;
			}
			.home-hero .micro {
				margin: 0.9em 0 0;
				font-size: 0.8em;
				color: rgb(var(--gray));
			}
			.home-section {
				margin-top: 2.5em;
			}
			.home-section h2 {
				font-size: 1.5em;
			}
			.home-list {
				padding-left: 1.2em;
				color: rgb(var(--gray-dark));
			}
			.home-list li {
				margin-bottom: 0.5em;
			}
			.home-entry {
				margin-top: 2.5em;
				padding: 1.75em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 14px;
				background: rgba(var(--gray-light), 20%);
			}
			.home-entry__label {
				font-size: 0.8em;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: rgb(var(--gray));
				margin: 0 0 1em;
				font-weight: 600;
			}
			.home-entry__cards {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
				gap: 0.75em;
				margin-bottom: 1em;
			}
			.home-entry__card {
				display: flex;
				flex-direction: column;
				gap: 0.25em;
				padding: 1em 1.1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				background: #fff;
				text-decoration: none;
				color: rgb(var(--black));
				transition: border-color 0.15s, box-shadow 0.15s;
				font-size: 0.9em;
			}
			.home-entry__card:hover {
				border-color: var(--accent);
				box-shadow: 0 0 0 2px var(--accent);
			}
			.home-entry__card span:last-child {
				color: rgb(var(--gray));
				font-size: 0.85em;
				line-height: 1.4;
				margin-top: 0.1em;
			}
			.home-entry__price {
				font-size: 1.3em;
				font-weight: 700;
				color: var(--accent);
			}
			.home-entry__footer {
				font-size: 0.82em;
				color: rgb(var(--gray));
				margin: 0;
			}
			.home-entry__footer a {
				color: var(--accent);
			}
			.home-posts {
				display: grid;
				gap: 1em;
				margin-top: 1em;
			}
			.home-post {
				padding: 1em 1.2em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				background: #fff;
			}
			.home-post a {
				font-weight: 700;
				text-decoration: none;
			}
			.home-post p {
				margin: 0.4em 0 0;
				font-size: 0.95em;
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="home-hero">
				<h1>Stop rebuilding your client onboarding from memory every time someone new shows up.</h1>
				<p class="lede">
					The Buzzyfly Digital System turns onboarding, weekly planning, and follow-ups into checklists you run in twenty minutes — so the process still exists on the weeks you're slammed.
				</p>
				<div class="buy-row">
					<span class="price">{BUZZYFLY_CONFIG.defaultProductPrice}</span>
					<a class="cta" href="/store">Get the Digital System</a>
				</div>
				<p class="micro">One-time payment. No subscription. 7-day refund if the files aren't what the store lists.</p>
			</section>

			<section class="home-section">
				<h2>What's inside</h2>
				<ul class="home-list">
					<li>The core operating framework — onboarding, weekly planning, and follow-up workflows</li>
					<li>The 20-minute weekly reset checklist, ready to run instead of rebuilt from scratch</li>
					<li>Lifetime access, including future updates to the system</li>
				</ul>
			</section>

			<section class="home-entry">
				<p class="home-entry__label">Not ready for the full system?</p>
				<div class="home-entry__cards">
					<a class="home-entry__card" href="https://buy.stripe.com/5kQ7sNdxub3o0sk1lcaVa05">
						<span class="home-entry__price">$15</span>
						<strong>Weekly Reset Checklist</strong>
						<span>The 20-minute Monday routine — run it instead of rebuilding it.</span>
					</a>
					<a class="home-entry__card" href="https://buy.stripe.com/3cI8wR50Y8Vg3EwaVMaVa07">
						<span class="home-entry__price">$29</span>
						<strong>Client Onboarding Kit</strong>
						<span>Welcome email, intake form, kickoff agenda — ready in one download.</span>
					</a>
					<a class="home-entry__card" href="https://buy.stripe.com/fZubJ3eByc7s1wo0h8aVa06">
						<span class="home-entry__price">$19</span>
						<strong>Follow-Up Email Templates</strong>
						<span>5 done follow-up emails — fill in a name, hit send.</span>
					</a>
				</div>
				<p class="home-entry__footer">One-time payment. 30-day money-back guarantee. <a href="/products">See all products →</a></p>
			</section>

			<ProductCallout />

			<section class="home-section">
				<h2>From the notebook</h2>
				<div class="home-posts">
					<div class="home-post">
						<a href="/blog/first-post/">Why I Built the Buzzyfly Digital System</a>
						<p>The pain that started it — and the fix that stuck.</p>
					</div>
					<div class="home-post">
						<a href="/blog/second-post/">3 Signs Your Business Is Running You</a>
						<p>The quiet tells your workflow has become the thing in charge.</p>
					</div>
					<div class="home-post">
						<a href="/blog/third-post/">The 20-Minute Weekly Reset</a>
						<p>One short weekly habit, and the actual checklist behind it.</p>
					</div>
				</div>
			</section>

			<EmailOptin />
		</main>
		<Footer />
	</body>
</html>
