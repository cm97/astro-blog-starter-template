---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>🪰 Buzzyfly</h1>
			<p>Small ideas, long distances.</p>
			<p>
				Practical systems, reusable templates, and honest write-ups on getting things
				done — sent straight from the Buzzyfly notebook.
			</p>
			<p>
				<a href="/blog">Read the blog</a> or <a href="/about">find out what this is</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
