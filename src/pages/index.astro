---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCallout from '../components/ProductCallout.astro';
import EmailOptin from '../components/EmailOptin.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { BUZZYFLY_CONFIG } from '../data/monetization';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const featured = posts[0];
const rest = posts.slice(1, 7);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.home { text-align: left; }
			.home-hero { text-align: center; padding: 1.5em 0 2em; border-bottom: 1px solid rgb(var(--gray-light)); }
			.home-hero h1 { font-size: 2.4em; margin: 0 0 0.4em 0; line-height: 1.15; }
			.home-hero .lede { max-width: 38em; margin: 0 auto 1.4em; color: rgb(var(--gray-dark)); font-size: 1.1em; }
			.home-hero .buy-row { display: flex; align-items: center; justify-content: center; gap: 1em; flex-wrap: wrap; }
			.home-hero .price { font-size: 1.8em; font-weight: 700; color: rgb(var(--black)); }
			.home-hero .cta { display: inline-block; padding: 0.7em 1.8em; border-radius: 999px; background: var(--accent); color: #fff; font-weight: 700; text-decoration: none; transition: background-color 0.15s ease-in-out; }
			.home-hero .cta:hover { background: var(--accent-dark); color: #fff; }
			.home-hero .micro { margin: 0.9em 0 0; font-size: 0.8em; color: rgb(var(--gray)); }
			.home-section { margin-top: 2.5em; }
			.home-section h2 { font-size: 1.5em; }
			.home-list { padding-left: 1.2em; color: rgb(var(--gray-dark)); }
			.home-list li { margin-bottom: 0.5em; }
			.home-posts { display: grid; gap: 1em; margin-top: 1em; }
			.home-post { padding: 1em 1.2em; border: 1px solid rgb(var(--gray-light)); border-radius: 12px; background: #fff; }
			.home-post a { font-weight: 700; text-decoration: none; }
			.home-post p { margin: 0.4em 0 0; font-size: 0.95em; color: rgb(var(--gray)); }
			.home-featured { display: grid; gap: 0.5em; padding: 1.2em; border: 1px solid rgb(var(--gray-light)); border-radius: 12px; background: #fff; }
			.home-featured .tag { font-size: 0.75em; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent); font-weight: 700; }
		</style>
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="home-hero">
				<h1>Stop rebuilding your client onboarding from memory every time someone new shows up.</h1>
				<p class="lede">
					The Buzzyfly Digital System turns onboarding, weekly planning, and follow-ups into checklists you run in twenty minutes — so the process still exists on the weeks you're slammed.
				</p>
				<div class="buy-row">
					<span class="price">{BUZZYFLY_CONFIG.defaultProductPrice}</span>
					<a class="cta" href="/store">Get the Digital System</a>
				</div>
				<p class="micro">One-time payment. No subscription. 7-day refund if the files aren't what the store lists.</p>
			</section>

			<section class="home-section">
				<h2>What's inside</h2>
				<ul class="home-list">
					<li>Six checklists — onboarding, weekly reset, follow-up, intake, scope-creep, retention</li>
					<li>Four templates — proposal, discovery questions, follow-up emails, one-page plan</li>
					<li>One script — the "how to say no" lines that don't lose the client</li>
					<li>Lifetime access, including future updates to the system</li>
				</ul>
			</section>

			<ProductCallout />

			<section class="home-section">
				<h2>Latest from the notebook</h2>
				{featured && (
					<div class="home-featured">
						<span class="tag">{featured.data.category ?? 'Post'}</span>
						<a href={`/blog/${featured.id}/`}>{featured.data.title}</a>
						<p>{featured.data.description}</p>
					</div>
				)}
				<div class="home-posts">
					{rest.map((post) => (
						<div class="home-post">
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<p>{post.data.description}</p>
						</div>
					))}
				</div>
				<p style="margin-top:1em"><a href="/blog/">See all posts →</a></p>
			</section>

			<EmailOptin />
		</main>
		<Footer />
	</body>
</html>
