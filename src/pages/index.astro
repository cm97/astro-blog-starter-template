---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import EmailOptin from "../components/EmailOptin.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { BUZZYFLY_CONFIG, ALL_PRODUCTS } from "../data/monetization";
import { getSettings } from "../lib/settings";

const settings = await getSettings(Astro.locals.runtime?.env);

const digitalSystem = ALL_PRODUCTS.find((p) => p.id === "buzzyfly-digital-system")!;
const bundle = ALL_PRODUCTS.find((p) => p.id === "complete-business-bundle")!;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={settings.brandName || SITE_TITLE}
			description="Stop rebuilding your client process from scratch every week. Onboarding, weekly planning, and follow-ups as checklists you run in 20 minutes. $49 one-time."
		/>
		<style>
			.hero { padding: 4em 0 3.5em; text-align: center; border-bottom: 1px solid rgb(var(--gray-light)); }
			.hero__eyebrow { display: inline-block; font-size: 0.78em; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 1em; }
			.hero h1 { font-size: clamp(1.9em, 5.5vw, 2.8em); line-height: 1.12; margin: 0 auto 0.6em; color: rgb(var(--black)); max-width: 16em; }
			.hero__sub { font-size: 1.15em; color: rgb(var(--gray-dark)); max-width: 34em; margin: 0 auto 2em; line-height: 1.65; }
			.hero__cta-group { display: flex; align-items: center; justify-content: center; gap: 0.9em; flex-wrap: wrap; margin-bottom: 1em; }
			.btn-primary { display: inline-block; padding: 1.05em 2.6em; border-radius: 999px; background: var(--accent); color: #fff !important; font-weight: 800; font-size: 1.28em; text-decoration: none; white-space: nowrap; }
			.btn-primary:hover { background: var(--accent-dark); }
			.btn-secondary { display: inline-block; padding: 0.45em 0.9em; border-radius: 999px; border: 1px solid rgb(var(--gray-light)); color: rgb(var(--gray-dark)) !important; font-weight: 600; font-size: 0.82em; text-decoration: none; }
			.btn-secondary:hover { border-color: var(--accent); color: var(--accent) !important; }
			.hero__price { font-size: 1.6em; font-weight: 700; color: rgb(var(--black)); }
			.hero__trust { font-size: 0.85em; color: rgb(var(--gray)); margin: 0; }
			.hero__trust strong { color: rgb(var(--gray-dark)); }
			.pain { padding: 3.5em 0 3em; border-bottom: 1px solid rgb(var(--gray-light)); }
			.pain h2 { font-size: 1.4em; color: rgb(var(--gray)); font-weight: 400; margin: 0 0 1.5em; text-align: center; }
			.pain__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75em; max-width: 820px; margin: 0 auto; }
			@media (max-width: 520px) { .pain__grid { grid-template-columns: 1fr; } }
			.pain__item { display: flex; gap: 0.7em; align-items: flex-start; padding: 1em 1.1em; background: rgba(var(--gray-light), 30%); border-radius: 10px; }
			.pain__icon { font-size: 1.1em; line-height: 1.6; flex-shrink: 0; }
			.pain__text { font-size: 0.95em; color: rgb(var(--gray-dark)); line-height: 1.5; margin: 0; }
			.outcome { padding: 3.5em 0 3em; border-bottom: 1px solid rgb(var(--gray-light)); background: rgba(35, 55, 255, 0.03); }
			.outcome h2 { font-size: 1.5em; color: rgb(var(--black)); margin: 0 0 0.4em; text-align: center; }
			.outcome__sub { color: rgb(var(--gray)); font-size: 0.95em; margin: 0 0 1.8em; text-align: center; }
			.outcome__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1em; max-width: 820px; margin: 0 auto; }
			@media (max-width: 520px) { .outcome__grid { grid-template-columns: 1fr; } }
			.outcome__card { padding: 1.4em; border: 1px solid rgb(var(--gray-light)); border-radius: 12px; background: #fff; }
			.outcome__card-icon { font-size: 1.5em; margin-bottom: 0.4em; display: block; }
			.outcome__card h3 { font-size: 1em; margin: 0 0 0.35em; color: rgb(var(--black)); }
			.outcome__card p { font-size: 0.88em; color: rgb(var(--gray)); margin: 0; line-height: 1.55; }
			.featured { padding: 3.5em 0 3em; border-bottom: 1px solid rgb(var(--gray-light)); }
			.featured__box { background: rgb(var(--black)); color: #fff; border-radius: 16px; padding: 2.4em; position: relative; overflow: hidden; max-width: 820px; margin: 0 auto; }
			.featured__box::before { content: ""; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(35, 55, 255, 0.35) 0%, transparent 60%); pointer-events: none; }
			.featured__badge { display: inline-block; background: var(--accent); color: #fff; font-size: 0.72em; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; padding: 0.2em 0.7em; border-radius: 999px; margin-bottom: 0.8em; }
			.featured__box h2 { color: #fff; font-size: 1.45em; margin: 0 0 0.4em; }
			.featured__box p { color: rgba(255, 255, 255, 0.75); font-size: 0.95em; margin: 0 0 1.2em; line-height: 1.55; }
			.featured__features { list-style: none; padding: 0; margin: 0 0 1.6em; display: grid; grid-template-columns: 1fr 1fr; gap: 0.5em; }
			@media (max-width: 480px) { .featured__features { grid-template-columns: 1fr; } }
			.featured__features li { display: flex; align-items: flex-start; gap: 0.4em; font-size: 0.9em; color: rgba(255, 255, 255, 0.85); line-height: 1.4; }
			.featured__features li::before { content: "\2713"; color: #4ade80; font-weight: 700; flex-shrink: 0; }
			.featured__buy { display: flex; align-items: center; gap: 1em; flex-wrap: wrap; }
			.featured__price { font-size: 2.1em; font-weight: 700; color: #fff; }
			.btn-white { display: inline-block; padding: 0.95em 2.2em; border-radius: 999px; background: #fff; color: rgb(var(--black)) !important; font-weight: 800; font-size: 1.2em; text-decoration: none; }
			.btn-white:hover { opacity: 0.9; }
			.faq { padding: 3.5em 0 3em; border-bottom: 1px solid rgb(var(--gray-light)); }
			.faq h2 { font-size: 1.4em; color: rgb(var(--black)); margin: 0 0 1.5em; text-align: center; }
			.faq__list { max-width: 720px; margin: 0 auto; }
			.faq__item { border-bottom: 1px solid rgb(var(--gray-light)); padding: 1.1em 0; }
			.faq__item h3 { font-size: 1em; margin: 0 0 0.4em; color: rgb(var(--black)); }
			.faq__item p { font-size: 0.9em; color: rgb(var(--gray-dark)); margin: 0; line-height: 1.6; }
			.bundle { padding: 3.5em 0 3em; border-bottom: 1px solid rgb(var(--gray-light)); }
			.bundle__box { max-width: 820px; margin: 0 auto; padding: 1.8em 1.6em; border: 2px solid var(--accent); border-radius: 16px; }
			.bundle__box h2 { font-size: 1.35em; margin: 0 0 0.4em; }
			.bundle__box p { color: rgb(var(--gray-dark)); margin: 0 0 1em; line-height: 1.55; }
			.bundle__buy { display: flex; align-items: center; gap: 1em; flex-wrap: wrap; }
			.guarantee { padding: 2.5em 0 3em; border-bottom: 1px solid rgb(var(--gray-light)); }
			.guarantee__box { display: flex; gap: 1.2em; align-items: flex-start; padding: 1.5em 1.6em; background: rgba(35, 55, 255, 0.04); border: 1px solid rgba(35, 55, 255, 0.15); border-radius: 14px; max-width: 820px; margin: 0 auto; }
			.guarantee__icon { font-size: 2em; flex-shrink: 0; line-height: 1; }
			.guarantee__copy h3 { font-size: 1em; margin: 0 0 0.3em; color: rgb(var(--black)); }
			.guarantee__copy p { font-size: 0.88em; color: rgb(var(--gray-dark)); margin: 0; line-height: 1.55; }
			.optin-wrap { padding: 1em 0; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<span class="hero__eyebrow">For coaches and solo service providers</span>
				<h1>Stop rebuilding your client process from scratch every week.</h1>
				<p class="hero__sub">
					Onboarding, weekly planning, and follow-ups as checklists you run in 20 minutes — so the process still exists on the weeks you're slammed.
				</p>
				<div class="hero__cta-group">
					<span class="hero__price">{digitalSystem.price}</span>
					<a class="btn-primary" href={digitalSystem.buyUrl} target="_blank" rel="noopener">Buy the Digital System — {digitalSystem.price}</a>
				</div>
				<p class="hero__trust">One-time payment. Download after purchase on the thank-you page. 30-day refund if the files are not delivered or not as listed.</p>
				<p class="hero__trust"><a class="btn-secondary" href={bundle.buyUrl} target="_blank" rel="noopener">Smaller option: full bundle — {bundle.price}</a></p>
			</section>

			<section class="pain">
				<h2>Sound familiar?</h2>
				<div class="pain__grid">
					<div class="pain__item"><span class="pain__icon">😰</span><p class="pain__text">A new client signs and you spend two hours piecing together an onboarding email from old messages.</p></div>
					<div class="pain__item"><span class="pain__icon">📭</span><p class="pain__text">You sent a proposal 12 days ago. You haven't followed up because you don't know what to say.</p></div>
					<div class="pain__item"><span class="pain__icon">🌀</span><p class="pain__text">Monday arrives and you spend the first hour figuring out what you're supposed to be working on.</p></div>
					<div class="pain__item"><span class="pain__icon">💸</span><p class="pain__text">A client wrapped up three months ago. You've meant to check in — but you haven't, and now it's awkward.</p></div>
				</div>
			</section>

			<section class="outcome">
				<h2>What changes after you run it</h2>
				<p class="outcome__sub">Not more templates. A process that survives a slammed week.</p>
				<div class="outcome__grid">
					<div class="outcome__card"><span class="outcome__card-icon">📋</span><h3>New client signs → you're ready in 20 minutes</h3><p>Welcome email, intake form, and kickoff agenda are already written. Fill in the name, hit send.</p></div>
					<div class="outcome__card"><span class="outcome__card-icon">📨</span><h3>Quiet lead → a reply-generating follow-up</h3><p>Five word-for-word emails for every stage — proposal, mid-project, re-engagement. No staring at a blank screen.</p></div>
					<div class="outcome__card"><span class="outcome__card-icon">🛡️</span><h3>Scope creep → a script that says no</h3><p>Six exact lines for when a client asks for "just one more thing" — without losing the client.</p></div>
					<div class="outcome__card"><span class="outcome__card-icon">📅</span><h3>Monday → a 20-minute reset, not a scramble</h3><p>Clear inboxes, set one priority, check on every client. Same way every week.</p></div>
				</div>
			</section>

			<section class="featured">
				<div class="featured__box">
					<span class="featured__badge">Most popular</span>
					<h2>{digitalSystem.title}</h2>
					<p>{digitalSystem.description}</p>
					<ul class="featured__features">{digitalSystem.features.map((f) => <li>{f}</li>)}</ul>
					<div class="featured__buy">
						<span class="featured__price">{digitalSystem.price}</span>
						<a class="btn-white" href={digitalSystem.buyUrl} target="_blank" rel="noopener">Buy the Digital System — {digitalSystem.price}</a>
					</div>
				</div>
			</section>

			<section class="faq" id="faq">
				<h2>Questions before you buy</h2>
				<div class="faq__list">
					<div class="faq__item">
						<h3>Is this for me?</h3>
						<p>If you're a coach, consultant, freelancer, or solo service provider and your client process lives in your head — onboarding means rebuilding from memory, follow-ups only happen when you remember — yes. If you already run a documented system, you'd be buying something you've built.</p>
					</div>
					<div class="faq__item">
						<h3>What's actually in the download?</h3>
						<p>Six checklists, six templates, and one script — onboarding, weekly reset, follow-up emails, scope-creep scripts, retention, proposals, intake forms, and a pricing worksheet. Plain files. No course, no 200-tab spreadsheet.</p>
					</div>
					<div class="faq__item">
						<h3>How do I get it?</h3>
						<p>Pay once through PayPal. Download right after payment. The files are yours to keep, with lifetime updates.</p>
					</div>
					<div class="faq__item">
						<h3>What if it doesn't work for me?</h3>
						<p>30-day refund if the files are not delivered or not as listed.</p>
					</div>
					<div class="faq__item">
						<h3>Do I need the whole thing at once?</h3>
						<p>No. Pick the one checklist that fixes your biggest problem this week, run it, then add the next. The system works because it's the same every time — not because it's perfect.</p>
					</div>
				</div>
			</section>

			<section class="bundle">
				<div class="bundle__box">
					<h2>{bundle.title} — {bundle.price}</h2>
					<p>{bundle.description} One payment. Same 30-day guarantee. PayPal checkout opens now.</p>
					<ul class="featured__features">{bundle.features.map((f) => <li>{f}</li>)}</ul>
					<div class="bundle__buy">
						<a class="btn-secondary" href={bundle.buyUrl} target="_blank" rel="noopener">Bundle — {bundle.price}</a>
						<a class="btn-secondary" href="/store">See every product</a>
					</div>
				</div>
			</section>

			<section class="guarantee">
				<div class="guarantee__box">
					<span class="guarantee__icon">🛡️</span>
					<div class="guarantee__copy">
						<h3>30-Day Money-Back Guarantee</h3>
						<p>30-day refund if the files are not delivered or not as listed.</p>
					</div>
				</div>
			</section>

			<div class="optin-wrap"><EmailOptin /></div>
		</main>
		<Footer />
	</body>
</html>
