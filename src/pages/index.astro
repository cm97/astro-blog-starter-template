---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import EmailOptin from "../components/EmailOptin.astro";
import ProductCallout from "../components/ProductCallout.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { BUZZYFLY_CONFIG, ALL_PRODUCTS, getOrderAction } from "../data/monetization";
import PayPalLink from "../components/PayPalLink.astro";
import { getSettings } from "../lib/settings";
import { HOME_ALTERNATES } from "../data/i18n";

const settings = await getSettings(Astro.locals.runtime?.env);

const digitalSystem = ALL_PRODUCTS.find((p) => p.id === "buzzyfly-digital-system")!;
const order = getOrderAction(digitalSystem.id);
const guarantee = BUZZYFLY_CONFIG.guarantee;
const guaranteeShort = BUZZYFLY_CONFIG.guaranteeShort;

// Same trust signals as /store, shown by the hero offer card so a first-time
// visitor sees the low-risk reasons to buy right next to the price and button.
const HERO_TRUST = [
	{ icon: "⚡", label: "Open in your browser after purchase" },
	{ icon: "🔁", label: "No subscription" },
	{ icon: "🛡️", label: guaranteeShort },
	{ icon: "🐝", label: "Built by a solo creator" },
];

// Organization and WebSite structured data so Google knows who runs the site.
const brand = settings.brandName || SITE_TITLE;
const homeLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': `${BUZZYFLY_CONFIG.siteUrl}/#organization`,
			name: brand,
			url: BUZZYFLY_CONFIG.siteUrl,
			logo: `${BUZZYFLY_CONFIG.siteUrl}/buzzyfly-logo.svg`,
			email: BUZZYFLY_CONFIG.supportEmail,
		},
		{
			'@type': 'WebSite',
			'@id': `${BUZZYFLY_CONFIG.siteUrl}/#website`,
			name: brand,
			url: BUZZYFLY_CONFIG.siteUrl,
			publisher: { '@id': `${BUZZYFLY_CONFIG.siteUrl}/#organization` },
		},
	],
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${brand}: Client Follow-Up and Onboarding App`}
			description="Stop rebuilding your client process every week. A browser app that shows who to follow up with today, drafts the email and onboards new clients. $49."
			alternates={HOME_ALTERNATES}
		/>
		<script type="application/ld+json" set:html={homeLd} />
		<style>
			.lang-link { display: flex; justify-content: flex-end; margin: 0; font-size: 0.85em; }
			.lang-link a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.4em; }
			.hero { padding: 1.6em 0 2em; border-bottom: 1px solid rgb(var(--gray-light)); }
			.hero__copy { text-align: center; margin: 0 auto 1.2em; max-width: 40em; }
			@media (min-width: 700px) { .hero { padding: 1.4em 0 2.5em; } .hero__copy { margin-bottom: 1.6em; } }
			.hero__eyebrow { display: inline-block; font-size: 0.72em; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.6em; }
			.hero h1 { font-size: clamp(1.55em, 4.6vw, 2.4em); line-height: 1.12; margin: 0 auto 0.45em; max-width: 17em; color: rgb(var(--black)); }
			.hero__sub { font-size: 1em; color: rgb(var(--gray-dark)); margin: 0; line-height: 1.55; }
			@media (min-width: 700px) { .hero__sub { font-size: 1.1em; } }
			.hero-shot { margin: 0 auto 1em; max-width: 300px; }
			.hero-shot img { display: block; width: 100%; height: auto; aspect-ratio: 1200 / 750; border-radius: 12px; border: 1px solid rgb(var(--gray-light)); box-shadow: 0 8px 24px rgba(15, 18, 40, 0.08); }
			@media (min-width: 700px) { .hero-shot { max-width: 420px; margin-bottom: 1.2em; } }
			.hero-offer { background: #fff; border: 2px solid var(--accent); border-radius: 16px; padding: 1em 1.1em 1.1em; box-shadow: 0 10px 30px rgba(35, 55, 255, 0.12); text-align: center; }
			@media (min-width: 700px) { .hero-offer { display: grid; grid-template-columns: 1.1fr 1fr; gap: 1.4em; align-items: center; text-align: left; padding: 1.4em 1.5em; } .hero-offer__top { justify-content: flex-start; } .hero-offer__buy { text-align: center; } .hero-offer__buy .btn-primary { font-size: 1.5em; padding: 1em 1.2em; } }
			.hero-offer__top { display: flex; align-items: baseline; justify-content: center; gap: 0.5em; flex-wrap: wrap; margin: 0 0 0.6em; }
			.hero-offer__price { font-size: 2em; font-weight: 800; color: rgb(var(--black)); line-height: 1; }
			.hero-offer__price-note { font-size: 0.85em; font-weight: 700; color: rgb(var(--gray-dark)); }
			.hero-offer__list { list-style: none; padding: 0; margin: 0 0 0.9em; text-align: left; font-size: 0.88em; color: rgb(var(--gray-dark)); line-height: 1.45; display: none; }
			@media (min-width: 700px) { .hero-offer__list { display: block; margin: 0; } }
			.hero-offer__list li { padding-left: 1.4em; position: relative; margin: 0 0 0.35em; }
			.hero-offer__list li::before { content: "✓"; position: absolute; left: 0; color: var(--accent); font-weight: 800; }
			.btn-primary { display: inline-flex; align-items: center; justify-content: center; min-height: 72px; width: 100%; max-width: 100%; white-space: normal; text-align: center; padding: 1.1em 1.6em; border-radius: 999px; background: var(--accent); color: #fff !important; font-weight: 800; font-size: 1.45em; text-decoration: none; box-sizing: border-box; box-shadow: 0 6px 18px rgba(35, 55, 255, 0.35); }
			.btn-primary:hover { background: var(--accent-dark); }
			.btn-primary:focus-visible { outline: 3px solid rgb(var(--black)); outline-offset: 3px; }
			.hero-offer__paypal { margin-top: 0.5em; }
			.hero-offer__refund { font-size: 0.8em; color: rgb(var(--gray-dark)); margin: 0.6em 0 0; line-height: 1.45; }
			.hero-offer__more { font-size: 0.85em; margin: 0.5em 0 0; }
			.hero-offer__more a { display: inline-block; padding: 0.55em 0.3em; min-height: 44px; box-sizing: border-box; }
			.hero-trust { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6em; padding: 0; margin: 1.1em auto 0; max-width: 820px; }
			@media (max-width: 560px) { .hero-trust { grid-template-columns: 1fr 1fr; } }
			.hero-trust li { display: flex; align-items: center; justify-content: center; gap: 0.45em; padding: 0.7em 0.5em; border-radius: 10px; background: rgba(var(--gray-light), 55%); font-size: 0.8em; font-weight: 700; color: rgb(var(--gray-dark)); text-align: center; line-height: 1.3; }
			.pain { padding: 3.5em 0 3em; border-bottom: 1px solid rgb(var(--gray-light)); }
			.pain h2 { font-size: 1.4em; color: rgb(var(--gray)); font-weight: 400; margin: 0 0 1.5em; text-align: center; }
			.pain__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75em; max-width: 820px; margin: 0 auto; }
			@media (max-width: 520px) { .pain__grid { grid-template-columns: 1fr; } }
			.pain__item { display: flex; gap: 0.7em; align-items: flex-start; padding: 1em 1.1em; background: rgba(var(--gray-light), 30%); border-radius: 10px; }
			.pain__icon { font-size: 1.1em; line-height: 1.6; flex-shrink: 0; }
			.pain__text { font-size: 0.95em; color: rgb(var(--gray-dark)); line-height: 1.5; margin: 0; }
			.outcome { padding: 3.5em 0 3em; border-bottom: 1px solid rgb(var(--gray-light)); background: rgba(35, 55, 255, 0.03); }
			.outcome h2 { font-size: 1.5em; color: rgb(var(--black)); margin: 0 0 0.4em; text-align: center; }
			.outcome__sub { color: rgb(var(--gray)); font-size: 0.95em; margin: 0 0 1.8em; text-align: center; }
			.outcome__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1em; max-width: 820px; margin: 0 auto; }
			@media (max-width: 520px) { .outcome__grid { grid-template-columns: 1fr; } }
			.outcome__card { padding: 1.4em; border: 1px solid rgb(var(--gray-light)); border-radius: 12px; background: #fff; }
			.outcome__card-icon { font-size: 1.5em; margin-bottom: 0.4em; display: block; }
			.outcome__card h3 { font-size: 1em; margin: 0 0 0.35em; color: rgb(var(--black)); }
			.outcome__card p { font-size: 0.88em; color: rgb(var(--gray)); margin: 0; line-height: 1.55; }
			.featured { padding: 3.5em 0 3em; border-bottom: 1px solid rgb(var(--gray-light)); }
			.faq { padding: 3.5em 0 3em; border-bottom: 1px solid rgb(var(--gray-light)); }
			.faq h2 { font-size: 1.4em; color: rgb(var(--black)); margin: 0 0 1.5em; text-align: center; }
			.faq__list { max-width: 720px; margin: 0 auto; }
			.faq__item { border-bottom: 1px solid rgb(var(--gray-light)); padding: 1.1em 0; }
			.faq__item h3 { font-size: 1em; margin: 0 0 0.4em; color: rgb(var(--black)); }
			.faq__item p { font-size: 0.9em; color: rgb(var(--gray-dark)); margin: 0; line-height: 1.6; }
			.guarantee { padding: 2.5em 0 3em; border-bottom: 1px solid rgb(var(--gray-light)); }
			.guarantee__box { display: flex; gap: 1.2em; align-items: flex-start; padding: 1.5em 1.6em; background: rgba(35, 55, 255, 0.04); border: 1px solid rgba(35, 55, 255, 0.15); border-radius: 14px; max-width: 820px; margin: 0 auto; }
			.guarantee__icon { font-size: 2em; flex-shrink: 0; line-height: 1; }
			.guarantee__copy h2 { font-size: 1.05em; margin: 0 0 0.3em; color: rgb(var(--black)); }
			.guarantee__copy p { font-size: 0.88em; color: rgb(var(--gray-dark)); margin: 0; line-height: 1.55; }
			.optin-wrap { padding: 0; }
			.featured__wrap { max-width: 640px; margin: 0 auto; }
			.final-cta { text-align: center; margin: 2em auto 0; max-width: 460px; }
			.final-cta__alt { font-size: 0.88em; color: rgb(var(--gray)); margin: 0.9em 0 0; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="lang-link"><a href="/es/" hreflang="es" lang="es">Español</a></p>
			<section class="hero">
				<div class="hero__copy">
					<span class="hero__eyebrow">For coaches and solo service providers</span>
					<h1>Stop rebuilding your client process from scratch every week.</h1>
					<p class="hero__sub">A browser app that shows who to follow up with today and drafts the email. New clients get onboarded the same way every time.</p>
				</div>
				<figure class="hero-shot">
					<img src="/images/today-dashboard.jpg" width="1200" height="750" alt="The Buzzyfly Today list with example clients: two follow-ups due, a proposal and a week-overdue invoice, each with a Write the email button." decoding="async" fetchpriority="high" />
				</figure>
				<div class="hero-offer" aria-label="Buzzyfly Digital System offer">
					<div class="hero-offer__what">
						<p class="hero-offer__top">
							<span class="hero-offer__price">{digitalSystem.price}</span>
							<span class="hero-offer__price-note">one-time · no subscription</span>
						</p>
						<ul class="hero-offer__list">
							<li>Today dashboard: who is due for a follow-up, with the email drafted</li>
							<li>Onboarding, weekly reset, proposals and scope replies</li>
							<li>Works in your browser and on your phone. No download.</li>
						</ul>
					</div>
					<div class="hero-offer__buy">
						<a class="btn-primary" href={order.href}>Get the Digital System — {digitalSystem.price}</a>
						<p class="hero-offer__refund">{guaranteeShort} You unlock the app on the thank-you page after checkout.</p>
						{order.live && <div class="hero-offer__paypal"><PayPalLink href={order.paypalHref} /></div>}
						<p class="hero-offer__more"><a href="/demo">Try the free demo</a> · <a href="/store">See what's inside</a></p>
					</div>
				</div>
				<ul class="hero-trust" aria-label="Why buying here is low risk">
					{HERO_TRUST.map((t) => <li><span aria-hidden="true">{t.icon}</span>{t.label}</li>)}
				</ul>
			</section>

			<div class="optin-wrap">
				<EmailOptin
					title="Not ready to buy? Get the free 20-minute weekly reset."
					description="The checklist that turns Monday from a scramble into a plan. Free. One email a week. Unsubscribe anytime."
				/>
			</div>

			<section class="pain">
				<h2>Sound familiar?</h2>
				<div class="pain__grid">
					<div class="pain__item"><span class="pain__icon">😰</span><p class="pain__text">A new client signs and you spend two hours piecing together an onboarding email from old messages.</p></div>
					<div class="pain__item"><span class="pain__icon">📭</span><p class="pain__text">You sent a proposal 12 days ago. You haven't followed up because you don't know what to say.</p></div>
					<div class="pain__item"><span class="pain__icon">🌀</span><p class="pain__text">Monday arrives and you spend the first hour figuring out what you're supposed to be working on.</p></div>
					<div class="pain__item"><span class="pain__icon">💸</span><p class="pain__text">A client wrapped up three months ago. You've meant to check in — but you haven't, and now it's awkward.</p></div>
				</div>
			</section>

			<section class="outcome">
				<h2>What changes after you open the app</h2>
				<p class="outcome__sub">Not more templates. A process that survives a slammed week.</p>
				<div class="outcome__grid">
					<div class="outcome__card"><span class="outcome__card-icon">📋</span><h3>New client signs → you're ready in 20 minutes</h3><p>Welcome email, intake, and kickoff are ready. Fill in the name, copy, send.</p></div>
					<div class="outcome__card"><span class="outcome__card-icon">📨</span><h3>Quiet lead → a follow-up draft, ready to send</h3><p>The Today screen shows who is due. The email is filled in. You copy it and send it.</p></div>
					<div class="outcome__card"><span class="outcome__card-icon">🛡️</span><h3>Scope creep → the exact words to say</h3><p>Ready replies for when a client asks for "just one more thing." Copy one, add your price, send it.</p></div>
					<div class="outcome__card"><span class="outcome__card-icon">📅</span><h3>Monday → a 20-minute reset, not a scramble</h3><p>Clear the list, set one priority, check on every client. Same way every week.</p></div>
				</div>
			</section>

			<section class="featured" id="digital-system">
				<div class="featured__wrap">
					<ProductCallout productId={digitalSystem.id} featured headingLevel="h2" />
				</div>
			</section>

			<section class="faq" id="faq">
				<h2>Questions before you buy</h2>
				<div class="faq__list">
					<div class="faq__item">
						<h3>Is this for me?</h3>
						<p>If you're a coach, consultant, freelancer, or solo service provider and your client process lives in your head — onboarding means rebuilding from memory, follow-ups only happen when you remember — yes. If your process already survives a slammed week, you're fine. If it lives in your head, this is for you.</p>
					</div>
					<div class="faq__item">
						<h3>What's actually in the app?</h3>
						<p>Today dashboard, follow-ups, email writer, onboarding, weekly reset, proposals and pricing, and scope replies. Opens in your browser. No download. No Excel.</p>
					</div>
					<div class="faq__item">
						<h3>How do I get it?</h3>
						<p>Pay once through Stripe. After purchase you land in the app. No file to download.</p>
					</div>
					<div class="faq__item">
						<h3>What if it doesn't work for me?</h3>
						<p>{guarantee}</p>
					</div>
				</div>
			</section>

			<section class="guarantee">
				<div class="guarantee__box">
					<span class="guarantee__icon" aria-hidden="true">🛡️</span>
					<div class="guarantee__copy">
						<h2>30-day refund policy</h2>
						<p>{guarantee} Support: {BUZZYFLY_CONFIG.supportEmail}</p>
					</div>
				</div>
				<div class="final-cta">
					<a class="btn-primary" href={order.href}>Get the Digital System — {digitalSystem.price}</a>
					<br />
					{order.live && <PayPalLink href={order.paypalHref} />}
					<p class="final-cta__alt">Want the details first? <a href="/store">See what's inside</a>.</p>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
