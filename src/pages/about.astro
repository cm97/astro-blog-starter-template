---
import Layout from '../layouts/BlogPost.astro';
import ProductCallout from '../components/ProductCallout.astro';
import EmailOptin from '../components/EmailOptin.astro';
import { ALL_PRODUCTS, BUZZYFLY_CONFIG } from '../data/monetization';

const system = ALL_PRODUCTS.find((p) => p.id === 'buzzyfly-digital-system')!;
const bundle = ALL_PRODUCTS.find((p) => p.id === 'complete-business-bundle')!;
---

<Layout
	title="Client onboarding that still runs on a slammed week — Buzzyfly"
	description="The 20-minute checklists for onboarding, follow-ups, and the Monday reset. $49 system or $97 bundle. No subscription."
	pubDate={new Date('August 15 2026')}
	heroImage="/buzzyfly-brand-about.svg"
>
	<p>
		A new client signs. Thirty minutes later you are staring at a blank email. Follow-ups die in the inbox. The weekly plan collapses by Thursday. That is the problem this page is for.
	</p>

	<h2>What you run</h2>
	<ul>
		<li>Welcome email, intake, and kickoff — filled in, not rewritten from memory</li>
		<li>Five follow-ups for the proposal that got no reply</li>
		<li>A 20-minute Monday reset: inbox, one priority, the late follow-ups</li>
		<li>A line you can send when the extra request is out of scope</li>
	</ul>

	<h2>Who it is for</h2>
	<p>
		One-person and few-person operators who rebuild client onboarding from memory. Not a team with a project manager. Not a course. Files you open, fill, and send.
	</p>

	<h2>Pick one</h2>
	<p>
		Start with the {system.title} ({system.price}). Onboarding, the weekly reset, and the follow-up system in one download.
		<a href={system.buyUrl}>Get the {system.price} system</a>.
	</p>
	<p>
		Want every file: the {bundle.title} is {bundle.price}. Same checklists, plus the onboarding kit, the follow-up templates, and the weekly checklist.
		<a href={bundle.buyUrl}>Get the {bundle.price} bundle</a>.
	</p>

	<h2>The guarantee</h2>
	<p>{BUZZYFLY_CONFIG.guarantee}</p>

	<ProductCallout />

	<EmailOptin
		title="Want the free weekly reset checklist first?"
		description="Send me the 20-minute version. No spam. Just the checklist, plus one email a week with the next piece of the system."
		buttonLabel="Send me the checklist"
	/>
</Layout>
