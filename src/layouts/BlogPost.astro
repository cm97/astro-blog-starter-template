---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ProductCallout from '../components/ProductCallout.astro';
import EmailOptin from '../components/EmailOptin.astro';
import { BUZZYFLY_CONFIG, getProduct } from '../data/monetization';

type Props = CollectionEntry<'blog'>['data'] & {
	prev?: CollectionEntry<'blog'> | null;
	next?: CollectionEntry<'blog'> | null;
	related?: CollectionEntry<'blog'>[];
	currentId?: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	featuredProductTitle,
	featuredProductUrl,
	featuredProductDescription,
	prev,
	next,
	related = [],
} = Astro.props;

// Every post ends with a product callout: the post's own product when it names
// one in frontmatter, otherwise the flagship Digital System.
const calloutProduct = getProduct(featuredProductTitle ?? '') ?? getProduct('buzzyfly-digital-system')!;
const brandHero = '/buzzyfly-brand-about.svg';
const displayHero =
	!heroImage ||
	heroImage.includes('blog-placeholder') ||
	heroImage.includes('buzzyfly-brand-about.jpg')
		? brandHero
		: heroImage;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={displayHero} />
		<style>
			main { width: var(--max-width); }
			.hero-image { width: 100%; }
			.hero-image img { display: block; margin: 0 auto; border-radius: var(--radius-card); border: 1px solid var(--line); }
			.prose { width: 720px; max-width: 100%; margin: auto; padding: var(--space-3) 0; color: rgb(var(--gray-dark)); }
			.title { margin-bottom: var(--space-3); padding: var(--space-3) 0; }
			.title h1 { margin: 0 0 var(--space-3) 0; font-size: clamp(1.9em, 6vw, 2.8em); line-height: 1.08; }
			.date { margin-bottom: var(--space-1); color: var(--muted); font-size: 0.85em; }
			.last-updated-on { font-style: italic; }
			.tag-line { margin-bottom: var(--space-1); }
			.tag-line span { display: inline-block; padding: 2px var(--space-2); border-radius: 999px; border: 1px solid var(--line-strong); color: var(--ink); font-size: 0.72em; font-weight: 600; }
			.nav-posts { display: flex; justify-content: space-between; gap: 1em; margin: 2.5em 0 1em; padding-top: 1.5em; border-top: 1px solid var(--line); }
			.nav-posts a { color: var(--ink); text-decoration: none; font-weight: 600; font-size: 0.95em; }
			.nav-posts a:hover { text-decoration: underline; }
			.nav-posts .dir { display: block; font-size: 0.75em; color: var(--muted); font-weight: 400; margin-bottom: 4px; }
			.related { margin: 2em 0; }
			.related h3 { font-size: 1.2em; margin-bottom: 0.8em; }
			.related ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6em; }
			.related a { color: var(--ink); font-weight: 600; }
			
			.sticky-cta { position: fixed; bottom: 0; left: 0; right: 0; background: var(--surface); border-top: 1px solid var(--line); padding: var(--space-1) var(--gutter); font-size: 0.85em; color: rgb(var(--gray-dark)); display: flex; align-items: center; justify-content: space-between; gap: 1em; z-index: 50; }
			.sticky-cta .price { font-family: var(--font-display); font-weight: 800; color: var(--ink); margin-left: auto; }
			
			
			@media (max-width: 720px) { .sticky-cta span:first-child { display: none; } }
			body { padding-bottom: 72px; }
			.store-link { font-size: 0.85em; color: var(--muted); margin: calc(-1 * var(--space-4)) 0 var(--space-6); }
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					<img width={1020} height={510} src={displayHero} alt="" />
				</div>
				<div class="prose">
					{category && <div class="tag-line"><span>{category}</span></div>}
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
					<ProductCallout
						productId={calloutProduct.id}
						description={calloutProduct.title === featuredProductTitle ? featuredProductDescription : undefined}
						url={featuredProductUrl}
					/>
					<p class="store-link">Not sure which one fits? <a href="/store">See every product in the store</a>.</p>
					{
						(prev || next) && (
							<nav class="nav-posts" aria-label="Post navigation">
								<div>
									{prev && <><span class="dir">← Previous</span><a href={`/blog/${prev.id}/`}>{prev.data.title}</a></>}
								</div>
								<div style="text-align:right">
									{next && <><span class="dir">Next →</span><a href={`/blog/${next.id}/`}>{next.data.title}</a></>}
								</div>
							</nav>
						)
					}
					{
						related.length > 0 && (
							<section class="related">
								<h3>Related reads</h3>
								<ul>
									{related.map((r) => (
										<li><a href={`/blog/${r.id}/`}>{r.data.title}</a></li>
									))}
								</ul>
							</section>
						)
					}
					<EmailOptin />
				</div>
			</article>
		</main>
		<Footer />
		<div class="sticky-cta">
			<span>The checklists for this are in the Digital System.</span>
			<span class="price">{BUZZYFLY_CONFIG.defaultProductPrice}</span>
			<a class="btn-primary" href="/store#digital-system">See the system</a>
		</div>
	</body>
</html>
