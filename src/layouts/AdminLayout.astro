---
import "../styles/global.css";

interface Props {
	title: string;
	active?: "dashboard" | "posts" | "media" | "subscribers" | "orders" | "settings" | "log";
}

const { title, active } = Astro.props;

const navItems = [
	{ id: "dashboard", href: "/admin", label: "Dashboard" },
	{ id: "posts", href: "/admin/posts", label: "Posts" },
	{ id: "media", href: "/admin/media", label: "Media" },
	{ id: "subscribers", href: "/admin/subscribers", label: "Subscribers" },
	{ id: "orders", href: "/admin/orders", label: "Orders" },
	{ id: "settings", href: "/admin/settings", label: "Settings" },
	{ id: "log", href: "/admin/log", label: "Activity log" },
] as const;

const adminUser = Astro.locals.adminUser;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} · Buzzyfly Admin</title>
	</head>
	<body>
		<div class="admin-shell">
			<aside class="admin-sidebar">
				<div class="admin-sidebar__brand">🪰 Buzzyfly Admin</div>
				<nav class="admin-nav">
					{
						navItems.map((item) => (
							<a href={item.href} class:list={["admin-nav__link", { active: active === item.id }]}>
								{item.label}
							</a>
						))
					}
				</nav>
				<div class="admin-sidebar__footer">
					{adminUser && <p class="admin-sidebar__user">Signed in as {adminUser}</p>}
					<form method="POST" action="/api/admin/logout">
						<button class="admin-logout" type="submit">Log out</button>
					</form>
				</div>
			</aside>
			<main class="admin-main">
				<slot />
			</main>
		</div>
	</body>
</html>

<style>
	body {
		font-family: "Atkinson", sans-serif;
		margin: 0;
		background: #f4f5f9;
		color: rgb(var(--gray-dark));
	}
	.admin-shell {
		display: flex;
		min-height: 100vh;
	}
	.admin-sidebar {
		width: 220px;
		flex: none;
		display: flex;
		flex-direction: column;
		background: rgb(var(--black));
		color: #fff;
		padding: 1.5em 1em;
	}
	.admin-sidebar__brand {
		font-weight: 700;
		font-size: 1.1em;
		margin-bottom: 1.5em;
	}
	.admin-nav {
		display: flex;
		flex-direction: column;
		gap: 0.25em;
		flex: 1;
	}
	.admin-nav__link {
		display: block;
		padding: 0.6em 0.75em;
		border-radius: 8px;
		color: rgba(255, 255, 255, 0.75);
		text-decoration: none;
		font-size: 0.95em;
	}
	.admin-nav__link:hover {
		background: rgba(255, 255, 255, 0.08);
		color: #fff;
	}
	.admin-nav__link.active {
		background: var(--accent);
		color: #fff;
	}
	.admin-sidebar__footer {
		margin-top: 1.5em;
		padding-top: 1em;
		border-top: 1px solid rgba(255, 255, 255, 0.15);
	}
	.admin-sidebar__user {
		font-size: 0.8em;
		color: rgba(255, 255, 255, 0.6);
		margin: 0 0 0.75em 0;
		word-break: break-word;
	}
	.admin-logout {
		width: 100%;
		padding: 0.5em;
		border: 1px solid rgba(255, 255, 255, 0.25);
		border-radius: 8px;
		background: transparent;
		color: #fff;
		font-family: inherit;
		font-size: 0.85em;
		cursor: pointer;
	}
	.admin-logout:hover {
		background: rgba(255, 255, 255, 0.1);
	}
	.admin-main {
		flex: 1;
		padding: 2em 2.5em;
		max-width: 1080px;
	}
	.admin-main :global(h1) {
		margin-bottom: 0.25em;
	}
	.admin-main :global(.admin-subtitle) {
		color: rgb(var(--gray));
		margin: 0 0 2em 0;
	}
	.admin-main :global(.admin-card) {
		background: #fff;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		padding: 1.5em;
		margin-bottom: 1.5em;
	}
	.admin-main :global(.admin-stats) {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 1em;
		margin-bottom: 2em;
	}
	.admin-main :global(.admin-stat) {
		background: #fff;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		padding: 1.25em;
	}
	.admin-main :global(.admin-stat__value) {
		font-size: 2em;
		font-weight: 700;
		color: rgb(var(--black));
		line-height: 1.1;
	}
	.admin-main :global(.admin-stat__label) {
		color: rgb(var(--gray));
		font-size: 0.9em;
		margin-top: 0.25em;
	}
	.admin-main :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.92em;
	}
	.admin-main :global(th),
	.admin-main :global(td) {
		text-align: left;
		padding: 0.6em 0.75em;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.admin-main :global(th) {
		color: rgb(var(--gray));
		font-weight: 700;
		font-size: 0.85em;
		text-transform: uppercase;
		letter-spacing: 0.03em;
	}
	.admin-main :global(.admin-btn) {
		display: inline-block;
		padding: 0.5em 1em;
		border-radius: 8px;
		border: 1px solid rgb(var(--gray-light));
		background: #fff;
		color: rgb(var(--black));
		font-family: inherit;
		font-size: 0.9em;
		text-decoration: none;
		cursor: pointer;
	}
	.admin-main :global(.admin-btn:hover) {
		border-color: var(--accent);
		color: var(--accent);
	}
	.admin-main :global(.admin-btn--primary) {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}
	.admin-main :global(.admin-btn--primary:hover) {
		background: var(--accent-dark);
		border-color: var(--accent-dark);
		color: #fff;
	}
	.admin-main :global(.admin-btn--danger) {
		border-color: #b3261e;
		color: #b3261e;
	}
	/* A control that cannot act should look inert and say why, rather than
	   appearing live and doing nothing when pressed. */
	.admin-main :global(.admin-btn:disabled),
	.admin-main :global(.admin-btn[disabled]) {
		opacity: 0.5;
		cursor: not-allowed;
		background: #f0f1f5;
	}
	.admin-main :global(.admin-btn:disabled:hover),
	.admin-main :global(.admin-btn[disabled]:hover) {
		border-color: rgb(var(--gray-light));
		color: rgb(var(--black));
	}
	.admin-main :global(.admin-disabled-why) {
		margin-left: 0.6em;
		font-size: 0.85em;
		color: rgb(var(--gray));
	}
	.admin-main :global(.admin-btn--danger:hover) {
		background: #b3261e;
		color: #fff;
	}
	.admin-main :global(.admin-form label) {
		display: block;
		font-weight: 700;
		font-size: 0.85em;
		margin: 1em 0 0.35em 0;
	}
	.admin-main :global(.admin-form input),
	.admin-main :global(.admin-form textarea) {
		width: 100%;
		box-sizing: border-box;
		padding: 0.55em 0.75em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		font-family: inherit;
	}
	.admin-main :global(.admin-form textarea) {
		font-family: monospace;
		resize: vertical;
	}
	.admin-main :global(.admin-notice) {
		padding: 0.85em 1em;
		border-radius: 8px;
		margin-bottom: 1.5em;
		font-size: 0.92em;
	}
	.admin-main :global(.admin-notice--info) {
		background: #eef1ff;
		color: #2337ff;
	}
	.admin-main :global(.admin-notice--warn) {
		background: #fff4e0;
		color: #8a5a00;
	}
	.admin-main :global(.admin-notice--error) {
		background: #fdeceb;
		color: #b3261e;
	}
	.admin-main :global(.admin-notice--success) {
		background: #e7f7ec;
		color: #1a7a3c;
	}
</style>
