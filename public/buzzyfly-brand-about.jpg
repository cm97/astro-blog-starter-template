<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#05060f"/>
      <stop offset="0.5" stop-color="#0b1020"/>
      <stop offset="1" stop-color="#1a2b6b"/>
    </linearGradient>
    <linearGradient id="fly" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffd166"/>
      <stop offset="1" stop-color="#ff7a18"/>
    </linearGradient>
    <radialGradient id="glow" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#ffd166" stop-opacity="0.35"/>
      <stop offset="1" stop-color="#ffd166" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#bg)"/>
  <circle cx="600" cy="280" r="220" fill="url(#glow)"/>
  <g transform="translate(600 280)" fill="none" stroke="url(#fly)" stroke-width="14" stroke-linecap="round" stroke-linejoin="round">
    <path d="M0 0 C -90 -120 -200 -90 -240 -10 C -160 30 -80 50 0 25 C 80 50 160 30 240 -10 C 200 -90 90 -120 0 0 Z"/>
    <path d="M0 0 C 90 -120 200 -90 240 -10 C 160 30 80 50 0 25 C -80 50 -160 30 -240 -10 C -200 -90 -90 -120 0 0 Z" opacity="0.85"/>
    <circle cx="0" cy="-10" r="12" fill="#ffd166" stroke="none"/>
    <path d="M0 10 L0 95" stroke="#ffd166" stroke-width="10"/>
    <path d="M-40 70 L40 70" stroke="#ffd166" stroke-width="8"/>
  </g>
  <g transform="translate(600 470)" fill="#ffffff" font-family="Arial, Helvetica, sans-serif">
    <text x="0" y="0" text-anchor="middle" font-size="64" font-weight="800" letter-spacing="3">BUZZYFLY</text>
    <text x="0" y="42" text-anchor="middle" font-size="26" fill="#cfe0ff" letter-spacing="8">DIGITAL SYSTEM</text>
  </g>
</svg>