{
	"name": "astro-blog-starter-template",
	"description": "Build a personal website, blog, or portfolio with Astro.",
	"cloudflare": {
		"label": "Astro Framework Starter",
		"products": [
			"Workers"
		],
		"categories": [],
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/394ca3c9-d351-4036-035a-9f6dfa26dd00/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/f40a6577-eed5-4f3e-cef4-b5ef0a1be100/preview",
		"publish": true
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.4.6",
		"@astrojs/mdx": "8.1.3",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.4",
		"astro": "7.4.7",
		"postal-mime": "4.1.4",
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"wrangler": "4.136.3"
	},
	"engines": {
		"node": ">=22"
	},
	"private": true,
	"scripts": {
		"astro": "astro",
		"prebuild": "node scripts/check-live-rules.mjs",
		"build": "astro build",
		"test:rules": "node scripts/check-live-rules.mjs",
		"cf-typegen": "wrangler types",
		"check": "astro build && tsc && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "astro dev",
		"preview": "astro build && wrangler dev",
		"test:jobs": "esbuild tests/jobs.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.test-build/jobs.test.mjs && node --test .test-build/jobs.test.mjs",
		"test:indexnow": "esbuild tests/indexnow.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.test-build/indexnow.test.mjs && node --test .test-build/indexnow.test.mjs",
		"check:secrets": "node scripts/check-secrets.mjs",
		"test:traffic": "esbuild tests/trafficSource.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.test-build/trafficSource.test.mjs && node --test .test-build/trafficSource.test.mjs",
		"test:seo": "esbuild tests/canonical.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.test-build/canonical.test.mjs && node --test .test-build/canonical.test.mjs",
		"test:email": "esbuild tests/email.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.test-build/email.test.mjs && node --test .test-build/email.test.mjs",
		"test:ai": "esbuild tests/ai.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.test-build/ai.test.mjs && node --test .test-build/ai.test.mjs"
	},
	"type": "module"
}
